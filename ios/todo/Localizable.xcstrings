            "state": "translated",
            "value": "自动将截止时间添加到日历"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajout automatique des échéances au Calendrier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scadenze automatiche in Calendario"
          }
        },
        "de": {
