    "meeting.error.splitRequirements": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splitting requires at least two words and a segment longer than 2 ms."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분할하려면 단어가 두 개 이상이고 구간이 2ms보다 길어야 합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para dividirlo, se necesitan al menos dos palabras y un segmento de más de 2 ms."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分割には2つ以上の単語と2ミリ秒より長い区間が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拆分要求至少包含两个词，且片段时长超过 2 毫秒。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La division nécessite au moins deux mots et un segment de plus de 2 ms."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per dividere il segmento sono necessarie almeno due parole e una durata superiore a 2 ms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Aufteilen sind mindestens zwei Wörter und ein Abschnitt von mehr als 2 ms erforderlich."
          }
        }
      }
    },
