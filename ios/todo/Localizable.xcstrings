    "meeting.error.offlineAudioSaved": {
      "comment": "Local meeting processing or compact task analysis status.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline transcription failed. The audio is saved, but a complete transcript is not available yet. Retry from the meeting menu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 전사에 실패했습니다. 음성은 저장되어 있지만 완성된 전사는 아직 없습니다. 회의 메뉴에서 전사를 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo transcribir sin conexión. El audio está guardado, pero aún no hay una transcripción completa. Vuelve a intentarlo desde el menú de la reunión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン文字起こしに失敗しました。音声は保存されていますが、完全な文字起こしはまだありません。会議メニューから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线转写失败。音频已保存，但尚无完整转写文本。请从会议菜单重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription hors ligne a échoué. L’audio est enregistré, mais la transcription complète n’est pas encore disponible. Réessayez depuis le menu de la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione offline non è riuscita. L’audio è salvato, ma non è ancora disponibile una trascrizione completa. Riprova dal menu della riunione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Offline-Transkription ist fehlgeschlagen. Die Audiodaten sind gespeichert, ein vollständiges Transkript liegt aber noch nicht vor. Versuche es im Besprechungsmenü erneut."
          }
        }
      }
    },
    "meeting.error.offlineRetained": {
      "comment": "Local meeting processing or compact task analysis status.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved-audio transcription failed. The recording and earlier transcript are safe. Enabled follow-up processing will use that transcript. You can retry offline transcription from the meeting menu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 음성의 오프라인 전사에 실패했습니다. 녹음과 기존 전사는 보존되어 있으며, 활성화된 후속 처리는 기존 전사를 사용합니다. 회의 메뉴에서 오프라인 전사를 다시 시도할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo transcribir el audio guardado. La grabación y la transcripción anterior están a salvo. El procesamiento posterior que esté activado usará esa transcripción. Puedes volver a intentar la transcripción sin conexión desde el menú de la reunión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した音声の文字起こしに失敗しました。録音と以前の文字起こしは保持されています。有効になっている後続処理には、その文字起こしが使用されます。会議メニューからオフライン文字起こしを再試行できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存音频的转写失败。录音和原有转写文本均已保留。已启用的后续处理将使用原有文本。你可以从会议菜单重试离线转写。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription de l’audio enregistré a échoué. L’enregistrement et la transcription précédente sont conservés. Les traitements ultérieurs activés utiliseront cette transcription. Vous pouvez relancer la transcription hors ligne depuis le menu de la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione dell’audio salvato non è riuscita. La registrazione e la trascrizione precedente sono al sicuro. Le elaborazioni successive abilitate useranno quella trascrizione. Puoi riprovare la trascrizione offline dal menu della riunione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transkription der gespeicherten Aufnahme ist fehlgeschlagen. Die Aufnahme und das bisherige Transkript bleiben erhalten. Aktivierte Folgeschritte verwenden dieses Transkript. Du kannst die Offline-Transkription im Besprechungsmenü erneut starten."
          }
        }
      }
    },
    "meeting.error.processingFailed": {
      "comment": "Generic meeting processing error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
