    "mail.openai.noBody": {
      "comment": "Explain why explicit remote email analysis is unavailable when the locally stored plain-text body is empty.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평문 본문이 없습니다. 메일 상세에서 본문 로드를 완료한 뒤 요청하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No plain-text body is available. Finish loading the body in email detail before requesting analysis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay un cuerpo en texto sin formato disponible. Termina de cargar el cuerpo en el detalle del correo antes de solicitar el análisis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレーンテキストの本文がありません。メールの詳細画面で本文の読み込みが完了してから分析をリクエストしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无纯文本正文。请先在邮件详情中完成正文加载，再请求分析。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun corps en texte brut n’est disponible. Terminez le chargement du message dans le détail de l’e-mail avant de demander une analyse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun corpo in testo semplice disponibile. Completa il caricamento del corpo nei dettagli dell’email prima di richiedere l’analisi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Klartextinhalt verfügbar. Lade den Inhalt in den E-Mail-Details vollständig, bevor du eine Analyse anforderst."
          }
        }
      }
    },
