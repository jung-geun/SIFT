    "legal.privacy.storage.excludedDetail" : {
      "comment" : "Full opt-in iCloud storage and device-local authorization boundaries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheitsdaten und daraus erzeugte Aufgaben, Betriebssystemberechtigungen, gerätespezifische Freigaben und herunterladbare Modelldateien. Berechtigungen müssen auf jedem Gerät bestätigt und Modelle dort installiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health data and health-generated tasks, OS permissions, device-specific grants and downloadable model files. Permissions must be confirmed and models installed on each device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos de salud y tareas generadas a partir de ellos, permisos del sistema, autorizaciones específicas del dispositivo y archivos de modelos descargables. Los permisos deben confirmarse y los modelos instalarse en cada dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données de santé et tâches issues de ces données, autorisations du système et propres à l’appareil, fichiers de modèles téléchargeables. Les autorisations doivent être confirmées et les modèles installés sur chaque appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dati sanitari e attività da essi generate, permessi del sistema, autorizzazioni specifiche del dispositivo e file dei modelli scaricabili. I permessi vanno confermati e i modelli installati su ciascun dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康データと健康データから作成されたタスク、OSの権限、デバイス固有の許可、ダウンロード可能なモデルファイル。権限の確認とモデルのインストールは各デバイスで行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강 데이터와 건강 기록에서 생성된 할 일·OS 권한·기기별 승인·재다운로드 가능한 모델 파일. 권한 확인과 모델 설치는 각 기기에서 진행합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康数据及据此生成的任务、操作系统权限、设备专属授权和可下载的模型文件。权限需在各设备上确认，模型也需在各设备上安装。"
          }
        }
      }
    },
    "legal.privacy.storage.keychain" : {
      "comment" : "Full opt-in iCloud storage and device-local authorization boundaries.",
      "extractionState" : "manual",
