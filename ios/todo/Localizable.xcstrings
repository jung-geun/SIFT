            "value": "无法加载完整邮件，草稿使用的是预览内容。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’e-mail complet n’a pas pu être chargé. Le brouillon utilise donc l’aperçu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare l'email completa, quindi la bozza usa l'anteprima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vollständige E-Mail konnte nicht geladen werden. Der Entwurf verwendet daher die Vorschau."
          }
        }
      }
    },
    "mail.register.calendarDenied": {
      "comment": "Calendar permission denied; saving the to-do is still allowed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is off, so no event can be added. The to-do will still be saved."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근 권한이 없어 일정은 만들 수 없어요. 할 일은 그대로 저장돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al calendario está desactivado, por lo que no se puede añadir un evento. La tarea se guardará de todos modos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスが無効なため、予定を追加できません。To-Doはそのまま保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历访问权限已关闭，无法添加日程。待办事项仍会保存。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier est désactivé : aucun événement ne peut être ajouté. La tâche sera tout de même enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al calendario è disattivato, quindi non è possibile aggiungere un evento. L'attività verrà comunque salvata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalenderzugriff ist deaktiviert. Deshalb kann kein Ereignis hinzugefügt werden. Die Aufgabe wird trotzdem gespeichert."
          }
        }
      }
    },
    "mail.register.calendarFailed": {
      "comment": "Calendar event failed after the mail-derived to-do was saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The to-do was saved, but the calendar event couldn't be added."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일은 저장했지만 캘린더 일정을 추가하지 못했어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea se ha guardado, pero no se ha podido añadir el evento al calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "To-Doは保存されましたが、カレンダーの予定を追加できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待办事项已保存，但无法添加日历日程。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche a été enregistrée, mais l’événement n’a pas pu être ajouté au calendrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attività è stata salvata, ma non è stato possibile aggiungere l'evento al calendario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe wurde gespeichert, aber das Kalenderereignis konnte nicht hinzugefügt werden."
          }
        }
      }
    },
    "mail.register.calendarLaterSync": {
      "comment": "A future sync may register a due to-do even if immediate event creation is off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To-dos with deadlines may also be added during a later calendar sync."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감이 있으면 나중에 캘린더 동기화 과정에서 자동 등록될 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas con fecha límite también pueden añadirse durante una sincronización posterior del calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限のあるTo-Doは、後でカレンダーを同期する際に追加される場合もあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有截止日期的待办事项也可能在后续日历同步时添加到日历。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches avec une échéance pourront aussi être ajoutées lors d’une prochaine synchronisation du calendrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività con scadenza potrebbero essere aggiunte anche durante una successiva sincronizzazione del calendario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben mit Fälligkeitsdatum können auch bei einer späteren Kalendersynchronisierung hinzugefügt werden."
          }
        }
      }
    },
    "mail.register.calendarLinkPending": {
      "comment": "Todo and EventKit event saved; the association awaits reconciliation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The to-do and event were saved. They'll be linked during the next calendar sync."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일과 일정은 저장했어요. 둘의 연결은 다음 캘린더 동기화 때 맞춰져요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea y el evento se han guardado. Se vincularán durante la próxima sincronización del calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "To-Doと予定を保存しました。次回のカレンダー同期時に関連付けられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待办事项和日程已保存，将在下次日历同步时关联。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche et l’événement ont été enregistrés. Ils seront associés lors de la prochaine synchronisation du calendrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attività e l'evento sono stati salvati. Verranno collegati durante la prossima sincronizzazione del calendario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe und das Ereignis wurden gespeichert. Sie werden bei der nächsten Kalendersynchronisierung miteinander verknüpft."
          }
