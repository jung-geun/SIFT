    "calendar.destination.unavailable" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ausgewählte Kalender ist nicht verfügbar, da er fehlt oder schreibgeschützt ist. Verbinde sein Konto in den Systemeinstellungen erneut oder wähle einen anderen Kalender mit Schreibzugriff."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected calendar is missing or read-only. Reconnect its account in system settings or choose another writable calendar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El calendario seleccionado no está disponible o es de solo lectura. Vuelve a conectar su cuenta en los ajustes del sistema o elige otro calendario con permiso de escritura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le calendrier sélectionné est introuvable ou en lecture seule. Reconnectez son compte dans les réglages système ou choisissez un autre calendrier accessible en écriture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il calendario selezionato non è disponibile o è di sola lettura. Ricollega il suo account nelle impostazioni di sistema o scegli un altro calendario con accesso in scrittura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したカレンダーは存在しないか、読み取り専用のため利用できません。システム設定でアカウントを再接続するか、書き込み可能な別のカレンダーを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 캘린더가 없거나 읽기 전용입니다. 시스템 설정에서 계정을 다시 연결하거나 쓰기 가능한 다른 캘린더를 선택해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
