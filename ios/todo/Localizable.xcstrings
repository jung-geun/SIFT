    "ai.models.notice" : {
      "comment" : "Manual model installation notice; enabling a feature never downloads its model.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere herunterladbare Modelle ausdrücklich über die folgenden Schaltflächen. Das Aktivieren einer Funktion lädt ihr Modell nicht herunter. Vergleiche Ergebnisse experimenteller Modelle mit dem Original."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install downloaded models explicitly using the buttons below. Turning a feature on does not download its model. Check experimental model results against the source."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala los modelos manualmente con los botones siguientes. Activar una función no descarga su modelo. Contrasta los resultados de los modelos experimentales con el original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez les modèles manuellement à l’aide des boutons ci-dessous. Activer une fonction ne télécharge pas son modèle. Comparez les résultats des modèles expérimentaux avec la source."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa i modelli manualmente con i pulsanti qui sotto. Attivare una funzione non scarica il relativo modello. Confronta i risultati dei modelli sperimentali con la fonte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードモデルは下のボタンから手動でインストールしてください。機能をオンにするだけではモデルはダウンロードされません。実験的なモデルの結果は原文と照らし合わせて確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드 모델은 아래 버튼으로 직접 설치합니다. 기능을 켜기만 해서는 다운로드되지 않습니다. 실험적 모델의 결과는 원본과 함께 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用下方按钮手动安装可下载模型。仅开启功能不会下载模型。请对照原文检查实验性模型的结果。"
          }
        }
      }
    },
