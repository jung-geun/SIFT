    "meeting.capture.source.microphoneInterrupted": {
      "comment": "Microphone interrupted without deselecting app audio.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 캡처가 중단되었습니다. 입력을 확인한 후 직접 다시 켜주세요. 앱 오디오 선택은 유지됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone capture was interrupted. Check the input and explicitly enable it again. App audio remains selected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura del micrófono se ha interrumpido. Comprueba la entrada y vuelve a activarla manualmente. El audio de la app sigue seleccionado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクのキャプチャが中断されました。入力を確認し、手動で再度有効にしてください。アプリ音声の選択は維持されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风采集已中断。请检查输入，然后手动重新启用。应用音频仍处于选中状态。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture du microphone a été interrompue. Vérifiez l’entrée et réactivez-la explicitement. L’audio d’app reste sélectionné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisizione dal microfono è stata interrotta. Controlla l’ingresso e riattivala esplicitamente. L’audio dell’app resta selezionato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mikrofonaufnahme wurde unterbrochen. Prüfe den Eingang und aktiviere sie ausdrücklich erneut. App-Audio bleibt ausgewählt."
          }
        }
      }
    },
    "meeting.capture.source.microphoneOff": {
      "comment": "System picker did not approve microphone capture; app audio remains independent.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 선택기에서 마이크가 꺼져 있습니다. 마이크 오디오를 녹음하려면 선택기에서 켜주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone is off in the system picker. Enable it there to record microphone audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono está desactivado en el selector del sistema. Actívalo allí para grabar audio del micrófono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの選択画面でマイクがオフになっています。マイク音声を録音するには、その画面でオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统选择器中的麦克风已关闭。要录制麦克风音频，请在选择器中将其开启。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone est désactivé dans le sélecteur système. Activez-le à cet endroit pour enregistrer son audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono è disattivato nel selettore di sistema. Attivalo lì per registrare l’audio del microfono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist in der Systemauswahl ausgeschaltet. Aktiviere es dort, um Mikrofonton aufzunehmen."
          }
        }
      }
    },
    "meeting.capture.source.microphoneStopped": {
      "comment": "Microphone source failed without stopping other audio tracks.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 캡처가 중지되었습니다. 다른 소스의 녹음은 계속됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone capture stopped. Other sources continue recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura del micrófono se ha detenido. Las demás fuentes siguen grabando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクのキャプチャが停止しました。他のソースの録音は続いています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风采集已停止。其他来源将继续录音。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture du microphone s’est arrêtée. Les autres sources continuent d’enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisizione dal microfono si è interrotta. Le altre sorgenti continuano a registrare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mikrofonaufnahme wurde gestoppt. Andere Quellen nehmen weiter auf."
          }
        }
      }
    },
    "meeting.capture.source.stopped": {
      "comment": "One source failed but other independent recording sources remain active.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 소스 하나가 중지되었습니다. 선택한 다른 소스의 녹음은 계속됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One audio source stopped. Other selected sources continue recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fuente de audio se ha detenido. Las demás fuentes seleccionadas siguen grabando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声ソースの1つが停止しました。選択した他のソースの録音は続いています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
