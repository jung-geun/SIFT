          }
        }
      }
    },
    "openai.consent.email.explanation": {
      "comment": "OpenAI settings and data-sharing consent copy.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메일 상세에서 직접 외부 분석을 요청한 메일의 제목과 본문을 OpenAI로 보냅니다. 받은편지함 자동 수집·분석은 계속 기기 내에서 처리합니다. 원문·기존 로컬 요약은 덮어쓰지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends the subject and body only when you explicitly request remote analysis in email detail. Automatic inbox collection and analysis stay on device. The original and existing local summary are not overwritten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía el asunto y el cuerpo solo cuando solicitas explícitamente un análisis remoto en el detalle de un correo. La recopilación y el análisis automáticos de la bandeja de entrada permanecen en el dispositivo. No se sobrescriben el original ni el resumen local existente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールの詳細画面で外部分析を明示的にリクエストした場合にのみ、件名と本文を送信します。受信トレイの自動収集・分析は引き続きデバイス内で行われます。原文と既存のローカル要約は上書きされません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你于邮件详情中明确请求远程分析时，才会发送邮件主题和正文。收件箱的自动收集与分析仍在设备上进行。原文和已有本地摘要不会被覆盖。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie l’objet et le corps du message uniquement lorsque vous demandez explicitement une analyse distante depuis le détail d’un e-mail. La collecte et l’analyse automatiques de la boîte de réception restent sur l’appareil. L’original et le résumé local existant ne sont pas écrasés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia oggetto e corpo solo quando richiedi esplicitamente l’analisi remota nei dettagli dell’email. La raccolta e l’analisi automatiche della posta in arrivo restano sul dispositivo. L’originale e il riepilogo locale esistente non vengono sovrascritti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Betreff und Inhalt nur, wenn du in den E-Mail-Details ausdrücklich eine externe Analyse anforderst. Automatisches Erfassen und Analysieren des Posteingangs erfolgt weiterhin auf dem Gerät. Das Original und die vorhandene lokale Zusammenfassung werden nicht überschrieben."
          }
        }
      }
    },
    "openai.consent.email.title": {
      "comment": "OpenAI settings and data-sharing consent copy.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 선택한 메일의 외부 분석 허용"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow remote analysis of selected emails"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir el análisis remoto de correos seleccionados"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したメールの外部分析を許可"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许远程分析所选邮件"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’analyse distante des e-mails sélectionnés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’analisi remota delle email selezionate"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Externe Analyse ausgewählter E-Mails erlauben"
          }
        }
      }
    },
    "openai.consent.persona.explanation": {
      "comment": "OpenAI settings and data-sharing consent copy.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 분석을 요청하거나 동의한 할 일 정렬에서 저장된 페르소나 설명·선택 유형·결정론적 행동 근거를 OpenAI로 보냅니다. 결과는 미리보기이며 적용해야 저장됩니다. 메일·회의 원문은 포함하지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends saved persona description, selected types, and deterministic behavior evidence when you request analysis or authorize task prioritization. Results are previews until applied. Email and meeting originals are not included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía la descripción guardada del perfil personal, los tipos seleccionados y los indicios deterministas de comportamiento cuando solicitas un análisis o autorizas la priorización de tareas. Los resultados son vistas previas hasta que los aplicas. No se incluyen los originales de correos ni reuniones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分析をリクエストするか、タスクの優先順位付けを許可すると、保存済みのペルソナの説明、選択したタイプ、決定論的な行動の根拠を送信します。結果は適用するまでプレビューです。メールや会議の原文は含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你请求分析或授权待办事项优先级排序时，会发送已保存的个人画像描述、所选类型和确定性行为依据。结果在应用前仅为预览。不包含邮件和会议原文。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie la description enregistrée du profil personnel, les types sélectionnés et les données comportementales déterministes lorsque vous demandez une analyse ou autorisez la priorisation des tâches. Les résultats restent des aperçus tant qu’ils ne sont pas appliqués. Les originaux des e-mails et des réunions ne sont pas inclus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia la descrizione della persona salvata, i tipi selezionati e i dati comportamentali deterministici quando richiedi un’analisi o autorizzi la definizione delle priorità delle attività. I risultati restano anteprime finché non li applichi. Gli originali di email e riunioni non sono inclusi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet die gespeicherte Persona-Beschreibung, ausgewählte Typen und deterministische Verhaltensbelege, wenn du eine Analyse anforderst oder die Aufgabenpriorisierung erlaubst. Ergebnisse bleiben bis zur Anwendung eine Vorschau. Originale aus E-Mails und Besprechungen sind nicht enthalten."
          }
        }
      }
    },
    "openai.consent.persona.title": {
      "comment": "OpenAI settings and data-sharing consent copy.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페르소나의 외부 분석 허용"
          }
        },
        "en": {
