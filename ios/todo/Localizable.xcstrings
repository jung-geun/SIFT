        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow this app to access Calendar in Settings > Privacy & Security > Calendar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 > 개인정보 보호 > 캘린더에서 이 앱의 접근을 허용해주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que esta aplicación acceda a Calendario en Ajustes > Privacidad y seguridad > Calendario."
