    "meeting.languages.automaticDeferred" : {
      "comment" : "Native settings and analysis copy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im automatischen Modus wird Audio ohne Live-Transkription gespeichert. Nach dem Stoppen erkennt Whisper die Sprache jeder Quelle und transkribiert sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic mode saves audio without live transcription. Whisper detects each source’s language and transcribes after Stop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo automático guarda el audio sin transcripción en directo. Whisper detecta el idioma de cada fuente y transcribe al detener la grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode automatique enregistre l’audio sans transcription en direct. Whisper détecte la langue de chaque source et transcrit après l’arrêt de l’enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità automatica salva l’audio senza trascrizione in tempo reale. Whisper rileva la lingua di ogni sorgente e trascrive al termine della registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動モードでは、リアルタイム文字起こしをせずに音声を保存します。録音終了後、Whisperがソースごとの言語を検出して文字起こしします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 모드에서는 실시간 전사 없이 음성을 저장합니다. 녹음 종료 후 Whisper가 소스별 언어를 감지하고 전사합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动模式只保存音频，不进行实时转写。停止录音后，Whisper 会检测各来源的语言并转写。"
          }
        }
      }
    },
    "meeting.languages.automaticRequiresWhisper" : {
      "comment" : "Opt-in spoken-language detection, per-source estimates and saved-audio limits.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die automatische Spracherkennung nach dem Stoppen Whisper unter Einstellungen → Besprechung aktivieren und das Modell installieren. Keine Live-Transkription und kein automatischer Download."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable Whisper and install its model in Settings → Meeting for automatic language detection after Stop. No live transcription or automatic download."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Whisper e instala su modelo en Ajustes → Reunión para detectar el idioma automáticamente al detener la grabación. No hay transcripción en directo ni descarga automática."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Whisper et installez son modèle dans Réglages → Réunion pour détecter automatiquement la langue après l’arrêt de l’enregistrement. Aucune transcription en direct ni aucun téléchargement automatique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Whisper e installa il suo modello in Impostazioni → Riunione per rilevare automaticamente la lingua al termine della registrazione. Nessuna trascrizione in tempo reale né download automatico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音終了後に言語を自動検出するには、「設定」→「会議」でWhisperを有効にし、モデルをインストールしてください。リアルタイム文字起こしや自動ダウンロードは行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음 종료 후 언어를 자동 감지하려면 설정 → 회의에서 Whisper를 켜고 모델을 설치하세요. 실시간 전사와 자동 다운로드는 하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要在停止录音后自动检测语言，请在“设置”→“会议”中启用 Whisper 并安装模型。不进行实时转写或自动下载。"
          }
        }
      }
    },
    "meeting.languages.automaticSavedNotice" : {
      "comment" : "Opt-in spoken-language detection, per-source estimates and saved-audio limits.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Stoppen erkennt Whisper die Sprache je Abschnitt und Quelle der gespeicherten Aufnahme. Keine Live-Transkription. Sprachwechsel und überlappende Stimmen werden möglicherweise nicht erkannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After Stop, Whisper detects the language for each saved-audio window and source. No live transcription. Language switches and overlapping voices may be missed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al detener la grabación, Whisper detecta el idioma de cada segmento y fuente del audio guardado. No hay transcripción en directo. Puede pasar por alto cambios de idioma y voces superpuestas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l’arrêt de l’enregistrement, Whisper détecte la langue de chaque segment et source de l’audio enregistré. Aucune transcription en direct. Les changements de langue et les voix qui se chevauchent peuvent ne pas être détectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al termine della registrazione, Whisper rileva la lingua di ogni segmento e sorgente dell’audio salvato. Nessuna trascrizione in tempo reale. I cambi di lingua e le voci sovrapposte possono non essere rilevati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音終了後、Whisperが保存済み音声の区間・ソースごとに言語を検出します。リアルタイム文字起こしは行いません。言語の切り替えや重なった声を認識できない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음 종료 후 Whisper가 저장된 음성의 각 구간과 소스별로 언어를 감지합니다. 실시간 전사는 하지 않습니다. 언어 전환이나 겹치는 목소리는 놓칠 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止录音后，Whisper 会按已保存音频的各个片段和来源检测语言。不进行实时转写。可能漏识别语言切换或重叠人声。"
          }
        }
      }
    },
