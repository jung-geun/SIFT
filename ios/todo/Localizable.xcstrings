          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未安装说话人模型。请在测试版功能中安装后重新检测说话人。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle de détection des intervenants n’est pas installé. Installez-le dans les fonctionnalités bêta, puis relancez la détection des intervenants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello per gli interlocutori non è installato. Installalo in Funzionalità beta, quindi rileva di nuovo gli interlocutori."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
