            "value": "This is the calendar used by default when adding to-dos or events. You can change it for each item."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 할 일·이벤트를 추가할 때 기본으로 사용할 캘린더입니다. 개별 추가 시 변경할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el calendario predeterminado para añadir tareas o eventos. Puedes cambiarlo para cada elemento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "To-Doやイベントを追加するときにデフォルトで使用するカレンダーです。項目ごとに変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
