          "stringUnit" : {
            "state" : "translated",
            "value" : "分割には2つ以上の単語と2ミリ秒より長い区間が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분할하려면 단어가 두 개 이상이고 구간이 2ms보다 길어야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拆分要求至少包含两个词，且片段时长超过 2 毫秒。"
          }
        }
      }
    },
