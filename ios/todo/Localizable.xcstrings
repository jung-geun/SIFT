    "openai.connection.testExplanation" : {
      "comment" : "Explain that the deliberate connection check sends only a fixed short test message, needs no app-data consent, and may use plan allowance.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tests senden nur eine festgelegte Nachricht, keine gespeicherten App-Daten, und verbrauchen das Nutzungskontingent des Abonnements. Sie funktionieren auch ohne Anbieteraktivierung oder Zustimmung zur Datenweitergabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tests send only a fixed message, not stored app data, and use your subscription allowance. They work without provider activation or data-sharing consent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pruebas solo envían un mensaje fijo, no datos guardados de la app, y consumen la cuota de tu suscripción. Funcionan sin activar el proveedor ni dar consentimiento para compartir datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tests envoient uniquement un message prédéfini, pas les données enregistrées de l’app, et utilisent le quota de votre abonnement. Ils fonctionnent sans activation du fournisseur ni consentement au partage des données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I test inviano solo un messaggio predefinito, non i dati salvati dell’app, e consumano la quota del tuo abbonamento. Funzionano senza attivare il fornitore né dare il consenso alla condivisione dei dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テストでは保存済みのアプリデータではなく、固定メッセージのみを送信し、サブスクリプションの利用枠を消費します。プロバイダの有効化やデータの種類ごとの送信同意がなくても実行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테스트는 저장된 앱 데이터 대신 고정 메시지만 전송하며 구독 한도를 사용합니다. 제공자 활성화나 데이터별 전송 동의 없이 실행할 수 있습니다."
          }
        },
        "zh-Hans" : {
