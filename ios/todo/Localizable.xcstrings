    "routines.error.operationFailed": {
      "comment": "Safe UI message for an unrecognized routine or persistence error.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴 처리를 완료하지 못했습니다. 다시 시도하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The routine operation could not be completed. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la operación de la rutina. Vuelve a intentarlo."
          }
        },
        "ja": {
