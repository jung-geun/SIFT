    "legal.privacy.diagnostics.collected" : {
      "comment" : "Privacy policy diagnostic data categories.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collected: error timestamps and repeat counts, the feature location plus source file and line, error domain, code, type, and message (file paths and email addresses removed, capped at 300 characters) with the underlying error chain, app version, build, and install channel, OS version, device model identifier, memory, storage, screen size, and processor count, language, region, and time zone, thermal state, Low Power Mode, app memory footprint, and app run state, feature setting on/off values, the app's own recent error logs (up to 300 entries from the last 30 minutes), and crash, hang, and memory-termination diagnostics Apple may deliver later."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수집 항목: 오류 발생 시각·반복 횟수, 오류가 발생한 기능 위치와 소스 파일·줄 번호, 오류 도메인·코드·유형·메시지(파일 경로와 이메일 주소 제거, 300자 제한)와 하위 오류 사슬, 앱 버전·빌드·설치 경로, 운영체제 버전, 기기 모델 식별자·메모리·저장 공간·화면 크기·프로세서 수, 언어·지역·시간대, 발열 상태·저전력 모드·앱 메모리 사용량·앱 실행 상태, 기능 설정 On/Off 값, 앱이 남긴 최근 오류 로그(최대 300건, 30분), Apple이 나중에 제공할 수 있는 충돌·멈춤·메모리 종료 진단"
          }
        }
      }
    },
    "legal.privacy.diagnostics.deliveryLimit" : {
      "comment" : "Privacy policy MetricKit delivery limitation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple system diagnostics may be delayed or unavailable and do not capture every forced termination"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 시스템 진단은 지연되거나 제공되지 않을 수 있고 모든 강제 종료를 포착하지 않음"
          }
        }
      }
    },
    "legal.privacy.diagnostics.excluded" : {
      "comment" : "Privacy policy diagnostic data exclusions.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluded: recordings, transcripts, to-dos, email bodies, subjects, and addresses, personas, account identifiers, and authentication tokens."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제외 항목: 음성 녹음, 전사문, 할 일, 이메일 본문·제목·주소, 페르소나, 계정 식별자, 인증 토큰"
          }
        }
      }
    },
    "legal.privacy.diagnostics.retentionCondition" : {
      "comment" : "Privacy policy diagnostic retention condition.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Until consent is withdrawn or logs are deleted in the app"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동의 철회 또는 앱에서 삭제 시"
          }
        }
      }
    },
    "legal.privacy.diagnostics.retentionDeletion" : {
      "comment" : "Privacy policy diagnostic deletion method.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete the on-device diagnostic store"
