    "routines.records.empty": {
      "comment": "Routine review UI: routines.records.empty.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 루틴 후보가 없습니다. 기록이 부족하거나 주기가 불규칙하면 추천을 만들지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No routine candidates yet. Sparse or irregular evidence does not produce actionable suggestions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay posibles rutinas. Los indicios escasos o irregulares no generan sugerencias aplicables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティン候補はまだありません。記録が少ない場合や不規則な場合は、実行可能な提案は作成されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无日常规律候选项。记录过少或间隔不规律时，不会生成可供采用的建议。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune routine potentielle pour le moment. Des données trop rares ou irrégulières ne donnent pas lieu à des suggestions exploitables."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna possibile routine per ora. Dati scarsi o irregolari non generano suggerimenti utilizzabili."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Routinenkandidaten. Bei wenigen oder unregelmäßigen Belegen werden keine umsetzbaren Vorschläge erstellt."
          }
        }
      }
    },
