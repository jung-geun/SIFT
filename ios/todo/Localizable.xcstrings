    "meeting.languages.summaryUnavailable" : {
      "comment" : "Meeting language selection, engine limits and AI accuracy disclosure.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine KI-Zusammenfassung in der gewählten Sprache konnte nicht erstellt werden. Dies sind Originalauszüge, keine Übersetzung. Prüfe Anbieter, Modell und Sprachunterstützung unter Einstellungen → KI."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An AI summary in the selected language could not be generated. These are original-language excerpts, not a translation. Check the selected provider, model and language support in Settings → AI."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo generar un resumen de IA en el idioma elegido. Son extractos originales, no una traducción. Comprueba el proveedor, modelo e idiomas en Ajustes → IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de générer un résumé IA dans la langue choisie. Il s’agit d’extraits originaux, pas d’une traduction. Vérifiez le fournisseur, le modèle et les langues dans Réglages → IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile generare un riepilogo IA nella lingua scelta. Questi sono estratti originali, non una traduzione. Controlla fornitore, modello e lingue in Impostazioni → IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した言語のAI要約を生成できませんでした。これは翻訳ではなく原文の抜粋です。設定 → AIで提供元・モデル・対応言語を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 언어로 AI 요약을 생성하지 못했습니다. 아래 내용은 번역이 아닌 원문 발췌입니다. 설정 → AI에서 선택한 제공자·모델·지원 언어를 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法生成所选语言的AI摘要。以下是原文摘录，不是翻译。请在设置 → AI中检查提供商、模型及支持语言。"
          }
        }
      }
    },
