    "meeting.source.app.selectionOnStart": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system picker requests a source when recording starts; no screen video is saved. Use headphones to limit microphone bleed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 시작 시 시스템 선택창에서 오디오 소스를 지정합니다. 화면 영상은 저장하지 않습니다. 마이크 유입을 줄이려면 헤드폰을 사용하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El selector del sistema solicita una fuente al iniciar la grabación; no se guarda vídeo de la pantalla. Usa auriculares para reducir el sonido que recoge el micrófono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音開始時にシステムピッカーで音声ソースを選択します。画面の映像は保存されません。マイクへの音声の回り込みを防ぐためヘッドフォンをご使用ください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音开始时，请在系统选择器中选择音频来源；不会保存屏幕视频。请使用耳机，以减少声音串入麦克风。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sélecteur système demande une source au démarrage de l’enregistrement ; aucune vidéo de l’écran n’est enregistrée. Utilisez un casque pour limiter la reprise du son par le microphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All'avvio della registrazione, il selettore di sistema richiede una sorgente; non viene salvato alcun video dello schermo. Usa le cuffie per limitare la ripresa dell'audio dal microfono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Start der Aufnahme wählst du im Systemdialog eine Quelle aus. Es wird kein Bildschirmvideo gespeichert. Verwende Kopfhörer, um die Aufnahme von Wiedergabeton über das Mikrofon zu verringern."
          }
        }
      }
    },
    "meeting.source.app.selectionOnStart.ios": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SIFT is the recording destination, not the audio source. Tap Share Entire Screen; iPhone cannot select another app here. Only audio is saved. Use headphones to limit microphone bleed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택창의 SIFT는 녹음 결과를 받는 앱입니다. 'Share Entire Screen'을 누르세요. iPhone에서는 이곳에서 다른 앱을 선택할 수 없습니다. 화면 영상은 저장하지 않습니다. 마이크 유입을 줄이려면 헤드폰을 사용하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SIFT es el destino de la grabación, no la fuente de audio. Toca «Share Entire Screen»; el iPhone no permite seleccionar otra aplicación aquí. Solo se guarda el audio. Usa auriculares para reducir el sonido que recoge el micrófono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SIFTは録音先であり、音声ソースではありません。「画面全体を共有」をタップしてください。iPhoneではここから別のアプリを選択することはできません。音声のみが保存されます。マイクへの音声の回り込みを防ぐためヘッドフォンをご使用ください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SIFT 是录音的接收应用，而不是音频来源。请轻点“共享整个屏幕”；iPhone 无法在此处选择其他应用。仅保存音频。请使用耳机，以减少声音串入麦克风。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIFT est la destination de l’enregistrement, pas la source audio. Touchez « Partager tout l’écran » (Share Entire Screen) ; l’iPhone ne permet pas de sélectionner une autre app ici. Seul l’audio est enregistré. Utilisez un casque pour limiter la reprise du son par le microphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SIFT è la destinazione della registrazione, non la sorgente audio. Tocca Share Entire Screen; su iPhone non puoi selezionare un'altra app qui. Viene salvato solo l'audio. Usa le cuffie per limitare la ripresa dell'audio dal microfono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SIFT ist das Aufnahmeziel, nicht die Audioquelle. Tippe auf „Gesamten Bildschirm teilen“. Auf dem iPhone kann hier keine andere App ausgewählt werden. Es wird nur Audio gespeichert. Verwende Kopfhörer, um die Aufnahme von Wiedergabeton über das Mikrofon zu verringern."
          }
        }
      }
    },
    "meeting.source.app.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App audio requires supported iOS 27 hardware or Mac Catalyst system sharing. Microphone recording remains available."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 오디오는 지원되는 iOS 27 실기기 또는 Mac Catalyst 화면 공유가 필요합니다. 마이크 녹음은 계속 사용할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio de la aplicación requiere un dispositivo compatible con iOS 27 o el uso compartido del sistema de Mac Catalyst. La grabación con micrófono sigue disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ音声の録音には、対応するiOS 27デバイスまたはMac Catalystのシステム共有が必要です。マイク録音は引き続きご利用いただけます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用音频需要受支持的 iOS 27 硬件或 Mac Catalyst 系统共享功能。麦克风录音仍可使用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio des apps nécessite un appareil compatible sous iOS 27 ou le partage système de Mac Catalyst. L’enregistrement au microphone reste disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio delle app richiede un dispositivo compatibile con iOS 27 o la condivisione di sistema di Mac Catalyst. La registrazione dal microfono rimane disponibile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Audio erfordert unterstützte Hardware mit iOS 27 oder die Systemfreigabe von Mac Catalyst. Mikrofonaufnahmen bleiben verfügbar."
          }
        }
      }
    },
