    },
    "calendar.taskAnalysis.unavailableFooter" : {
      "comment" : "Explicit device-local opt-in for automatic calendar-to-task import and analysis. Selection is independent of display/export; deselection preserves tasks and external events.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diese gespeicherten Kalender-IDs kann derzeit nicht zugegriffen werden. Sie bleiben ausgewählt, bis Sie sie ausdrücklich entfernen. Stellen Sie die Berechtigung oder das Kalenderkonto wieder her, um sie erneut verfügbar zu machen. Es wird kein Ersatz automatisch ausgewählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These saved calendar IDs are not currently accessible. They remain selected unless you remove them explicitly. Restore permission or the calendar account to make them available again; no replacement is selected automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos identificadores de calendario guardados no son accesibles en este momento. Seguirán seleccionados hasta que los quites explícitamente. Restaura el permiso o la cuenta del calendario para volver a acceder a ellos; no se seleccionará ningún sustituto automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces identifiants de calendrier enregistrés ne sont pas accessibles actuellement. Ils restent sélectionnés tant que vous ne les retirez pas explicitement. Rétablissez l’autorisation ou le compte de calendrier pour y accéder à nouveau ; aucun remplacement n’est sélectionné automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi ID di calendario salvati non sono attualmente accessibili. Restano selezionati finché non li rimuovi esplicitamente. Ripristina l’autorizzazione o l’account del calendario per renderli nuovamente disponibili; non viene selezionato automaticamente alcun sostituto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたこれらのカレンダーIDには現在アクセスできません。明示的に解除しない限り選択は保持されます。アクセス権またはカレンダーアカウントを復元すると再び利用できます。代わりのカレンダーが自動選択されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 이 캘린더 ID에는 현재 접근할 수 없습니다. 직접 선택을 해제하기 전까지 선택 상태가 유지됩니다. 권한이나 캘린더 계정을 복원하면 다시 사용할 수 있으며 대체 캘린더가 자동으로 선택되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法访问这些已保存的日历 ID。除非您明确移除，否则它们会保持选中状态。恢复权限或日历账户后即可再次使用；系统不会自动选择替代日历。"
          }
        }
      }
    },
