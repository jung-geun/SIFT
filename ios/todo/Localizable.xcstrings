          "stringUnit": {
            "state": "translated",
            "value": "Verbindungen auf diesem Gerät löschen"
          }
        }
      }
    },
    "openai.connections.deleting": {
      "comment": "OpenAI settings and data-sharing consent copy.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 기록 삭제·원격 철회 확인 중…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
