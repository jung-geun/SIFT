    "규칙 기반 정렬은 베타 provider를 켜지 않아도 항상 사용할 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rule-based sorting is available without enabling a beta provider."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙 기반 정렬은 베타 provider를 켜지 않아도 항상 사용할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La priorización basada en reglas siempre está disponible, aunque no actives el proveedor beta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールに基づく並べ替えは、ベータ版プロバイダーを有効にしなくても常に使用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使不启用测试版提供方，也始终可以使用基于规则的排序。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La priorisation fondée sur des règles reste toujours disponible, même sans activer les fournisseurs bêta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ordinamento basato su regole è sempre disponibile, anche senza attivare i provider beta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die regelbasierte Priorisierung ist immer verfügbar, auch wenn kein Beta-Anbieter aktiviert ist."
          }
        }
      }
    },
