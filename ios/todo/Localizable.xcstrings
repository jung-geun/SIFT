    "meeting.diarization.busy": {
      "comment": "Live speaker labels unavailable while another meeting uses the model.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another meeting's speaker analysis is running. Speakers for this recording will be detected after it stops."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 회의의 화자 분석이 진행 중입니다. 이번 녹음의 화자는 녹음 종료 후 분석합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis de interlocutores de otra reunión está en curso. Los interlocutores de esta grabación se detectarán cuando termine la grabación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の会議の話者分析が実行中です。この録音の話者は、実行中の処理が終了した後に検出されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一场会议的说话人分析正在进行。本次录音的说话人将在录音停止后进行识别。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse des intervenants d’une autre réunion est en cours. Les intervenants de cet enregistrement seront détectés après son arrêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È in corso l'analisi degli interlocutori di un'altra riunione. Gli interlocutori di questa registrazione verranno rilevati al termine della registrazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprecheranalyse einer anderen Besprechung läuft bereits. Die Sprecher dieser Aufnahme werden nach dem Aufnahmeende erkannt."
          }
        }
      }
    },
    "meeting.diarization.busyRetry": {
      "comment": "Saved-audio analysis could not start because the model is in use.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker detection is busy with a recording or another meeting. Try again from the meeting detail."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 또는 다른 회의의 화자 분석이 진행 중입니다. 회의 기록에서 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección de interlocutores está ocupada con una grabación u otra reunión. Vuelve a intentarlo desde los detalles de la reunión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音または別の会議の話者検出が進行中です。会議の詳細画面からもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话人检测正用于录音或其他会议。请在会议详情中重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection des intervenants est occupée par un enregistrement ou une autre réunion. Réessayez depuis les détails de la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rilevamento degli interlocutori è occupato con una registrazione o un'altra riunione. Riprova dai dettagli della riunione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprechererkennung ist mit einer Aufnahme oder einer anderen Besprechung beschäftigt. Versuche es in den Besprechungsdetails erneut."
          }
        }
      }
    },
    "meeting.diarization.cancel": {
      "comment": "Stop only the saved-audio speaker analysis; recording and transcript remain saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop speaker detection"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화자 분석 중지"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener la detección de interlocutores"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話者検出を停止"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止说话人检测"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la détection des intervenants"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi il rilevamento degli interlocutori"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechererkennung stoppen"
          }
        }
      }
    },
    "meeting.diarization.changed": {
      "comment": "Speaker analysis discarded after a concurrent edit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript or speakers changed during analysis, so the result was not applied. Run speaker detection again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석 중 전사 또는 화자 정보가 바뀌어 결과를 적용하지 않았습니다. 화자 분석을 다시 실행하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción o los interlocutores cambiaron durante el análisis, por lo que no se aplicó el resultado. Vuelve a ejecutar la detección de interlocutores."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分析中に文字起こしまたは話者が変更されたため、結果は適用されませんでした。話者検出を再度実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析期间转写文本或说话人信息发生变化，因此未应用结果。请重新运行说话人检测。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription ou les intervenants ont changé pendant l’analyse ; le résultat n’a donc pas été appliqué. Relancez la détection des intervenants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione o gli interlocutori sono cambiati durante l'analisi, quindi il risultato non è stato applicato. Esegui di nuovo il rilevamento degli interlocutori."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Transkript oder die Sprecher wurden während der Analyse geändert. Das Ergebnis wurde daher nicht angewendet. Starte die Sprechererkennung erneut."
          }
        }
      }
    },
    "meeting.diarization.completed": {
