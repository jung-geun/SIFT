          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiodecodierung wurde vor dem Dateiende abgebrochen. Es wurde keine Besprechung importiert."
          }
        }
      }
    },
    "meeting.audioImport.error.durationLimit": {
      "comment": "Audio import exceeds the six-hour safety limit.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오는 최대 6시간까지 가져올 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio imports are limited to six hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las importaciones de audio tienen un límite de seis horas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込める音声の長さは最大6時間です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的音频时长不得超过六小时。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les importations audio sont limitées à six heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le importazioni audio sono limitate a sei ore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audioimporte sind auf sechs Stunden begrenzt."
          }
        }
      }
    },
    "meeting.audioImport.error.emptyAudio": {
