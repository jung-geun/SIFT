          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser l’analyse distante des e-mails sélectionnés"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l’analisi remota delle email selezionate"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したメールの外部分析を許可"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 선택한 메일의 외부 분석 허용"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
