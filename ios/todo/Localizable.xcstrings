    "legal.text.앱 삭제, 기기 초기화, iCloud 오류 등으로 인한 데이터 손실에 대해 운영자는 책임을 지지 않습니다." : {
      "comment" : "English legal translation preserving the Korean source structure and meaning.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Betreiber haftet nicht für Datenverluste durch das Löschen der App, das Zurücksetzen des Geräts oder iCloud-Fehler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The operator is not responsible for data loss caused by app deletion, device reset, or iCloud errors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El operador no se hace responsable de la pérdida de datos causada por la eliminación de la app, el restablecimiento del dispositivo o errores de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’exploitant n’est pas responsable des pertes de données dues à la suppression de l’app, à la réinitialisation de l’appareil ou à des erreurs iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gestore non è responsabile della perdita di dati causata dall'eliminazione dell'app, dal ripristino del dispositivo o da errori iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの削除、デバイスの初期化、iCloudのエラーなどによるデータ損失について、運営者は責任を負いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 삭제, 기기 초기화, iCloud 오류 등으로 인한 데이터 손실에 대해 운영자는 책임을 지지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
