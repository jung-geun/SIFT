    "legal.text.약관 변경": {
      "comment": "English legal translation preserving the Korean source structure and meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terms changes"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약관 변경"
          }
        },
        "es": {
          "stringUnit": {
