          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo file non può essere decodificato come audio su questo dispositivo. Prova WAV, M4A, MP3, AIFF, CAF o FLAC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでは、このファイルを音声としてデコードできません。WAV、M4A、MP3、AIFF、CAF、FLACのいずれかをお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
