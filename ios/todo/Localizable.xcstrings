            "state": "translated",
            "value": "La tarea se ha guardado. No se pudo confirmar una operación posterior: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを保存しました。後続の処理を確認できませんでした：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
