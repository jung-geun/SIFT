    "schedule.deadline.explanation" : {
      "comment" : "Schedule approval UI: schedule.deadline.explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch die Genehmigung werden Beginn und Fälligkeit auf den unten angegebenen Zeitraum geändert. Das empfohlene Ende darf die bisherige Frist nicht überschreiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approval changes the start and due date to the interval below. The recommended end cannot exceed the current deadline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aprobación cambia las fechas de inicio y vencimiento al intervalo indicado abajo. El final recomendado no puede superar la fecha límite actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’approbation remplace les dates de début et d’échéance par le créneau ci-dessous. La fin recommandée ne peut pas dépasser l’échéance actuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’approvazione modifica le date di inizio e scadenza secondo l’intervallo seguente. La fine consigliata non può superare la scadenza attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認すると、開始日時と期限が以下の時間枠に変更されます。提案する終了日時が現在の締め切りを超えることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인하면 시작·마감이 아래 일정 구간으로 변경됩니다. 추천 종료는 기존 마감을 넘지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "批准后，开始时间和截止时间将更改为下方时段。建议的结束时间不能晚于当前截止时间。"
          }
        }
      }
    },
