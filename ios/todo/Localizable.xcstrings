    "permissions.appAudio.purpose.ios": {
      "comment": "iOS app audio requires per-session whole-display sharing, not a permanent permission.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve entire-screen audio in the system screen-sharing picker when preparing a recording. This screen does not start sharing or request access in advance."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 준비 시 시스템 화면 공유에서 전체 화면의 오디오를 허용합니다. 이 화면에서는 공유를 시작하거나 권한을 미리 요청하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriza el audio de toda la pantalla en el selector de pantalla compartida del sistema al preparar una grabación. Esta pantalla no inicia el uso compartido ni solicita acceso de antemano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音の準備時に、システムの画面共有ピッカーで画面全体の音声を許可します。この画面で共有が開始されたり、事前にアクセス権が要求されたりすることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备录音时，请在系统屏幕共享选择器中授权整个屏幕的音频。此页面不会开始共享或提前请求访问权限。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’audio de tout l’écran dans le sélecteur de partage d’écran du système lors de la préparation d’un enregistrement. Cet écran ne démarre pas le partage et ne demande pas d’accès à l’avance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizza l'audio dell'intero schermo nel selettore di condivisione schermo del sistema durante la preparazione di una registrazione. Questa schermata non avvia la condivisione né richiede l'accesso in anticipo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube bei der Aufnahmevorbereitung im Systemdialog für die Bildschirmfreigabe das Audio des gesamten Bildschirms. Auf diesem Bildschirm wird weder die Freigabe gestartet noch vorab Zugriff angefordert."
          }
        }
      }
    },
    "permissions.appAudio.purpose.mac": {
      "comment": "Mac Catalyst app audio uses system-selected content, separately from microphone permission.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the content whose audio you want in the system picker when preparing a recording. This screen does not start sharing or request access in advance."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 준비 시 시스템 선택기에서 오디오를 받을 콘텐츠를 선택합니다. 이 화면에서는 공유를 시작하거나 권한을 미리 요청하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el contenido cuyo audio quieras grabar en el selector del sistema al preparar una grabación. Esta pantalla no inicia el uso compartido ni solicita acceso de antemano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音の準備時に、システムピッカーで音声を取得するコンテンツを選択します。この画面で共有が開始されたり、事前にアクセス権が要求されたりすることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备录音时，请在系统选择器中选择要获取音频的内容。此页面不会开始共享或提前请求访问权限。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le contenu dont vous souhaitez récupérer l’audio dans le sélecteur système lors de la préparation d’un enregistrement. Cet écran ne démarre pas le partage et ne demande pas d’accès à l’avance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il contenuto di cui desideri acquisire l'audio nel selettore di sistema durante la preparazione di una registrazione. Questa schermata non avvia la condivisione né richiede l'accesso in anticipo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle bei der Aufnahmevorbereitung im Systemdialog die Inhalte aus, deren Audio du aufnehmen möchtest. Auf diesem Bildschirm wird weder die Freigabe gestartet noch vorab Zugriff angefordert."
          }
        }
      }
    },
    "permissions.appAudio.status": {
