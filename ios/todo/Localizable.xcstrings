    "calendar.event.invalidRange": {
      "comment": "Calendar timeline direct manipulation and error recovery.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Endzeit muss nach der Startzeit liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The end time must be after the start time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de fin debe ser posterior a la de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure de fin doit être postérieure à l’heure de début."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ora di fine deve essere successiva a quella di inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時刻は開始時刻より後にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시각은 시작 시각보다 늦어야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束时间必须晚于开始时间。"
          }
        }
      }
    },
