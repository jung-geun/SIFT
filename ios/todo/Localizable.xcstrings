    "마감 기준 상대 시각으로 알림을 보냅니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send reminders at a relative time before the deadline."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감 기준 상대 시각으로 알림을 보냅니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía recordatorios con una antelación relativa al vencimiento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限までの残り時間を基準にリマインダーを送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在截止时间前，按设定的提前时长发送提醒。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer les rappels à un moment défini par rapport à l’échéance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia promemoria con un anticipo relativo alla scadenza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen mit einem relativen Zeitabstand vor der Frist senden."
          }
        }
      }
    },
