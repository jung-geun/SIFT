    "todo.empty.description.review": {
      "comment": "Review queue empty state description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported calendar items are shown by due date. Swipe to activate an item and add it to your calendar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더에서 가져온 일정이 마감일 순으로 표시됩니다. 스와이프해 진행중으로 추가하면 캘린더에 등록됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los eventos importados del calendario se muestran por fecha de vencimiento. Desliza el dedo para activar un elemento y añadirlo a tu calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーから読み込んだ予定が期日順に表示されます。スワイプしてタスクを有効化すると、カレンダーに登録されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的日历事项按截止日期显示。轻扫可将事项设为进行中，并添加到日历。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments importés du calendrier sont affichés par échéance. Balayez un élément pour l’activer et l’ajouter à votre calendrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi importati dal calendario sono mostrati in ordine di scadenza. Scorri su un elemento per attivarlo e aggiungerlo al calendario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte Kalendereinträge werden nach Fälligkeit angezeigt. Wische, um einen Eintrag zu aktivieren und zu deinem Kalender hinzuzufügen."
          }
        }
      }
