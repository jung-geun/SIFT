    "시간대/태그별 처리 속도 통계 기반 행동 패턴 메모리 분석": {
      "comment": "Development status UI copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Behavior-pattern memory analysis from time-of-day/tag processing statistics"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간대/태그별 처리 속도 통계 기반 행동 패턴 메모리 분석"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Análisis de la memoria de patrones de comportamiento a partir de estadísticas de velocidad de procesamiento por franja horaria y etiqueta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間帯・タグ別の処理速度の統計に基づく行動パターンメモリの分析"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据不同时段和标签的处理统计数据，分析行为模式记忆"
          }
        },
        "fr": {
          "stringUnit": {
