    "오프라인 모델이 없습니다. 베타 설정에서 설치한 후 다시 시도하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline model unavailable. Install it in beta settings and retry."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 모델이 없습니다. 베타 설정에서 설치한 후 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún modelo sin conexión. Instálalo en los ajustes beta y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインモデルがありません。ベータ設定でインストールしてから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有离线模型。请先在测试版设置中安装模型，然后重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun modèle hors ligne n’est installé. Installez-en un dans les réglages bêta, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun modello offline disponibile. Installane uno nelle impostazioni beta e riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Offline-Modell vorhanden. Installiere es in den Beta-Einstellungen und versuche es erneut."
          }
        }
      }
    },
    "오프라인 전사에 실패했습니다. 이전 전사는 보존되었습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline transcription failed. Your earlier transcript is intact."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 전사에 실패했습니다. 이전 전사는 보존되었습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción sin conexión ha fallado. Se ha conservado la transcripción anterior."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインでの文字起こしに失敗しました。以前の文字起こしは保持されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线转写失败。之前的转写文本已保留。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription hors ligne a échoué. La transcription précédente a été préservée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrizione offline non riuscita. La trascrizione precedente è stata conservata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Offline-Transkription ist fehlgeschlagen. Das bisherige Transkript bleibt erhalten."
          }
        }
      }
    },
