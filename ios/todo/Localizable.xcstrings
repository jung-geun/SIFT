          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap More > Settings in the upper right, then review Email Integration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Más > Ajustes en la esquina superior derecha y revisa Integración del correo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の「その他」>「設定」をタップし、「メール連携」を確認してみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点右上角的“更多 > 设置”，然后查看“邮件集成”。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Plus > Réglages en haut à droite, puis consultez Intégration des e-mails."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Altro > Impostazioni in alto a destra, poi rivedi Integrazione email."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben rechts auf Mehr > Einstellungen und prüfe dann die E-Mail-Anbindung."
          }
        }
      }
    },
    "tutorial.body.이 화면에서 TODO 자동 정렬에 사용할 AI를 선택할 수 있습니다. 확인했으면 뒤로 돌아가 계속하세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the AI used for To-Do Prioritization here. Go back when you are ready to continue."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면에서 TODO 자동 정렬에 사용할 AI를 선택할 수 있습니다. 확인했으면 뒤로 돌아가 계속하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí puedes elegir la IA para priorizar tareas. Vuelve atrás cuando quieras continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面でタスクの優先度整理に使用するAIを選択できます。確認したら前に戻って続けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里选择用于整理待办事项优先级的 AI。准备好继续后，请返回。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ici l’IA utilisée pour prioriser les tâches. Revenez en arrière lorsque vous souhaitez continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui puoi scegliere l'IA da usare per definire le priorità delle attività. Torna indietro quando vuoi continuare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle hier die KI für die Aufgabenpriorisierung aus. Gehe zurück, wenn du fortfahren möchtest."
          }
        }
      }
    },
    "tutorial.body.이 화면은 마감일과 중요도, 태그, 행동 패턴을 사용한 규칙 기반 정렬을 안내합니다. 확인했으면 뒤로 돌아가 계속하세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면은 마감일과 중요도, 태그, 행동 패턴을 사용한 규칙 기반 정렬을 안내합니다. 확인했으면 뒤로 돌아가 계속하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This screen explains rule-based sorting using due dates, importance, tags, and behavior patterns. Go back when you are done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pantalla explica la ordenación basada en reglas mediante fechas de vencimiento, importancia, etiquetas y patrones de comportamiento. Vuelve atrás cuando termines."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面では、期限、重要度、タグ、行動パターンを使ったルールによる並べ替えを説明します。確認したら、前の画面に戻って続けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面介绍如何根据截止日期、重要性、标签和行为模式进行规则排序。查看完毕后，请返回以继续。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet écran explique le tri basé sur les échéances, l’importance, les étiquettes et les habitudes comportementales. Revenez en arrière après l’avoir consulté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa schermata spiega l’ordinamento basato su regole che usa scadenze, importanza, tag e modelli comportamentali. Torna indietro quando hai finito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bildschirm erklärt die regelbasierte Sortierung anhand von Fälligkeit, Wichtigkeit, Tags und Verhaltensmustern. Gehe zurück, wenn du fertig bist."
          }
        }
      }
    },
    "tutorial.body.이메일 연동을 눌러 메일 연결 화면을 확인해보세요. 메일 연동은 선택입니다.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Email Integration to review the mail connection screen. Mail integration is optional."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 연동을 눌러 메일 연결 화면을 확인해보세요. 메일 연동은 선택입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Integración de correo para revisar la pantalla de conexión del correo. La integración de correo es opcional."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メール連携」をタップしてメール接続画面を確認してみましょう。メール連携は任意です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“邮箱集成”，查看邮箱连接页面。邮箱集成是可选功能。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Intégration des e-mails pour consulter l’écran de connexion de la messagerie. Cette intégration est facultative."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Integrazione email per controllare la schermata di collegamento della posta. L'integrazione della posta è facoltativa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „E-Mail-Anbindung“, um den Bildschirm zur E-Mail-Verbindung anzusehen. Die E-Mail-Anbindung ist optional."
          }
        }
      }
    },
    "tutorial.body.이제 설정을 닫고 탭바의 메일을 눌러 실제 메일 탭을 열어보세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Settings and tap Mail in the tab bar to open the Mail tab."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 설정을 닫고 탭바의 메일을 눌러 실제 메일 탭을 열어보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra Ajustes y toca Correo en la barra de pestañas para abrir la pestaña Correo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を閉じて、タブバーの「メール」をタップしメールタブを開いてみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭设置，然后轻点标签栏中的“邮件”，打开邮件标签页。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez les Réglages et touchez Courrier dans la barre d’onglets pour ouvrir l’onglet Courrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi Impostazioni e tocca Posta nella barra delle schede per aprire la scheda Posta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die Einstellungen und tippe in der Tableiste auf „E-Mails“, um den E-Mail-Tab zu öffnen."
          }
        }
      }
    },
    "tutorial.body.이제 설정을 닫고 탭바의 캘린더를 눌러 실제 캘린더 탭을 열어보세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Settings and tap Calendar in the tab bar to open the Calendar tab."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 설정을 닫고 탭바의 캘린더를 눌러 실제 캘린더 탭을 열어보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra Ajustes y toca Calendario en la barra de pestañas para abrir la pestaña Calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を閉じて、タブバーの「カレンダー」をタップしカレンダータブを開いてみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭设置，然后轻点标签栏中的“日历”，打开日历标签页。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez les Réglages et touchez Calendrier dans la barre d’onglets pour ouvrir l’onglet Calendrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi Impostazioni e tocca Calendario nella barra delle schede per aprire la scheda Calendario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die Einstellungen und tippe in der Tableiste auf „Kalender“, um den Kalender-Tab zu öffnen."
          }
        }
      }
    },
    "tutorial.body.이제 설정을 닫고 할 일 탭으로 돌아가 AI 정리를 눌러보세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Settings, return to To-Dos, and tap Prioritize with AI."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 설정을 닫고 할 일 탭으로 돌아가 AI 정리를 눌러보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra Ajustes, vuelve a Tareas y toca Priorizar con IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を閉じてタスクタブに戻り、「AI整理」をタップしてみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭设置，返回“待办事项”，然后轻点“AI 优先级排序”。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez les Réglages, revenez à Tâches et touchez Prioriser avec l’IA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi Impostazioni, torna ad Attività e tocca Definisci le priorità con l'IA."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die Einstellungen, kehre zu „Aufgaben“ zurück und tippe auf „Mit KI priorisieren“."
          }
        }
      }
    },
    "tutorial.body.제목은 필수입니다. 메모에는 배경 정보나 처리 기준을 적어두면 나중에 AI 정리와 검색에 도움이 됩니다.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목은 필수입니다. 메모에는 배경 정보나 처리 기준을 적어두면 나중에 AI 정리와 검색에 도움이 됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title is required. Use notes for background or handling criteria so AI sorting and search can work better later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El título es obligatorio. Usa las notas para añadir contexto o criterios de gestión que ayuden después a la ordenación con IA y a la búsqueda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルは必須です。メモに背景情報や対応の基準を書いておくと、後からAIで整理したり検索したりする際に役立ちます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题为必填项。在备注中记录背景信息或处理标准，有助于之后的 AI 排序和搜索。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre est obligatoire. Ajoutez du contexte ou des critères de traitement dans les notes pour faciliter ensuite la priorisation par IA et la recherche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il titolo è obbligatorio. Usa le note per informazioni di contesto o criteri di gestione, così l’ordinamento con IA e la ricerca funzioneranno meglio in seguito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Titel ist erforderlich. Halte Hintergrundinformationen oder Bearbeitungskriterien in den Notizen fest, damit KI-Sortierung und Suche später besser funktionieren."
          }
        }
      }
    },
    "tutorial.body.탭바의 메일을 눌러 연결된 메일을 확인하는 화면을 열어보세요.": {
