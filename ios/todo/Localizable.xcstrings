          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription n’a pas pu être terminée. L’enregistrement a été sauvegardé ; réessayez la transcription privilégiant la précision."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
