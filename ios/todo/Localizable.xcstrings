          "stringUnit": {
            "state": "translated",
            "value": "Continuer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter"
          }
        }
      }
    },
    "permissions.firstLaunch.local.detail": {
      "comment": "Local processing boundary and separate explicit recording consent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting recording, transcription, and analysis run locally. Granting microphone access does not start a recording. You choose the audio sources and confirm recording consent in the meeting screen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 녹음·전사·분석은 기기에서 처리합니다. 마이크를 허용해도 녹음은 시작되지 않습니다. 회의 화면에서 음성 소스를 선택하고 녹음 동의를 확인합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación, la transcripción y el análisis de reuniones se realizan localmente. Conceder acceso al micrófono no inicia una grabación. Tú eliges las fuentes de audio y confirmas el consentimiento de grabación en la pantalla de reuniones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の録音、文字起こし、分析はデバイス上でローカルに実行されます。マイクへのアクセスを許可しても録音は開始されません。会議画面で音声ソースを選択し、録音の同意を確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议录音、转写和分析均在本机进行。授予麦克风权限不会开始录音。您需要在会议页面选择音频来源并确认录音同意。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement, la transcription et l’analyse des réunions sont effectués localement. Autoriser l’accès au microphone ne démarre pas d’enregistrement. Vous choisissez les sources audio et confirmez le consentement à l’enregistrement sur l’écran de réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione, la trascrizione e l'analisi delle riunioni vengono eseguite localmente. Consentire l'accesso al microfono non avvia una registrazione. Scegli le sorgenti audio e conferma il consenso alla registrazione nella schermata della riunione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme, Transkription und Analyse von Besprechungen erfolgen lokal. Die Erlaubnis zum Mikrofonzugriff startet keine Aufnahme. Auf dem Besprechungsbildschirm wählst du die Audioquellen aus und bestätigst die Einwilligung zur Aufnahme."
          }
        }
      }
    },
    "permissions.firstLaunch.local.title": {
      "comment": "Meeting audio processing privacy explanation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio stays on this device"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 처리는 이 기기에서"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio permanece en este dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声はこのデバイス内に保持されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频保留在此设备上"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio reste sur cet appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio rimane su questo dispositivo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio bleibt auf diesem Gerät"
          }
        }
      }
    },
    "permissions.firstLaunch.optional": {
      "comment": "Access is optional and denial does not block onboarding.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can continue without granting access and change it later in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하지 않아도 계속할 수 있으며, 나중에 설정에서 바꿀 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes continuar sin conceder acceso y cambiarlo más adelante en Ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスを許可せずに進めることもでき、後から「設定」で変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以不授予权限并继续使用，之后可在设置中更改。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez continuer sans autoriser l’accès et modifier ce choix plus tard dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi continuare senza consentire l'accesso e modificarlo in seguito in Impostazioni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst ohne Zugriffserlaubnis fortfahren und sie später in den Einstellungen ändern."
          }
        }
      }
    },
    "permissions.firstLaunch.review.detail": {
      "comment": "Do not treat generated meeting actions as verified facts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI transcripts and summaries can be wrong. Review the original transcript before turning suggested actions into to-dos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 전사와 요약에는 오류가 있을 수 있습니다. 제안된 내용을 할 일로 등록하기 전에 원문을 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transcripciones y los resúmenes de la IA pueden contener errores. Revisa la transcripción original antes de convertir las acciones sugeridas en tareas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIによる文字起こしや要約には誤りが含まれる可能性があります。提案されたアクションをタスクに登録する前に、元の文字起こしをご確認ください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 转写和摘要可能有误。将建议行动转为待办事项前，请核对转写原文。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transcriptions et les résumés produits par l’IA peuvent contenir des erreurs. Vérifiez la transcription originale avant de transformer les actions suggérées en tâches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trascrizioni e i riepiloghi dell'IA possono contenere errori. Controlla la trascrizione originale prima di trasformare le azioni suggerite in attività."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Transkripte und -Zusammenfassungen können Fehler enthalten. Prüfe das Originaltranskript, bevor du vorgeschlagene Aktionen in Aufgaben umwandelst."
          }
        }
      }
    },
    "permissions.firstLaunch.review.title": {
      "comment": "Human review before registering a suggested meeting action.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review before acting"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인한 뒤 실행하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa antes de actuar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認してから実行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对后再行动"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez avant d’agir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla prima di agire"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Handeln prüfen"
          }
        }
      }
    },
    "permissions.firstLaunch.subtitle": {
      "comment": "First-run preparation does not start capture.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow only what you need. Nothing is recorded on this screen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 기능만 허용하세요. 이 화면에서는 녹음하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite solo lo que necesites. No se graba nada en esta pantalla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要な権限のみを許可してください。この画面で録音されることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅允许您需要的功能。此页面不会录音。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez uniquement ce dont vous avez besoin. Rien n’est enregistré sur cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti solo ciò che ti serve. In questa schermata non viene registrato nulla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube nur, was du brauchst. Auf diesem Bildschirm wird nichts aufgenommen."
          }
        }
      }
    },
