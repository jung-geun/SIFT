    "legal.text.이메일 OAuth 토큰·IMAP 앱 비밀번호": {
      "comment": "English legal translation preserving the Korean source structure and meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email OAuth tokens and IMAP app passwords"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 OAuth 토큰·IMAP 앱 비밀번호"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens de OAuth del correo y contraseñas de aplicación de IMAP"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールのOAuthトークン・IMAPアプリパスワード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件 OAuth 令牌和 IMAP 应用专用密码"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetons OAuth des e-mails et mots de passe d’application IMAP"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Token OAuth delle email e password per le app IMAP"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail-OAuth-Token und IMAP-App-Passwörter"
          }
        }
      }
    },
    "legal.text.이메일 OAuth 토큰·IMAP 앱 비밀번호는 Keychain에 저장하며, OpenAI 액세스·갱신·ID 토큰은 동기화하지 않는 기기 전용 Keychain에 저장합니다.": {
      "comment": "English legal translation preserving source meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email OAuth tokens and IMAP passwords are stored in Keychain. OpenAI access, refresh, and ID tokens use nonsynchronizable, device-only Keychain storage."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 OAuth 토큰·IMAP 앱 비밀번호는 Keychain에 저장하며, OpenAI 액세스·갱신·ID 토큰은 동기화하지 않는 기기 전용 Keychain에 저장합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tokens OAuth del correo y las contraseñas IMAP se guardan en Keychain. Los tokens de acceso, actualización e ID de OpenAI usan un almacenamiento de Keychain exclusivo del dispositivo y no sincronizable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールのOAuthトークンとIMAPパスワードはKeychainに保存されます。OpenAIのアクセストークン、更新トークン、IDトークンは、同期しないデバイス専用のKeychainに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件 OAuth 令牌和 IMAP 应用专用密码保存在 Keychain 中。OpenAI 访问令牌、刷新令牌和 ID 令牌使用不可同步、仅限本设备的 Keychain 存储。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jetons OAuth des e-mails et les mots de passe IMAP sont stockés dans le trousseau Keychain. Les jetons d’accès, d’actualisation et d’identité OpenAI sont stockés dans le trousseau Keychain uniquement sur l’appareil, sans synchronisation possible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I token OAuth delle email e le password IMAP sono salvati nel Keychain. I token OpenAI di accesso, aggiornamento e ID usano l’archiviazione Keychain non sincronizzabile e limitata al dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail-OAuth-Tokens und IMAP-Passwörter werden in der Keychain gespeichert. OpenAI-Zugriffs-, Aktualisierungs- und ID-Tokens werden ausschließlich auf dem Gerät in einem nicht synchronisierbaren Keychain-Speicher abgelegt."
          }
        }
      }
    },
