      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verantwortung aus der Nutzung von Diensten Dritter trägt der Benutzer selbst im Verhältnis zum jeweiligen Anbieter."
          }
        },
        "en" : {
