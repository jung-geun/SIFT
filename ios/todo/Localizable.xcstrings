    "mail.openai.explanation": {
      "comment": "Explain that optional remote email analysis needs separate sharing consent and automatic analysis stays on device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional remote analysis requires separate sharing consent. Automatic mail analysis remains local."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택적 외부 분석에는 별도 전송 동의가 필요합니다. 자동 메일 분석은 계속 기기 내에서 처리합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis remoto opcional requiere un consentimiento de envío independiente. El análisis automático del correo sigue siendo local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意の外部分析には、データ共有への別途同意が必要です。メールの自動分析は引き続きデバイス内で行われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选的远程分析需要单独同意共享数据。自动邮件分析仍在设备上进行。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse distante facultative nécessite un consentement distinct au partage. L’analyse automatique des e-mails reste locale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi remota facoltativa richiede un consenso separato alla condivisione. L’analisi automatica delle email resta sul dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die optionale externe Analyse erfordert eine separate Einwilligung zur Datenweitergabe. Die automatische E-Mail-Analyse bleibt lokal."
          }
        }
      }
    },
