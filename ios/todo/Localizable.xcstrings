          }
        }
      }
    },
    "error.mail.service.remoteCommittedLocalSaveFailed": {
      "comment": "Generated service prose; interpolated values preserve source content.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로바이더에는 반영되었지만 로컬 상태 저장에 실패했습니다. 메일 목록을 다시 동기화합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change was applied by the provider, but the local state could not be saved. Sync the mailbox again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor aplicó el cambio, pero no se pudo guardar el estado local. Vuelve a sincronizar el buzón."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールサービス側には変更が反映されましたが、デバイス上の状態を保存できませんでした。メールボックスを再同期してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改已在邮件服务商端生效，但无法保存本地状态。请重新同步邮箱。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a appliqué la modification, mais l’état local n’a pas pu être enregistré. Synchronisez à nouveau la boîte de réception."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica è stata applicata dal fornitore, ma non è stato possibile salvare lo stato locale. Sincronizza di nuovo la casella di posta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung wurde beim Anbieter übernommen, der lokale Status konnte jedoch nicht gespeichert werden. Synchronisiere das Postfach erneut."
          }
        }
      }
    },
