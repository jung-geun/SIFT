    "openai.settings.syncNotice" : {
      "comment" : "ChatGPT secure credential synchronization; app-data consent and host identity remain device-local.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind die iCloud-Synchronisierung der App und der iCloud-Schlüsselbund aktiviert, können Verbindungen unter demselben Apple Account wiederhergestellt werden, sobald Apple die Synchronisierung abgeschlossen hat. Anbieteraktivierung und Zustimmung zur Datenweitergabe werden auf jedem Gerät separat festgelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With app iCloud sync and iCloud Keychain on, connections can be restored under the same Apple account after Apple finishes syncing. Provider activation and sharing consent are set separately on each device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la sincronización de iCloud de la app y el llavero de iCloud activados, las conexiones pueden restaurarse con la misma cuenta de Apple cuando Apple termine de sincronizar. La activación del proveedor y el consentimiento para compartir datos se configuran por separado en cada dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque la synchronisation iCloud de l’app et le trousseau iCloud sont activés, les connexions peuvent être restaurées avec le même compte Apple une fois la synchronisation Apple terminée. L’activation du fournisseur et le consentement au partage des données se règlent séparément sur chaque appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la sincronizzazione iCloud dell’app e il portachiavi iCloud attivi, le connessioni possono essere ripristinate con lo stesso account Apple al termine della sincronizzazione di Apple. L’attivazione del fornitore e il consenso alla condivisione dei dati si impostano separatamente su ogni dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのiCloud同期とiCloudキーチェーンをオンにすると、Appleの同期完了後に、同じApple Accountで接続を復元できます。プロバイダの有効化とデータ送信への同意は、デバイスごとに設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱의 iCloud 동기화와 iCloud 키체인을 켜면 같은 Apple 계정에서 연결을 복원할 수 있습니다. Apple의 동기화 완료 후 적용되며, 제공자 활성화와 전송 동의는 기기마다 설정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启应用的 iCloud 同步和 iCloud 钥匙串后，可在 Apple 完成同步后，使用同一 Apple 账户恢复连接。服务提供方的启用状态和数据共享同意需在每台设备上单独设置。"
          }
        }
      }
    },
