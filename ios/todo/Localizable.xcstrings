    "intelligence.footer.foundationModels": {
      "comment": "Localized UI copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models (on device) prioritizes your to-dos. It falls back to heuristics if unavailable."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models(온디바이스)가 할 일을 정렬합니다. 실패하면 휴리스틱으로 폴백합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models (en el dispositivo) prioriza tus tareas. Si no está disponible, se usan métodos heurísticos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models（オンデバイス）がTo-Doに優先順位を付けます。利用できない場合は、ヒューリスティックに切り替わります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models（设备端）会为待办事项进行优先级排序。不可用时，将改用启发式规则。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models (sur l’appareil) classe vos tâches par priorité. En cas d’indisponibilité, des heuristiques sont utilisées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models (sul dispositivo) ordina le attività per priorità. Se non è disponibile, vengono usate regole euristiche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models priorisieren deine Aufgaben auf dem Gerät. Sind sie nicht verfügbar, werden heuristische Verfahren verwendet."
          }
        }
      }
    },
