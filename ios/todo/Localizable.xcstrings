    "beta.autoRefine.description" : {
      "comment" : "Automatic on-device transcript correction defaults on and prefers available Apple Intelligence; users may opt out.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korrigiert Erkennungs- und Tippfehler nach der Aufnahme oder erneuten Transkription auf dem Gerät. Standardmäßig wird Apple Intelligence verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrects recognition errors and typos on device after recording or retranscription. Apple Intelligence is the default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige errores de reconocimiento y de escritura en el dispositivo tras grabar o volver a transcribir. Apple Intelligence es la opción predeterminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige les erreurs de reconnaissance et les fautes de frappe sur l’appareil après l’enregistrement ou une nouvelle transcription. Apple Intelligence est utilisé par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corregge errori di riconoscimento e refusi sul dispositivo dopo la registrazione o una nuova trascrizione. Apple Intelligence è l’opzione predefinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音や再文字起こしの後に、認識ミスや誤字をデバイス内で修正します。標準ではApple Intelligenceを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음·재전사 후 기기에서 오인식과 오탈자를 교정합니다. Apple Intelligence를 기본으로 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音或重新转写后，在设备上纠正识别错误和错别字。默认使用 Apple Intelligence。"
          }
        }
      }
    },
