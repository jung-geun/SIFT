    "diagnostics.send.detail": {
      "comment": "Diagnostic report sending consent detail.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecting Send lets you review the report first. The app never transmits logs without your consent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기를 누르면 보고서를 검토할 수 있습니다. 앱은 동의 없이 로그를 네트워크로 전송하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al seleccionar Enviar, puedes revisar primero el informe. La app nunca transmite registros sin tu consentimiento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「送信」を選択すると、まずレポートを確認できます。アプリは同意なくログを送信することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“发送”后，您可以先审核报告。应用绝不会在未经您同意的情况下传输日志。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En sélectionnant Envoyer, vous pouvez d’abord consulter le rapport. L’app ne transmet jamais de journaux sans votre consentement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezionando Invia puoi prima rivedere il rapporto. L’app non trasmette mai log senza il tuo consenso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du „Senden“ wählst, kannst du den Bericht zunächst prüfen. Die App übermittelt nie Protokolle ohne deine Einwilligung."
          }
        }
      }
    },
