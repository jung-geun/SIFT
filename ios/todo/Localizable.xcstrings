    "settings.sync.full.offline" : {
      "comment" : "Full iCloud storage scope, consent and real transport status.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Deaktivieren der Synchronisierung bleiben lokale Daten und Daten auf anderen Geräten erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turning sync off retains local data and does not erase other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivar la sincronización conserva los datos locales y no borra los de otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver la synchronisation conserve les données locales et n’efface pas celles des autres appareils."
          }
        },
        "it" : {
          "stringUnit" : {
