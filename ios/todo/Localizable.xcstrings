    "tutorial.body.TODO 우선순위 규칙을 눌러 자동 정렬이 사용하는 규칙을 확인해보세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TODO 우선순위 규칙을 눌러 자동 정렬이 사용하는 규칙을 확인해보세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap To-Do Priority Rules to review the rules used for automatic sorting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Reglas de prioridad de tareas para revisar las reglas de la ordenación automática."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「タスクの優先順位ルール」をタップして、自動並べ替えに使われるルールを確認してみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“待办事项优先级规则”，查看自动排序使用的规则。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Règles de priorité des tâches pour consulter les règles du tri automatique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Regole di priorità delle attività per rivedere le regole usate per l’ordinamento automatico."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Aufgabenprioritätsregeln“, um die Regeln der automatischen Sortierung zu prüfen."
          }
        }
      }
    },
    "tutorial.body.TODO 자동 정렬 및 AI를 눌러 자동 정렬에 사용할 AI를 선택할 수 있는 화면으로 들어가보세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap To-Do Prioritization AI to choose the AI used for automatic prioritization."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TODO 자동 정렬 및 AI를 눌러 자동 정렬에 사용할 AI를 선택할 수 있는 화면으로 들어가보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca IA para priorizar tareas para elegir la IA que se usará en la priorización automática."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「タスク優先順位AI」をタップして、自動優先順位付けに使用するAIを選択する画面を開いてみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“待办事项优先级 AI”，选择用于自动整理优先级的 AI。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez IA de priorisation des tâches pour choisir l’IA utilisée pour la priorisation automatique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca IA per la priorità delle attività per scegliere l'IA da usare per la definizione automatica delle priorità."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „KI-Aufgabenpriorisierung“, um die KI für die automatische Priorisierung auszuwählen."
          }
        }
      }
    },
    "tutorial.body.기본 우선순위는 자동입니다. 추가 옵션에서 필요할 때만 직접 우선순위를 고정하세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 우선순위는 자동입니다. 추가 옵션에서 필요할 때만 직접 우선순위를 고정하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Priority is automatic by default. Open More Options to set a fixed priority only when you need one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prioridad es automática de forma predeterminada. Abre Más opciones para fijar una prioridad solo cuando lo necesites."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優先度は標準では自動です。固定する必要がある場合にのみ、「その他のオプション」で指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先级默认为自动。仅在需要时，打开“更多选项”手动设置固定优先级。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La priorité est automatique par défaut. Ouvrez Plus d’options pour fixer une priorité uniquement si nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La priorità è automatica per impostazione predefinita. Apri Altre opzioni per impostare una priorità fissa solo quando serve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Priorität wird standardmäßig automatisch bestimmt. Lege unter „Weitere Optionen“ nur bei Bedarf eine feste Priorität fest."
          }
        }
      }
    },
    "tutorial.body.내용을 확인한 뒤 추가를 누르면 할 일이 저장됩니다. 지금 저장하지 않으려면 취소로 나가도 튜토리얼은 다음 단계로 이어집니다.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용을 확인한 뒤 추가를 누르면 할 일이 저장됩니다. 지금 저장하지 않으려면 취소로 나가도 튜토리얼은 다음 단계로 이어집니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After reviewing the details, tap Add to save the to-do. You can cancel without saving and the tutorial will continue to the next step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de revisar los detalles, toca Añadir para guardar la tarea. Puedes cancelar sin guardar y el tutorial continuará con el siguiente paso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容を確認して「追加」をタップすると、タスクが保存されます。保存せずにキャンセルしても、チュートリアルは次の手順に進みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认内容后，轻点“添加”即可保存待办事项。也可以取消而不保存，教程仍会继续下一步。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir vérifié les détails, touchez Ajouter pour enregistrer la tâche. Vous pouvez annuler sans enregistrer : le tutoriel passera quand même à l’étape suivante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver rivisto i dettagli, tocca Aggiungi per salvare l’attività. Puoi annullare senza salvare e il tutorial passerà alla fase successiva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Angaben und tippe auf „Hinzufügen“, um die Aufgabe zu speichern. Du kannst auch ohne Speichern abbrechen; die Einführung geht dann mit dem nächsten Schritt weiter."
          }
        }
      }
    },
    "tutorial.body.마감 시각 설정을 켜면 날짜와 시간을 고를 수 있습니다. 추가 옵션에서 캘린더에 지금 등록하거나 알림을 선택할 수 있습니다.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감 시각 설정을 켜면 날짜와 시간을 고를 수 있습니다. 추가 옵션에서 캘린더에 지금 등록하거나 알림을 선택할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Set Due Time to choose a date and time. Use More Options to add it to your calendar now or choose reminders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Establecer hora de vencimiento para elegir una fecha y una hora. Usa Más opciones para añadirla ahora a tu calendario o elegir recordatorios."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「期限の時刻を設定」をオンにすると、日付と時刻を選べます。「その他のオプション」では、カレンダーへの登録やリマインダーを選択できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用“设置截止时间”后，即可选择日期和时间。在“更多选项”中，可立即添加到日历或选择提醒。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Définir l’heure d’échéance pour choisir une date et une heure. Dans Plus d’options, ajoutez la tâche au calendrier dès maintenant ou choisissez des rappels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Imposta ora di scadenza per scegliere data e ora. Usa Altre opzioni per aggiungere subito l’attività al calendario o scegliere i promemoria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Fälligkeit festlegen“, um Datum und Uhrzeit auszuwählen. Unter „Weitere Optionen“ kannst du die Aufgabe sofort zum Kalender hinzufügen oder Erinnerungen wählen."
          }
        }
      }
    },
    "tutorial.body.설정 목록에서 나의 페르소나를 눌러 프로필을 확인해보세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap My Persona in Settings to review your profile."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 목록에서 나의 페르소나를 눌러 프로필을 확인해보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Mi perfil personal en Ajustes para revisar tu perfil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」の「マイペルソナ」をタップして、プロフィールを確認してみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中轻点“我的个人画像”，查看您的资料。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Mon profil personnel dans les Réglages pour consulter votre profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca La mia persona in Impostazioni per controllare il tuo profilo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in den Einstellungen auf „Meine Persona“, um dein Profil anzusehen."
          }
        }
      }
    },
    "tutorial.body.시스템 권한 및 상태를 눌러 알림과 캘린더 권한 상태를 확인해보세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap System Permissions & Status to review notification and calendar permissions."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 권한 및 상태를 눌러 알림과 캘린더 권한 상태를 확인해보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Permisos y estado del sistema para revisar los permisos de notificaciones y calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム権限と状態」をタップして、通知とカレンダーの権限状態を確認してみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“系统权限与状态”，查看通知和日历权限。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Autorisations et état du système pour consulter les autorisations des notifications et du calendrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Autorizzazioni e stato del sistema per controllare le autorizzazioni per le notifiche e il calendario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Systemberechtigungen und Status“, um die Berechtigungen für Mitteilungen und Kalender zu prüfen."
          }
        }
      }
    },
    "tutorial.body.여기서 생활 유형과 설명을 확인하거나 다시 설정할 수 있습니다. 확인했으면 뒤로 돌아가 계속하세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review or reset your lifestyle type and description here. Go back when you are ready to continue."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 생활 유형과 설명을 확인하거나 다시 설정할 수 있습니다. 확인했으면 뒤로 돌아가 계속하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí puedes revisar o restablecer tu tipo de estilo de vida y su descripción. Vuelve atrás cuando quieras continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでライフスタイルタイプや説明を確認・再設定できます。確認したら前に戻って続けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以在这里查看或重设生活方式类型及说明。准备好继续后，请返回。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez ou réinitialisez ici votre type de mode de vie et sa description. Revenez en arrière lorsque vous souhaitez continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui puoi controllare o reimpostare il tuo tipo di stile di vita e la relativa descrizione. Torna indietro quando vuoi continuare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier kannst du deinen Lebensstiltyp und dessen Beschreibung prüfen oder zurücksetzen. Gehe zurück, wenn du fortfahren möchtest."
          }
        }
      }
    },
    "tutorial.body.여기서 연결된 메일을 확인하고 할 일로 등록할 수 있습니다. 확인했으면 할 일 탭으로 돌아가 계속하세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review connected mail and register to-dos here. Go back to To-Dos when ready to continue."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 연결된 메일을 확인하고 할 일로 등록할 수 있습니다. 확인했으면 할 일 탭으로 돌아가 계속하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí puedes revisar el correo conectado y registrar tareas. Vuelve a Tareas cuando quieras continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで連携されたメールを確認し、タスクとして登録できます。確認したらタスクタブに戻って続けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以在这里查看已连接邮箱中的邮件，并将其添加为待办事项。准备好继续后，请返回“待办事项”。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez ici les e-mails des comptes connectés et ajoutez des tâches. Revenez à Tâches lorsque vous souhaitez continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui puoi controllare la posta collegata e aggiungere attività. Torna ad Attività quando vuoi continuare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier kannst du verbundene E-Mails prüfen und Aufgaben anlegen. Gehe zurück zu „Aufgaben“, wenn du fortfahren möchtest."
          }
        }
      }
    },
    "tutorial.body.여기서 제목을 입력해 추가할 수 있습니다. 둘러본 뒤 취소하거나 추가하면 다음 안내로 넘어갑니다.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a title here to add a to-do. Cancel or add it after looking around to continue."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 제목을 입력해 추가할 수 있습니다. 둘러본 뒤 취소하거나 추가하면 다음 안내로 넘어갑니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un título aquí para añadir una tarea. Después de explorar la pantalla, cancela o añádela para continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでタイトルを入力してタスクを追加できます。確認後にキャンセルまたは追加すると次の案内へ進みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里输入标题即可添加待办事项。查看后，取消或添加均可继续下一步引导。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un titre ici pour ajouter une tâche. Après avoir exploré cet écran, annulez ou ajoutez la tâche pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci qui un titolo per aggiungere un'attività. Dopo aver esplorato la schermata, annulla o aggiungi l'attività per continuare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib hier einen Titel ein, um eine Aufgabe hinzuzufügen. Sieh dich um und brich dann ab oder füge die Aufgabe hinzu, um fortzufahren."
          }
        }
      }
    },
    "tutorial.body.여기서 캘린더 일정과 앱 할 일을 함께 볼 수 있습니다. 확인했으면 할 일 탭으로 돌아가 계속하세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review calendar events and app to-dos together here. Go back to To-Dos when ready to continue."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 캘린더 일정과 앱 할 일을 함께 볼 수 있습니다. 확인했으면 할 일 탭으로 돌아가 계속하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí puedes consultar los eventos del calendario y las tareas de la aplicación juntos. Vuelve a Tareas cuando quieras continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでカレンダーの予定とアプリのタスクを一緒に確認できます。確認したらタスクタブに戻って続けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以在这里一起查看日历日程和应用中的待办事项。准备好继续后，请返回“待办事项”。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez ici les événements du calendrier et les tâches de l’app au même endroit. Revenez à Tâches lorsque vous souhaitez continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui puoi vedere insieme gli eventi del calendario e le attività dell'app. Torna ad Attività quando vuoi continuare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier kannst du Kalendertermine und Aufgaben aus der App gemeinsam ansehen. Gehe zurück zu „Aufgaben“, wenn du fortfahren möchtest."
          }
        }
      }
    },
    "tutorial.body.왼쪽 위 AI 정리 버튼을 눌러 실제 자동 정렬을 실행해보세요. 할 일이 없으면 먼저 하나 추가한 뒤 눌러보세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Prioritize with AI in the upper left to run prioritization. Add a to-do first if the list is empty."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 위 AI 정리 버튼을 눌러 실제 자동 정렬을 실행해보세요. 할 일이 없으면 먼저 하나 추가한 뒤 눌러보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Priorizar con IA en la esquina superior izquierda para ejecutar la priorización. Si la lista está vacía, añade primero una tarea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上の「AI整理」ボタンをタップして、実際に自動並べ替えを実行してみましょう。タスクがない場合は、先に追加してからタップしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点左上角的“AI 优先级排序”来运行排序。如果列表为空，请先添加一条待办事项。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Prioriser avec l’IA en haut à gauche pour lancer la priorisation. Si la liste est vide, ajoutez d’abord une tâche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Definisci le priorità con l'IA in alto a sinistra per avviare la definizione delle priorità. Se l'elenco è vuoto, aggiungi prima un'attività."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben links auf „Mit KI priorisieren“, um die Priorisierung zu starten. Füge zuerst eine Aufgabe hinzu, falls die Liste leer ist."
          }
        }
      }
    },
    "tutorial.body.우측 상단 + 버튼을 눌러 새 할 일 화면을 열어보세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우측 상단 + 버튼을 눌러 새 할 일 화면을 열어보세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the + button in the upper right to open the new to-do screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón + en la esquina superior derecha para abrir la pantalla de nueva tarea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の＋ボタンをタップして、新規タスク画面を開いてみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点右上角的 + 按钮，打开新建待办事项页面。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton + en haut à droite pour ouvrir l’écran de création d’une tâche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante + in alto a destra per aprire la schermata di una nuova attività."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben rechts auf +, um den Bildschirm für eine neue Aufgabe zu öffnen."
          }
        }
      }
    },
    "tutorial.body.우측 상단 + 버튼을 눌러 실제로 새 할 일을 열어보세요. 제목은 필수이고, 마감일과 알림은 선택입니다.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the + button in the upper right to open a real to-do. A title is required; due dates and reminders are optional."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우측 상단 + 버튼을 눌러 실제로 새 할 일을 열어보세요. 제목은 필수이고, 마감일과 알림은 선택입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón + en la esquina superior derecha para abrir una tarea real. El título es obligatorio; las fechas de vencimiento y los recordatorios son opcionales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の「+」ボタンをタップして、新しいタスク作成画面を開いてみましょう。タイトルは必須で、期限とリマインダーは任意です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点右上角的 + 按钮，打开新建待办事项页面。标题为必填项；截止日期和提醒为选填项。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton + en haut à droite pour ouvrir une nouvelle tâche. Le titre est obligatoire ; l’échéance et les rappels sont facultatifs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante + in alto a destra per aprire una nuova attività. Il titolo è obbligatorio; scadenze e promemoria sono facoltativi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben rechts auf die Schaltfläche +, um eine neue Aufgabe zu öffnen. Ein Titel ist erforderlich; Fälligkeit und Erinnerungen sind optional."
          }
        }
      }
    },
    "tutorial.body.우측 상단 더 보기 > 설정을 눌러 TODO 우선순위 규칙 항목으로 이동해보세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우측 상단 더 보기 > 설정을 눌러 TODO 우선순위 규칙 항목으로 이동해보세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap More > Settings in the upper right, then open To-Do Priority Rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Más > Ajustes en la esquina superior derecha y abre Reglas de prioridad de tareas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の「その他」>「設定」をタップし、「タスクの優先順位ルール」を開いてみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点右上角的“更多 > 设置”，然后打开“待办事项优先级规则”。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Plus > Réglages en haut à droite, puis ouvrez Règles de priorité des tâches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Altro > Impostazioni in alto a destra, poi apri Regole di priorità delle attività."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben rechts auf Mehr > Einstellungen und öffne dann die Aufgabenprioritätsregeln."
          }
        }
      }
    },
    "tutorial.body.우측 상단 더 보기 > 설정을 눌러 나의 페르소나를 확인해보세요.": {
