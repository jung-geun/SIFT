      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unabhängig vom Anzeigezeitraum des Posteingangs werden für die automatische Aufgaben- und Terminanalyse nur E-Mails aus folgendem Zeitraum berücksichtigt: die letzten"
