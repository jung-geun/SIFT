    "calendar.ownership.notVerified" : {
      "comment" : "Calendar mutation refused: ownership or account recovery is ambiguous; no calendar changes occurred.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFT konnte keinen eindeutig zugehörigen Kalendertermin bestätigen. Der Kalender wurde nicht geändert. Verbinde das ursprüngliche Kalenderkonto erneut oder bereinige doppelte Termine in Kalender."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFT could not verify a unique owned calendar event. No calendar changes were made. Reconnect the original calendar account or resolve duplicate events in Calendar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFT no pudo identificar un único evento de calendario de su propiedad. No se modificó el calendario. Vuelve a conectar la cuenta de calendario original o revisa los eventos duplicados en Calendario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFT n’a pas pu identifier un événement de calendrier unique lui appartenant. Le calendrier n’a pas été modifié. Reconnectez le compte de calendrier d’origine ou résolvez les doublons dans Calendrier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFT non ha potuto identificare un unico evento di calendario di sua proprietà. Il calendario non è stato modificato. Ricollega l’account del calendario originale o risolvi gli eventi duplicati in Calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFTが所有するカレンダーの予定を一意に確認できなかったため、カレンダーは変更していません。元のカレンダーアカウントを再接続するか、カレンダーで重複した予定を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFT가 소유한 캘린더 일정을 하나로 확인할 수 없어 캘린더를 변경하지 않았습니다. 원래 캘린더 계정을 다시 연결하거나 캘린더에서 중복 일정을 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFT 无法确认唯一的自有日历事件，因此未更改日历。请重新连接原日历账户，或在日历中处理重复事件。"
          }
        }
      }
    },
    "calendar.permission.accountNotice" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Google-, iCloud- oder Exchange-Konten in den Kalender-Kontoeinstellungen deines Gerätesystems hinzu. SIFT nutzt diese Kalender über die Systemberechtigung und bietet keine separate OAuth-Anmeldung für Kalender an. Falls der Zugriff verweigert wurde, erlaube ihn in den App-Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add Google, iCloud, or Exchange accounts in your device's system Calendar account settings. SIFT uses those calendars through system permission and does not offer a separate calendar OAuth sign-in. If access was denied, allow it in App Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade cuentas de Google, iCloud o Exchange en los ajustes de cuentas del calendario del sistema de tu dispositivo. SIFT usa esos calendarios mediante el permiso del sistema y no ofrece un inicio de sesión OAuth independiente para calendarios. Si se denegó el acceso, permítelo en los ajustes de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez vos comptes Google, iCloud ou Exchange dans les réglages système des comptes de calendrier de votre appareil. SIFT utilise ces calendriers avec l’autorisation du système et ne propose pas de connexion OAuth distincte pour les calendriers. Si l’accès a été refusé, autorisez-le dans les réglages de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi account Google, iCloud o Exchange nelle impostazioni di sistema degli account calendario del dispositivo. SIFT usa quei calendari tramite l’autorizzazione di sistema e non offre un accesso OAuth separato per i calendari. Se l’accesso è stato negato, consentilo nelle impostazioni dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google、iCloud、Exchangeのアカウントは、デバイスのシステム設定にあるカレンダーのアカウント設定で追加してください。SIFTはシステムのアクセス権を通じてこれらのカレンダーを使用します。カレンダー専用のOAuthログインは提供していません。アクセスが拒否されている場合は、アプリの設定で許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google·iCloud·Exchange 계정은 기기의 시스템 캘린더 계정 설정에서 추가하세요. SIFT는 시스템 권한을 통해 해당 캘린더를 사용하며, 별도의 캘린더 OAuth 로그인을 제공하지 않습니다. 접근이 거부되었다면 앱 시스템 설정에서 허용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在设备系统设置中的日历账户设置里添加 Google、iCloud 或 Exchange 账户。SIFT 通过系统授权使用这些日历，不提供单独的日历 OAuth 登录。如果访问已被拒绝，请在应用设置中允许访问。"
          }
        }
      }
    },
