    "legal.privacy.storage.keychainDetail" : {
      "comment" : "Full opt-in iCloud storage and device-local authorization boundaries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-Mail-OAuth-Tokens, IMAP-App-Passwörter und ChatGPT-Verbindungsdaten. Die Wiederherstellung auf anderen Geräten erfordert den iCloud-Schlüsselbund und denselben Apple Account."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Email OAuth tokens, IMAP app passwords and ChatGPT connection information. Cross-device restoration requires iCloud Keychain and the same Apple account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens OAuth de correo, contraseñas de aplicación IMAP y datos de conexión de ChatGPT. La restauración entre dispositivos requiere el Llavero de iCloud y la misma cuenta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetons OAuth des e-mails, mots de passe d’app IMAP et informations de connexion ChatGPT. La restauration entre appareils nécessite le trousseau iCloud et le même compte Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token OAuth delle email, password per app IMAP e informazioni di connessione ChatGPT. Il ripristino tra dispositivi richiede il Portachiavi iCloud e lo stesso account Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールのOAuthトークン、IMAPアプリ用パスワード、ChatGPT接続情報。デバイス間の復元にはiCloudキーチェーンと同じApple Accountが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일 OAuth 토큰·IMAP 앱 비밀번호·ChatGPT 연결 정보. 다른 기기에서 복원하려면 iCloud 키체인과 같은 Apple 계정이 필요합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邮件 OAuth 令牌、IMAP 应用专用密码和 ChatGPT 连接信息。跨设备恢复需要 iCloud 钥匙串和同一 Apple 账户。"
          }
        }
      }
    },
