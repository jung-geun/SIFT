    "ai.chatGPT.consent" : {
      "comment" : "Native settings and analysis copy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch nach dem Verbinden eines Kontos werden App-Daten nur mit Zustimmung für den jeweiligen Datenbereich gesendet. Erweiterte Modelle werden nur auf ausdrückliche erneute Anfrage verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecting an account does not send app data without consent for each data scope. Advanced models are used only when you explicitly request them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectar una cuenta no envía datos de la app sin tu consentimiento para cada categoría de datos. Los modelos avanzados solo se usan cuando los solicitas explícitamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion d’un compte n’envoie aucune donnée de l’app sans votre consentement pour chaque catégorie de données. Les modèles avancés ne sont utilisés que sur votre demande explicite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collegare un account non invia dati dell’app senza il tuo consenso per ciascuna categoria di dati. I modelli avanzati vengono usati solo su tua richiesta esplicita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを接続しても、データの種類ごとに送信に同意しない限り、アプリのデータは送信されません。高性能モデルは、明示的に再リクエストした場合のみ使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 연결해도 데이터별 전송 동의 없이는 앱 데이터를 보내지 않습니다. 고급 모델은 직접 재요청할 때만 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接账号后，未经各类数据的单独传输同意，不会发送应用数据。高级模型仅在您主动再次请求时使用。"
          }
        }
      }
    },
