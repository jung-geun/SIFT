    "legal.text.동의 후 기기 내 학습, 별도 동의·요청 시 OpenAI 서술": {
      "comment": "English legal translation preserving source meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device learning after consent; OpenAI prose only with separate consent and a request"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동의 후 기기 내 학습, 별도 동의·요청 시 OpenAI 서술"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendizaje en el dispositivo tras el consentimiento; explicación de OpenAI solo con consentimiento independiente y una solicitud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同意後にデバイス内で学習し、別途同意とリクエストがある場合にのみOpenAIが解説を生成"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经同意后在设备端学习；仅在单独同意并提出请求后才使用 OpenAI 生成文字说明"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprentissage sur l’appareil après consentement ; interprétation OpenAI uniquement avec un consentement distinct et une demande"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprendimento sul dispositivo previo consenso; testo OpenAI solo con consenso separato e su richiesta"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lernen auf dem Gerät nach Einwilligung; OpenAI-Erläuterungen nur mit separater Einwilligung und auf Anfrage"
          }
        }
      }
    },
    "legal.text.루틴 근거·추천 피드백": {
      "comment": "English legal translation preserving source meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine evidence and suggestion feedback"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴 근거·추천 피드백"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indicios de rutinas y comentarios sobre las sugerencias"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティンの根拠と提案へのフィードバック"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日常规律依据和建议反馈"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données justificatives des routines et retours sur les suggestions"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati di supporto delle routine e feedback sui suggerimenti"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Routinenbelege und Rückmeldungen zu Vorschlägen"
          }
        }
      }
    },
    "legal.text.루틴 기록은 원자적으로 저장한 보호된 로컬 파일이며, 외부 전송 동의는 기기별 기본 꺼짐입니다. OpenAI 인증 정보·요청·응답·원문을 진단 로그에 기록하지 않습니다.": {
      "comment": "English legal translation preserving source meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine records use a protected atomic local file. Remote-sharing consent is off by default on each device. OpenAI credentials, requests, responses, and original content are not recorded in diagnostic logs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴 기록은 원자적으로 저장한 보호된 로컬 파일이며, 외부 전송 동의는 기기별 기본 꺼짐입니다. OpenAI 인증 정보·요청·응답·원문을 진단 로그에 기록하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros de rutinas usan un archivo local protegido con guardado atómico. El consentimiento de envío remoto está desactivado por defecto en cada dispositivo. Las credenciales, las solicitudes, las respuestas y el contenido original de OpenAI no se registran en los registros de diagnóstico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティンの記録は保護されたローカルファイルにアトミックに保存されます。外部共有への同意は、各デバイスで初期状態ではオフです。OpenAIの認証情報、リクエスト、応答、原文は診断ログに記録されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日常规律记录以原子方式保存在受保护的本地文件中。每台设备的远程共享授权默认关闭。OpenAI 凭据、请求、响应和原始内容不会记录在诊断日志中。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de routine sont enregistrées de manière atomique dans un fichier local protégé. Le consentement au partage distant est désactivé par défaut sur chaque appareil. Les identifiants, demandes, réponses et contenus originaux OpenAI ne sont pas consignés dans les journaux de diagnostic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I record delle routine usano un file locale protetto con salvataggio atomico. Il consenso alla condivisione remota è disattivato per impostazione predefinita su ogni dispositivo. Credenziali OpenAI, richieste, risposte e contenuti originali non vengono registrati nei log diagnostici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Routinendatensätze werden atomar in einer geschützten lokalen Datei gespeichert. Die Einwilligung zur externen Weitergabe ist auf jedem Gerät standardmäßig ausgeschaltet. OpenAI-Zugangsdaten, Anfragen, Antworten und Originalinhalte werden nicht in Diagnoseprotokollen aufgezeichnet."
          }
        }
      }
    },
    "legal.text.루틴·근거·추천 피드백 삭제: 설정 → 루틴 학습·추천 → 모두 삭제 (이미 승인한 할 일은 별도 삭제)": {
      "comment": "English legal translation preserving source meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete routines, evidence, and feedback: Settings → Routines and suggestions → Delete all (accepted tasks are deleted separately)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴·근거·추천 피드백 삭제: 설정 → 루틴 학습·추천 → 모두 삭제 (이미 승인한 할 일은 별도 삭제)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar rutinas, indicios y comentarios: Ajustes → Rutinas y sugerencias → Eliminar todo (las tareas aceptadas se eliminan por separado)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティン・根拠・フィードバックの削除：設定 → ルーティンと提案 → すべて削除（受け入れ済みのタスクは別途削除）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除日常规律、依据和反馈：设置 → 日常规律与建议 → 全部删除（已接受的待办事项需单独删除）"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les routines, données justificatives et retours : Réglages → Routines et suggestions → Tout supprimer (les tâches acceptées sont à supprimer séparément)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina routine, dati di supporto e feedback: Impostazioni → Routine e suggerimenti → Elimina tutto (le attività accettate vanno eliminate separatamente)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Routinen, Belege und Rückmeldungen löschen: Einstellungen → Routinen und Vorschläge → Alle löschen (angenommene Aufgaben separat löschen)"
          }
        }
      }
    },
    "legal.text.메일 본문의 외부 분석은 별도 동의와 선택한 메일에 대한 직접 요청이 있어야 하며, 자동 수집·요약·할 일 정렬은 기기 내에서 처리합니다.": {
      "comment": "English legal translation preserving source meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote email-body analysis requires separate consent and an explicit request for a selected email. Automatic collection, summaries, and prioritization remain on device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메일 본문의 외부 분석은 별도 동의와 선택한 메일에 대한 직접 요청이 있어야 하며, 자동 수집·요약·할 일 정렬은 기기 내에서 처리합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis remoto del cuerpo del correo requiere consentimiento independiente y una solicitud explícita para un correo seleccionado. La recopilación, los resúmenes y la priorización automáticos permanecen en el dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メール本文の外部分析には、別途同意と、選択したメールに対する明示的なリクエストが必要です。自動収集、要約、優先順位付けは引き続きデバイス内で行われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程分析邮件正文需要单独同意，并针对所选邮件明确提出请求。自动收集、摘要生成和优先级排序均在设备端处理。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse distante du corps des e-mails nécessite un consentement distinct et une demande explicite pour un e-mail sélectionné. La collecte, les résumés et la priorisation automatiques restent sur l’appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi remota del corpo delle email richiede un consenso separato e una richiesta esplicita per un’email selezionata. Raccolta, riepiloghi e definizione delle priorità automatici restano sul dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die externe Analyse von E-Mail-Inhalten erfordert eine separate Einwilligung und eine ausdrückliche Anfrage für eine ausgewählte E-Mail. Automatisches Erfassen, Zusammenfassen und Priorisieren erfolgt weiterhin auf dem Gerät."
          }
        }
      }
    },
    "legal.text.메일 원문은 기기 내 별도 저장소에 보관하며 직접 동의·요청한 메일만 외부 분석합니다. 루틴 근거·피드백·OpenAI 토큰과 전송 동의는 기기 내 전용 기록이며 iCloud로 동기화하지 않습니다. 승인해 만든 할 일과 적용한 페르소나·행동 분석은 기존 iCloud 설정에 따릅니다. 외부 미리보기는 적용 전 원문·확정 일정을 변경하지 않습니다.": {
      "comment": "English legal translation preserving source meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email originals stay in a separate local store; only explicitly consented and requested emails are analyzed remotely. Routine evidence, feedback, OpenAI credentials, and sharing permissions are device-local and not synced with iCloud. Accepted tasks and applied persona/behavior records follow existing iCloud settings. Remote previews do not change originals or confirmed schedules before application."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메일 원문은 기기 내 별도 저장소에 보관하며 직접 동의·요청한 메일만 외부 분석합니다. 루틴 근거·피드백·OpenAI 토큰과 전송 동의는 기기 내 전용 기록이며 iCloud로 동기화하지 않습니다. 승인해 만든 할 일과 적용한 페르소나·행동 분석은 기존 iCloud 설정에 따릅니다. 외부 미리보기는 적용 전 원문·확정 일정을 변경하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los originales de los correos permanecen en un almacén local independiente; solo se analizan de forma remota los correos con consentimiento y solicitud explícitos. Los indicios de rutinas, los comentarios, las credenciales de OpenAI y los permisos de envío son locales en el dispositivo y no se sincronizan con iCloud. Las tareas aceptadas y los registros de perfil personal o comportamiento aplicados siguen los ajustes existentes de iCloud. Las vistas previas remotas no modifican originales ni horarios confirmados antes de aplicarlas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メール原文は独立したローカル保存領域に保持され、明示的に同意してリクエストしたメールのみが外部で分析されます。ルーティンの根拠、フィードバック、OpenAIの認証情報、共有許可はデバイス内にのみ保存され、iCloudとは同期されません。受け入れ済みのタスクと適用済みのペルソナ・行動の記録には、既存のiCloud設定が適用されます。外部分析のプレビューは、適用するまで原文や確定済みの予定を変更しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件原文保存在独立的本地存储中；只有明确同意并请求分析的邮件才会接受远程分析。日常规律依据、反馈、OpenAI 凭据和共享权限仅保存在本设备上，不与 iCloud 同步。已接受的待办事项以及已应用的个人画像和行为记录遵循现有的 iCloud 设置。远程预览在应用前不会更改原文或已确认的日程。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les originaux des e-mails restent dans un stockage local distinct ; seuls les e-mails faisant l’objet d’un consentement et d’une demande explicites sont analysés à distance. Les données justificatives des routines, les retours, les identifiants OpenAI et les autorisations de partage sont propres à l’appareil et ne sont pas synchronisés avec iCloud. Les tâches acceptées et les données de profil personnel ou de comportement appliquées suivent les réglages iCloud existants. Les aperçus distants ne modifient ni les originaux ni les créneaux confirmés avant leur application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli originali delle email restano in un archivio locale separato; vengono analizzate da remoto solo le email per cui hai dato esplicitamente il consenso e richiesto l’analisi. Dati di supporto delle routine, feedback, credenziali OpenAI e autorizzazioni alla condivisione sono locali al dispositivo e non vengono sincronizzati con iCloud. Le attività accettate e i record di persona e comportamento applicati seguono le impostazioni iCloud esistenti. Le anteprime remote non modificano gli originali o le pianificazioni confermate prima dell’applicazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail-Originale verbleiben in einem separaten lokalen Speicher; nur E-Mails mit ausdrücklicher Einwilligung und Anfrage werden extern analysiert. Routinenbelege, Rückmeldungen, OpenAI-Zugangsdaten und Freigabeberechtigungen bleiben auf dem Gerät und werden nicht mit iCloud synchronisiert. Angenommene Aufgaben und angewendete Persona-/Verhaltensdatensätze folgen den bestehenden iCloud-Einstellungen. Externe Vorschauen verändern vor ihrer Anwendung weder Originale noch bestätigte Zeitpläne."
          }
        }
      }
    },
    "legal.text.메일 조회·사용자가 실행한 읽음/휴지통 반영": {
