        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Firebase-Synchronisierung kann nicht gestartet werden, da das Google-ID-Token fehlt. Verbinde Gmail erneut."
          }
        }
      }
    },
    "error.foundationModels.availability.disabled": {
      "comment": "Generated service prose; interpolated values preserve source content.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models는 Apple Intelligence를 사용할 수 있고 활성화된 기기에서만 사용할 수 있습니다. 설정 > Apple Intelligence 및 Siri에서 활성화 상태를 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models require Apple Intelligence to be available and enabled on this device. Check Settings > Apple Intelligence & Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models requiere que Apple Intelligence esté disponible y activado en este dispositivo. Revisa Ajustes > Apple Intelligence y Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Modelsを使用するには、このデバイスでApple Intelligenceが利用可能で、有効になっている必要があります。「設定」>「Apple IntelligenceとSiri」を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models 需要此设备支持并已启用 Apple 智能。请检查“设置”>“Apple 智能与 Siri”。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models nécessite qu’Apple Intelligence soit disponible et activé sur cet appareil. Vérifiez Réglages > Apple Intelligence et Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models richiede che Apple Intelligence sia disponibile e abilitato su questo dispositivo. Controlla Impostazioni > Apple Intelligence e Siri."
          }
