    "beta.localModels.description" : {
      "comment" : "Explicit local LLM installation in Beta settings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Modell und tippe auf „Herunterladen“, um es ausdrücklich zu installieren. Die Auswahl lädt nichts herunter; die Analyse erfolgt auf dem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a model, then tap Download to install it explicitly. Choosing a model does not download it; analysis runs on device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un modelo y pulsa Descargar para instalarlo de forma explícita. Elegirlo no inicia la descarga; el análisis se realiza en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un modèle, puis touchez Télécharger pour l’installer explicitement. Le choix seul ne lance aucun téléchargement ; l’analyse reste sur l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un modello, poi tocca Scarica per installarlo esplicitamente. La scelta non avvia il download; l’analisi avviene sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルを選び、ダウンロードボタンを押して明示的にインストールしてください。選択だけではダウンロードされず、分析はデバイス上で行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치할 모델을 선택한 뒤 다운로드 버튼을 눌러 직접 설치하세요. 모델 선택만으로는 다운로드되지 않으며, 분석은 기기 안에서 처리합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择模型后，点按“下载”以明确安装。仅选择模型不会下载；分析在设备上进行。"
          }
        }
      }
    },
