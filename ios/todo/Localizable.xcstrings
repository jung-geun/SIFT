    "schedule.error.notificationDenied" : {
      "comment" : "Schedule approval error: notificationDenied.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind nicht erlaubt. Aktiviere die Berechtigung in den Systemeinstellungen oder deaktiviere die neue Erinnerung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notification permission is not allowed. Enable it in System Settings or turn off the new reminder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha permitido el envío de notificaciones. Actívalo en Ajustes del sistema o desactiva el nuevo recordatorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
