          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議内容が変更されたため、要約が保存されませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议内容已更改，因此未保存摘要。请重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réunion a changé ; le résumé n’a donc pas été enregistré. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riunione è cambiata, quindi il riepilogo non è stato salvato. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Besprechung wurde geändert. Die Zusammenfassung wurde daher nicht gespeichert. Versuche es erneut."
          }
        }
      }
    },
    "meeting.error.cleanupRecovery": {
      "comment": "Capture recovery cleanup failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery marker could not be cleared. It will be checked again next time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 복구 표시를 정리하지 못했습니다. 다음 실행에서 다시 확인합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo borrar el marcador de recuperación. Se volverá a comprobar la próxima vez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元マーカーをクリアできませんでした。次回起動時に再確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法清除恢复标记。下次将再次检查。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le marqueur de récupération n’a pas pu être supprimé. Il sera vérifié à nouveau au prochain lancement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rimuovere l'indicatore di recupero. Verrà controllato di nuovo al prossimo avvio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellungsmarkierung konnte nicht entfernt werden. Sie wird beim nächsten Mal erneut geprüft."
          }
        }
      }
    },
    "meeting.error.editDuringProcessing": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript cannot be edited while the meeting is being reprocessed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의를 다시 처리하는 동안에는 전사를 편집할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede editar la transcripción mientras se vuelve a procesar la reunión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の再処理中は文字起こしを編集できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新处理会议期间无法编辑转写文本。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription ne peut pas être modifiée pendant le retraitement de la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione non può essere modificata durante la rielaborazione della riunione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Transkript kann nicht bearbeitet werden, während die Besprechung erneut verarbeitet wird."
          }
        }
      }
    },
    "meeting.error.engineUnavailable": {
