    "settings.sync.full.confirm.message" : {
      "comment" : "Full iCloud storage scope, consent and real transport status.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dabei werden E-Mail-Inhalte, Besprechungsaufnahmen und Transkripte, Routinen, Wortschatz, Einstellungen und Kontoverbindungen unter deinem Apple Account gespeichert. Gesundheitsdaten, Betriebssystemberechtigungen und herunterladbare Modelldateien sind ausgeschlossen. Dies erlaubt nicht, Inhalte an ChatGPT zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This includes email bodies, meeting recordings and transcripts, routines, vocabulary, settings and account connections under your Apple account. Health data, OS grants and downloadable model files are excluded. This does not authorize sending content to ChatGPT."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardarán los cuerpos de los correos, las grabaciones y transcripciones de reuniones, las rutinas, el vocabulario, los ajustes y las conexiones de cuentas en tu cuenta de Apple. Se excluyen los datos de salud, los permisos del sistema y los archivos de modelos descargables. Esto no autoriza el envío de contenido a ChatGPT."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela inclut le corps des e-mails, les enregistrements et transcriptions de réunions, les routines, le vocabulaire, les réglages et les connexions aux comptes, sous votre compte Apple. Les données de santé, les autorisations du système et les fichiers de modèles téléchargeables sont exclus. Cela n’autorise pas l’envoi de contenu à ChatGPT."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include il corpo delle email, le registrazioni e trascrizioni delle riunioni, le routine, il vocabolario, le impostazioni e le connessioni agli account, associati al tuo account Apple. Sono esclusi i dati sanitari, le autorizzazioni del sistema e i file dei modelli scaricabili. Questo non autorizza l’invio di contenuti a ChatGPT."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メール本文、会議の録音・文字起こし、ルーティン、語彙、設定、アカウント接続情報を同じApple Accountに保存します。健康データ、OSの権限、ダウンロード可能なモデルファイルは対象外です。これはChatGPTへのコンテンツ送信を許可するものではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 Apple 계정에 메일 본문·회의 녹음/전사·루틴·학습 사전·설정·연결 정보를 저장합니다. 건강정보·OS 권한·재다운로드 가능한 모델 파일은 제외하며, ChatGPT로 내용을 전송하는 동의와는 별개입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会将邮件正文、会议录音与转写、例程、词汇、设置和账户连接信息存储在你的 Apple 账户下。健康数据、操作系统权限和可下载的模型文件不包含在内。这并不代表授权向 ChatGPT 发送内容。"
          }
        }
      }
    },
    "settings.sync.full.confirm.title" : {
      "comment" : "Full iCloud storage scope, consent and real transport status.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle dafür vorgesehenen App-Daten in iCloud speichern?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Store all eligible app data in iCloud?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Guardar todos los datos de la app que se pueden sincronizar en iCloud?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocker toutes les données de l’app pouvant être synchronisées dans iCloud ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiviare in iCloud tutti i dati dell’app idonei?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象となるすべてのアプリデータをiCloudに保存しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 데이터 전체를 iCloud에 저장할까요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要将所有符合条件的应用数据存储到 iCloud 吗？"
          }
        }
      }
    },
    "settings.sync.full.device.health" : {
      "comment" : "Full iCloud storage scope, consent and real transport status.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persönliche Gesundheitsinformationen sind gemäß Apples Vorgaben ausgeschlossen. Gesundheitsdaten werden auf jedem Gerät gelesen und Betriebssystemberechtigungen dort erteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal health information is excluded under Apple's rules. Health data and OS permissions are read or authorized on each device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La información personal de salud se excluye según las normas de Apple. Los datos de salud se leen y los permisos del sistema se conceden en cada dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les informations personnelles de santé sont exclues conformément aux règles d’Apple. Les données de santé sont lues et les autorisations du système accordées sur chaque appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le informazioni sanitarie personali sono escluse in base alle regole di Apple. I dati sanitari vengono letti e le autorizzazioni del sistema concesse su ciascun dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleの規定により、個人の健康情報は対象外です。健康データの読み取りやOSの権限の許可は各デバイスで行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 정책에 따라 개인 건강정보는 제외합니다. 건강 데이터와 OS 권한은 각 기기에서 읽거나 승인합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据 Apple 的规定，个人健康信息不包含在内。健康数据需在各设备上读取，操作系统权限也需在各设备上授权。"
          }
        }
      }
    },
    "settings.sync.full.device.models" : {
      "comment" : "Full iCloud storage scope, consent and real transport status.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelldateien werden nicht hochgeladen. Laya, das lokale LLM und die Sprachmodelle müssen auf jedem Gerät heruntergeladen und überprüft werden, bevor sie ausgewählt werden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model files are not uploaded. Laya, the local LLM and speech models must be downloaded and verified on each device before they can be selected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos de modelos no se suben. Laya, el LLM local y los modelos de voz deben descargarse y verificarse en cada dispositivo antes de poder seleccionarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers des modèles ne sont pas téléversés. Laya, le LLM local et les modèles vocaux doivent être téléchargés et vérifiés sur chaque appareil avant de pouvoir être sélectionnés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file dei modelli non vengono caricati. Laya, il LLM locale e i modelli vocali devono essere scaricati e verificati su ciascun dispositivo prima di poterli selezionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルファイルはアップロードされません。Laya、ローカルLLM、音声モデルは、各デバイスでダウンロードと検証を完了してから選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델 설치파일은 업로드하지 않습니다. Laya·로컬 LLM·음성 모델은 각 기기에서 다운로드와 검증을 마쳐야 선택할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型文件不会上传。Laya、本地 LLM 和语音模型必须在各设备上完成下载和验证后才能选择。"
          }
        }
      }
    },
    "settings.sync.full.device.permissions" : {
      "comment" : "Full iCloud storage scope, consent and real transport status.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Berechtigungsverläufe gewähren keinen Zugriff auf einem neuen Gerät. Bestätige die Weitergabe an externe KI, den E-Mail-Zugriff im Hintergrund und gerätespezifische Kalenderauswahlen auf dem jeweiligen Gerät. Wiederhergestellte Verläufe ausstehender Aktionen führen E-Mail-Aktionen nicht automatisch erneut aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved permission history does not grant access on a new device. Confirm external-AI sharing, background mail and device-specific calendar choices locally; restored outbox history does not automatically replay mail actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial de permisos guardado no concede acceso en un dispositivo nuevo. Confirma en cada dispositivo el envío a IA externa, el acceso al correo en segundo plano y los calendarios elegidos para ese dispositivo; restaurar el historial de acciones pendientes no vuelve a ejecutar automáticamente acciones de correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique des autorisations enregistré n’accorde aucun accès sur un nouvel appareil. Confirmez localement le partage avec une IA externe, l’accès aux e-mails en arrière-plan et le choix des calendriers propres à l’appareil. La restauration de l’historique des actions en attente ne réexécute pas automatiquement les actions sur les e-mails."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia dei permessi salvata non concede l’accesso su un nuovo dispositivo. Conferma localmente la condivisione con IA esterne, l’accesso alle email in background e i calendari scelti per il dispositivo; ripristinare la cronologia delle azioni in coda non riesegue automaticamente le azioni sulle email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された権限の履歴だけでは、新しいデバイスでのアクセスは許可されません。外部AIへの送信、バックグラウンドでのメールアクセス、デバイス固有のカレンダーの選択は、そのデバイスで確認してください。復元された保留中の操作履歴によってメール操作が自動的に再実行されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 권한 내역만으로 새 기기에 권한을 부여하지 않습니다. 외부 AI 전송·메일 백그라운드 접근·기기별 캘린더 선택은 해당 기기에서 확인하며, 복원된 대기 작업 내역으로 메일 작업을 자동 재실행하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的权限历史不会授予新设备访问权限。请在各设备上确认向外部 AI 共享内容、后台邮件访问和设备专属日历选择；恢复的待处理操作历史不会自动重新执行邮件操作。"
          }
        }
      }
    },
    "settings.sync.full.device.title" : {
      "comment" : "Full iCloud storage scope, consent and real transport status.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt gerätespezifisch"
          }
        },
        "en" : {
