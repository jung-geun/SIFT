    "mail.invitation.acceptKeyPoint" : {
      "comment" : "Generated service prose; interpolated values preserve source content.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du die Einladung annimmst, kannst du am Kalender teilnehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accepting the invitation lets you participate in the calendar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceptar la invitación te permite participar en el calendario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accepter l’invitation vous permet de participer au calendrier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accettando l’invito puoi partecipare al calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "招待を承認すると、カレンダーに参加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 초대를 수락하면 캘린더에 참여할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接受邀请后，你即可参与该日历。"
          }
        }
      }
    },
    "mail.invitation.acceptSummary" : {
      "comment" : "Generated service prose; interpolated values preserve source content.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wurdest zur gemeinsamen Nutzung des Kalenders %@ eingeladen. Nimm die Einladung an, um teilzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You were invited to share the %@ calendar. Accept the invitation to participate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te han invitado a compartir el calendario %@. Acepta la invitación para participar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez reçu une invitation à partager le calendrier %@. Acceptez-la pour y participer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai ricevuto un invito a condividere il calendario %@. Accetta l’invito per partecipare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダー「%@」の共有に招待されました。参加するには招待を承認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 캘린더 공유 초대입니다. 참여하려면 초대를 수락하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人邀请你共享 %@ 日历。接受邀请即可参与。"
          }
        }
      }
    },
