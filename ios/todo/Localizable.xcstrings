    "meeting.diarization.summary" : {
      "comment" : "Native settings and analysis copy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterscheidet Sprecher auf dem Gerät. Deaktivieren überspringt die Modellverarbeitung und spart Akku. Das ca. 218 MB große Modellpaket muss manuell installiert werden. Änderungen gelten ab der nächsten Aufnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separates speakers on device. Turn off to skip model processing and reduce battery use. Install the ~218 MB model pack manually; changes apply to the next recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue a los hablantes en el dispositivo. Desactívalo para omitir el procesamiento del modelo y reducir el consumo de batería. Instala manualmente el paquete de modelos de unos 218 MB; los cambios se aplican a la próxima grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue les locuteurs sur l’appareil. Désactivez cette option pour éviter le traitement par le modèle et réduire la consommation de batterie. Installez manuellement le pack de modèles d’environ 218 MB ; les changements s’appliquent au prochain enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue i parlanti sul dispositivo. Disattiva l’opzione per saltare l’elaborazione del modello e ridurre il consumo di batteria. Installa manualmente il pacchetto di modelli da circa 218 MB; le modifiche si applicano alla prossima registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス内で話者を識別します。オフにするとモデル処理を省略し、バッテリー消費を抑えます。約218 MBのモデルパックは手動でインストールしてください。変更は次の録音から適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기에서 화자를 구분합니다. 끄면 모델 처리를 생략해 배터리 사용을 줄입니다. 약 218 MB 모델 팩은 직접 설치해야 하며, 변경은 다음 녹음부터 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设备上区分说话人。关闭可跳过模型处理，减少耗电。约 218 MB 的模型包需手动安装；更改从下次录音起生效。"
          }
        }
      }
    },
    "meeting.diarization.thermal" : {
      "comment" : "Live speaker detection paused because the device is hot; recording continues.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät ist heiß. Die Live-Sprechererkennung wurde daher pausiert. Die Aufnahme läuft weiter. Nach dem Aufnahmeende werden die Sprecher im gespeicherten Audio analysiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device is hot, so live speaker detection is paused. Recording continues; speakers are analyzed from saved audio after stopping."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo está caliente, por lo que la detección de interlocutores en directo está en pausa. La grabación continúa; los interlocutores se analizarán a partir del audio guardado cuando termine la grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil chauffe : la détection des intervenants en direct est en pause. L’enregistrement continue ; les intervenants seront analysés à partir de l’audio sauvegardé après l’arrêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo è caldo, quindi il rilevamento degli interlocutori in tempo reale è in pausa. La registrazione continua; gli interlocutori verranno analizzati dall'audio salvato al termine della registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスの温度が高いため、リアルタイム話者検出を一時停止しました。録音は継続され、停止後に保存された音声から話者が分析されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 온도가 높아 실시간 화자 감지를 멈췄습니다. 녹음은 계속되며 녹음 종료 후 저장된 음성으로 화자를 분석합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备温度过高，已暂停实时说话人检测。录音将继续；录音停止后会从已保存的音频中分析说话人。"
          }
        }
      }
    },
