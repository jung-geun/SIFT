    "legal.text.iCloud 데이터는 Apple의 전송 중·저장 시 암호화 인프라 이용": {
      "comment": "English legal translation preserving the Korean source structure and meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud data uses Apple encryption infrastructure in transit and at rest"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 데이터는 Apple의 전송 중·저장 시 암호화 인프라 이용"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de iCloud utilizan la infraestructura de cifrado de Apple durante la transmisión y el almacenamiento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudデータには、転送時と保存時にAppleの暗号化基盤を利用します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 数据在传输和存储时使用 Apple 的加密基础设施"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données iCloud utilisent l’infrastructure de chiffrement d’Apple en transit et au repos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati iCloud usano l'infrastruttura di crittografia Apple durante il trasferimento e l'archiviazione"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Daten nutzen Apples Verschlüsselungsinfrastruktur bei der Übertragung und Speicherung"
          }
        }
      }
    },
    "legal.text.iCloud 동기화 충돌·지연은 Apple 인프라에 의존하므로 운영자가 보장할 수 없습니다.": {
      "comment": "English legal translation preserving the Korean source structure and meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operator cannot guarantee iCloud sync conflict resolution or timing because it depends on Apple infrastructure."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화 충돌·지연은 Apple 인프라에 의존하므로 운영자가 보장할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El operador no puede garantizar la resolución de conflictos ni los plazos de sincronización con iCloud, ya que dependen de la infraestructura de Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud同期の競合解決やタイミングはAppleの基盤に依存するため、運営者は保証できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步的冲突解决和时效取决于 Apple 基础设施，因此运营者无法作出保证。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’exploitant ne peut garantir ni la résolution des conflits ni les délais de synchronisation iCloud, qui dépendent de l’infrastructure d’Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gestore non può garantire la risoluzione dei conflitti o i tempi di sincronizzazione iCloud, poiché dipendono dall'infrastruttura Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betreiber kann die Lösung von Synchronisierungskonflikten oder den Zeitpunkt der iCloud-Synchronisierung nicht garantieren, da diese von Apples Infrastruktur abhängen."
          }
        }
      }
    },
    "legal.text.iCloud 동기화 해제: 설정 → iCloud 동기화 → 비활성화": {
      "comment": "English legal translation preserving the Korean source structure and meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable iCloud sync: Settings → iCloud Sync → Disable"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화 해제: 설정 → iCloud 동기화 → 비활성화"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar la sincronización con iCloud: Ajustes → Sincronización con iCloud → Desactivar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud同期を無効にする：設定 → iCloud同期 → 無効にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停用 iCloud 同步：设置 → iCloud 同步 → 停用"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
