    "meeting.appAudio.error.audioStopped": {
      "comment": "App audio output stopped while its system sharing session remains open.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 오디오가 중단되었습니다. 껐다가 다시 켜서 시도하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App audio stopped; turn it off and on to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio de la app se ha detenido; desactívalo y vuelve a activarlo para intentarlo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ音声が停止しました。一度オフにしてから再度オンにしてお試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用音频已停止；请将其关闭后重新开启以重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio d’app s’est arrêté ; désactivez-le puis réactivez-le pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio dell’app si è interrotto; disattivalo e riattivalo per riprovare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Audio wurde gestoppt; schalte es für einen erneuten Versuch aus und wieder ein."
          }
        }
      }
    },
    "meeting.appAudio.error.captureStopped": {
      "comment": "System audio stream stopped unexpectedly.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 오디오 캡처가 중지되었습니다. 계속하려면 새 소스를 선택하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System audio capture stopped. Select a new source to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura de audio del sistema se ha detenido. Selecciona una nueva fuente para continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム音声のキャプチャが停止しました。続けるには、新しいソースを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统音频采集已停止。请选择新来源以继续。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture audio système s’est arrêtée. Sélectionnez une nouvelle source pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisizione dell’audio di sistema si è interrotta. Seleziona una nuova sorgente per continuare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemaudioaufnahme wurde gestoppt. Wähle eine neue Quelle aus, um fortzufahren."
          }
        }
      }
    },
    "meeting.appAudio.error.consentRequired": {
      "comment": "App audio source selection requires confirmation of recording consent.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 오디오를 선택하기 전에 녹음 동의를 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm consent before selecting app audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma el consentimiento para la grabación antes de seleccionar el audio de la app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ音声を選択する前に、録音への同意を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择应用音频之前，请确认已获得录音同意。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez le consentement avant de sélectionner l’audio d’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma il consenso prima di selezionare l’audio dell’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige die Einwilligung, bevor du App-Audio auswählst."
          }
        }
      }
    },
    "meeting.appAudio.error.contentChanged": {
      "comment": "System sharing changed the selected content; original source identity cannot be reused.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 콘텐츠가 변경되었습니다. 계속하려면 새 소스를 추가하거나 선택하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected content changed. Add or select a new source to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido seleccionado ha cambiado. Añade o selecciona una nueva fuente para continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したコンテンツが変更されました。続けるには、新しいソースを追加するか選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选内容已更改。请添加或选择新来源以继续。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu sélectionné a changé. Ajoutez ou sélectionnez une nouvelle source pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto selezionato è cambiato. Aggiungi o seleziona una nuova sorgente per continuare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Inhalte haben sich geändert. Füge eine neue Quelle hinzu oder wähle sie aus, um fortzufahren."
          }
        }
      }
    },
    "meeting.appAudio.error.decodeFailed": {
      "comment": "App audio stream could not be decoded or aligned to the host clock.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 오디오를 디코딩하거나 동기화할 수 없습니다. 소스를 다시 선택하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App audio could not be decoded or synchronized. Select the source again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo decodificar o sincronizar el audio de la app. Vuelve a seleccionar la fuente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ音声をデコードまたは同期できませんでした。ソースをもう一度選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解码或同步应用音频。请重新选择来源。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio d’app n’a pas pu être décodé ou synchronisé. Sélectionnez à nouveau la source."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile decodificare o sincronizzare l’audio dell’app. Seleziona di nuovo la sorgente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Audio konnte nicht decodiert oder synchronisiert werden. Wähle die Quelle erneut aus."
          }
        }
      }
    },
    "meeting.appAudio.error.microphoneStopped": {
      "comment": "System-picker microphone stream stopped while app audio remains independently controlled.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 캡처가 중지되었습니다. 시스템 선택기를 사용하여 다시 켜주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone capture stopped. Enable it again using the system picker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura del micrófono se ha detenido. Vuelve a activarla mediante el selector del sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクのキャプチャが停止しました。システムの選択画面で再度有効にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风采集已停止。请使用系统选择器重新启用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture du microphone s’est arrêtée. Réactivez-la avec le sélecteur système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisizione dal microfono si è interrotta. Riattivala con il selettore di sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mikrofonaufnahme wurde gestoppt. Aktiviere sie über die Systemauswahl erneut."
          }
        }
      }
    },
    "meeting.appAudio.error.newSourceRequired": {
      "comment": "Each audio track has immutable source identity; reselecting requires a new source.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 콘텐츠를 선택하려면 새 소스를 추가하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a new source to select different content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una nueva fuente para seleccionar otro contenido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のコンテンツを選択するには、新しいソースを追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要选择其他内容，请添加新来源。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une nouvelle source pour sélectionner un autre contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una nuova sorgente per selezionare contenuti diversi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine neue Quelle hinzu, um andere Inhalte auszuwählen."
          }
        }
      }
    },
    "meeting.appAudio.error.osVersion": {
      "comment": "App audio capture operating-system requirement; preserve platform names and version.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 오디오 캡처에는 iOS 27 또는 지원되는 Mac Catalyst가 필요합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App audio capture requires iOS 27 or supported Mac Catalyst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura de audio de apps requiere iOS 27 o una versión compatible de Mac Catalyst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ音声のキャプチャには、iOS 27または対応するMac Catalystが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用音频采集需要 iOS 27 或受支持的 Mac Catalyst。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture de l’audio d’app nécessite iOS 27 ou une version compatible de Mac Catalyst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisizione dell’audio delle app richiede iOS 27 o Mac Catalyst supportato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Audioaufnahme erfordert iOS 27 oder unterstütztes Mac Catalyst."
          }
        }
      }
    },
    "meeting.appAudio.error.physicalDevice": {
      "comment": "App audio capture is unavailable in the simulator.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 오디오 캡처에는 지원되는 실제 기기가 필요합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App audio capture requires a supported physical device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura de audio de apps requiere un dispositivo físico compatible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ音声のキャプチャには、対応する実機が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用音频采集需要受支持的实体设备。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture de l’audio d’app nécessite un appareil physique compatible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisizione dell’audio delle app richiede un dispositivo fisico supportato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Audioaufnahme erfordert ein unterstütztes physisches Gerät."
          }
        }
      }
