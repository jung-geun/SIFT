    "permissions.notifications.purpose": {
      "comment": "Purpose of optional notification authorization.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive reminders for your to-do deadlines. Recording works without notifications."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일의 마감 알림을 받습니다. 알림 없이도 녹음할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe recordatorios de los plazos de tus tareas. La grabación funciona sin notificaciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクの期限リマインダーを受け取ります。通知を許可しなくても録音機能は動作します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收待办事项的截止提醒。不启用通知也可以录音。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevoir des rappels pour les échéances de vos tâches. L’enregistrement fonctionne sans notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi promemoria per le scadenze delle tue attività. La registrazione funziona anche senza notifiche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte Erinnerungen an deine Aufgabenfristen. Aufnahmen funktionieren auch ohne Mitteilungen."
          }
