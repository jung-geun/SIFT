          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "規約の変更"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条款变更"
          }
        },
        "fr": {
          "stringUnit": {
