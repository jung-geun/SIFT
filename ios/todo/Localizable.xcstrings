            "state": "translated",
            "value": "La frase de contraseña de cifrado debe tener al menos 8 caracteres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化パスフレーズは8文字以上である必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密口令必须至少包含 8 个字符。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phrase secrète de chiffrement doit contenir au moins 8 caractères."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La passphrase di crittografia deve contenere almeno 8 caratteri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
