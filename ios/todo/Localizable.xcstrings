          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试删除旧密钥信息"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer de supprimer l’ancien secret"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova a rimuovere il vecchio segreto"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte geheime Zugangsdaten erneut entfernen"
          }
        }
      }
    },
    "openai.connection.status.deletionRevocationUnconfirmed": {
      "comment": "ChatGPT data deletion status when local data was cleared but remote revocation is unconfirmed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local ChatGPT data was cleared. Remote revocation was not confirmed. Disconnect SIFT in ChatGPT Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 ChatGPT 데이터가 삭제되었습니다. 원격 접근 권한 해제가 확인되지 않았습니다. ChatGPT 설정에서 SIFT 연결을 해제해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borraron los datos locales de ChatGPT. No se confirmó la revocación remota. Desconecta SIFT en los ajustes de ChatGPT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのChatGPTデータを消去しました。リモートでの権限取り消しは確認できませんでした。ChatGPTの設定でSIFTの接続を解除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 ChatGPT 数据已清除。无法确认远程访问权限是否已撤销。请在 ChatGPT 设置中断开 SIFT 连接。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données ChatGPT locales ont été effacées. La révocation distante n’a pas été confirmée. Déconnectez SIFT dans les paramètres de ChatGPT."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati ChatGPT locali sono stati cancellati. La revoca remota non è stata confermata. Disconnetti SIFT nelle impostazioni di ChatGPT."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale ChatGPT-Daten wurden gelöscht. Der externe Widerruf wurde nicht bestätigt. Trenne SIFT in den ChatGPT-Einstellungen."
          }
        }
      }
    },
    "openai.connection.status.signOutCleanupAndRevocationUnconfirmed": {
      "comment": "ChatGPT sign-out status when both secure cleanup and remote revocation are unconfirmed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed out locally. Secure credential cleanup could not be confirmed. Remote revocation was not confirmed. Disconnect SIFT in ChatGPT Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 로그아웃했습니다. 인증 정보가 안전하게 삭제되었는지 확인할 수 없습니다. 원격 접근 권한 해제가 확인되지 않았습니다. ChatGPT 설정에서 SIFT 연결을 해제해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerró la sesión localmente. No se pudo confirmar la eliminación segura de las credenciales. No se confirmó la revocación remota. Desconecta SIFT en los ajustes de ChatGPT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでサインアウトしました。認証情報が安全に削除されたか確認できませんでした。リモートでの権限取り消しも確認できませんでした。ChatGPTの設定でSIFTの接続を解除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在本地退出登录。无法确认凭据是否已安全清除，也无法确认远程访问权限是否已撤销。请在 ChatGPT 设置中断开 SIFT 连接。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnexion locale effectuée. La suppression sécurisée des identifiants n’a pas pu être confirmée. La révocation distante n’a pas été confirmée. Déconnectez SIFT dans les paramètres de ChatGPT."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnessione locale completata. Impossibile confermare la rimozione sicura delle credenziali. La revoca remota non è stata confermata. Disconnetti SIFT nelle impostazioni di ChatGPT."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal abgemeldet. Das sichere Löschen der Zugangsdaten konnte nicht bestätigt werden. Der externe Widerruf wurde nicht bestätigt. Trenne SIFT in den ChatGPT-Einstellungen."
          }
        }
      }
    },
