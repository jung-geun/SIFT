          }
        }
      }
    },
    "tutorial.todoSettings.notifications.reviewPermission.body" : {
      "comment" : "Tutorial navigation through Settings > To-Dos; notification permission is optional.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Benachrichtigungen, wenn du an Fälligkeiten erinnert werden möchtest. Sie sind optional: Du kannst auch ohne Erlaubnis zurückgehen und das Tutorial fortsetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow notifications if you want due-date reminders. Notifications are optional; you can go back and continue the tutorial without allowing them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite las notificaciones si quieres recibir recordatorios de vencimiento. Son opcionales; puedes volver y continuar el tutorial sin permitirlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez les notifications si vous souhaitez recevoir des rappels d’échéance. Elles sont facultatives : vous pouvez revenir en arrière et poursuivre le tutoriel sans les autoriser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti le notifiche se desideri ricevere promemoria delle scadenze. Sono facoltative: puoi tornare indietro e continuare il tutorial senza consentirle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期限のリマインダーが必要な場合は通知を許可してください。通知は任意です。許可しなくても、前に戻ってチュートリアルを続けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요하면 알림 권한을 허용해 마감 알림을 받으세요. 알림은 선택이며, 허용하지 않아도 뒤로 돌아가 튜토리얼을 계속할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需到期提醒，请允许通知。通知是可选的；即使不允许，也可以返回并继续教程。"
          }
        }
      }
    },
