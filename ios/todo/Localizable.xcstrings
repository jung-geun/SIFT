    "meeting.help.autoRefine.message": {
      "comment": "Automatic transcript proofreading help message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After recording and retranscription, on-device AI (Apple Intelligence) automatically corrects recognition errors and typos to improve summary quality. Turn it off to summarize the original transcript."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 완료·재전사 후 온디바이스 AI(Apple Intelligence)로 전사의 오인식·오탈자를 자동 교정해 요약 품질을 높입니다. 끄면 원문을 그대로 요약합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de grabar y volver a transcribir, la IA del dispositivo (Apple Intelligence) corrige automáticamente los errores de reconocimiento y tipográficos para mejorar la calidad del resumen. Desactiva esta opción para resumir la transcripción original."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音完了後および再文字起こし後に、オンデバイスAI（Apple Intelligence）が文字起こしの認識ミスや誤字を自動校正して要約の品質を向上させます。オフにすると、元の文字起こしのまま要約します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音和重新转写完成后，设备端 AI（Apple Intelligence）会自动纠正识别错误和错别字，以提升摘要质量。关闭后将直接对原始转写文本生成摘要。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’enregistrement et une nouvelle transcription, l’IA sur l’appareil (Apple Intelligence) corrige automatiquement les erreurs de reconnaissance et les fautes de frappe pour améliorer la qualité du résumé. Désactivez cette option pour résumer la transcription originale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo la registrazione e la nuova trascrizione, l'IA sul dispositivo (Apple Intelligence) corregge automaticamente gli errori di riconoscimento e i refusi per migliorare la qualità del riepilogo. Disattivala per riepilogare la trascrizione originale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Aufnahme und der erneuten Transkription korrigiert die KI auf dem Gerät (Apple Intelligence) automatisch Erkennungs- und Tippfehler, um die Qualität der Zusammenfassung zu verbessern. Deaktiviere diese Option, um das Originaltranskript zusammenzufassen."
          }
        }
      }
    },
    "meeting.help.autoRefine.title": {
      "comment": "Automatic transcript proofreading help title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
