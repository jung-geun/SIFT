    "legal.terms.ownership.userData" : {
      "comment" : "User-entered content ownership is unchanged by open-source licensing.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Benutzer eingegebene Daten, etwa Aufgaben und Notizen, gehören dem Benutzer und werden vom Betreiber nicht für Marketing oder Training verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data entered by users, such as to-dos and notes, belongs to the user and is not used by the operator for marketing or training."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos introducidos por los usuarios, como tareas y notas, pertenecen al usuario y el operador no los utiliza con fines de marketing ni de entrenamiento."
          }
        },
