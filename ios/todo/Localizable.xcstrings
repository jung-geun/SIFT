    "diagnostics.mail.unavailable": {
      "comment": "Diagnostic report mail fallback.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail can’t be sent from this device, so the report opens in the share sheet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 메일을 보낼 수 없어 공유 시트로 보고서를 내보냅니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede enviar correo desde este dispositivo, por lo que el informe se abre en la hoja para compartir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスからメールを送信できないため、レポートを共有シートで開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备无法发送邮件，因此报告将通过共享面板打开。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas envoyer d’e-mail. Le rapport s’ouvre donc dans la feuille de partage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile inviare email da questo dispositivo, quindi il rapporto si apre nel pannello di condivisione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von diesem Gerät können keine E-Mails gesendet werden. Der Bericht wird daher im Teilen-Menü geöffnet."
          }
        }
      }
    },
    "diagnostics.metricKit.detail": {
      "comment": "MetricKit diagnostic delivery limitation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple system diagnostics can later report crashes, hangs, and memory terminations. Delivery isn’t immediate in every case, and not every forced termination is captured."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 시스템 진단은 충돌, 멈춤, 메모리 종료 등을 나중에 전달할 수 있습니다. 즉시 전달되거나 모든 강제 종료가 포착되는 것은 아닙니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diagnósticos del sistema de Apple pueden informar más adelante de cierres inesperados, bloqueos y terminaciones por memoria. No siempre se entregan de inmediato y no se detectan todas las terminaciones forzadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleのシステム診断では、クラッシュ、フリーズ、メモリ不足による終了が後から報告される場合があります。常にすぐに届くわけではなく、すべての強制終了が記録されるわけでもありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 系统诊断可能会在稍后报告崩溃、卡死和内存不足导致的终止。并非所有情况都会立即送达，也无法捕获每次强制终止。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les diagnostics système d’Apple peuvent signaler ultérieurement les plantages, les blocages et les arrêts dus à la mémoire. Leur transmission n’est pas toujours immédiate et tous les arrêts forcés ne sont pas détectés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La diagnostica di sistema Apple può segnalare in seguito arresti anomali, blocchi e chiusure per memoria insufficiente. L’invio non è sempre immediato e non tutte le chiusure forzate vengono rilevate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-Systemdiagnosen können Abstürze, Hänger und speicherbedingte Beendigungen später melden. Die Übermittlung erfolgt nicht immer sofort, und nicht jede erzwungene Beendigung wird erfasst."
          }
        }
      }
    },
    "diagnostics.preparing": {
      "comment": "Diagnostic report preparation progress.",
      "extractionState": "manual",
