    "beta.localFallback.description" : {
      "comment" : "Native settings and analysis copy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur auf Geräten ohne Apple Intelligence optional verfügbar. Modelle müssen manuell installiert werden; Aktivieren oder Auswählen startet keinen Download. Die Verarbeitung erfolgt auf dem Gerät und kann mehr Akku verbrauchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional only on devices without Apple Intelligence support. Install a model manually; enabling or selecting one downloads nothing. Processing stays on device and may use more battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se puede elegir en dispositivos no compatibles con Apple Intelligence. Instala un modelo manualmente; activarlo o seleccionarlo no descarga nada. El procesamiento se realiza en el dispositivo y puede consumir más batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Option réservée aux appareils ne prenant pas en charge Apple Intelligence. Installez un modèle manuellement ; l’activer ou le sélectionner ne télécharge rien. Le traitement reste sur l’appareil et peut consommer davantage de batterie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opzione disponibile solo sui dispositivi che non supportano Apple Intelligence. Installa un modello manualmente: attivarlo o selezionarlo non scarica nulla. L’elaborazione avviene sul dispositivo e può consumare più batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence非対応のデバイスでのみ選択できます。モデルは手動でインストールしてください。有効にしたり選択したりするだけではダウンロードされません。処理はデバイス内で行われ、バッテリー消費が増える場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 미지원 기기에서만 선택할 수 있습니다. 모델은 직접 설치해야 하며 켜거나 선택하는 것만으로 다운로드되지 않습니다. 기기에서 처리하며 배터리 사용이 늘 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅不支持 Apple Intelligence 的设备可选择使用。模型需手动安装；仅启用或选择模型不会下载任何内容。处理在设备上进行，可能增加耗电。"
          }
        }
      }
    },
