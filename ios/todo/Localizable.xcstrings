    "health.reader.unavailable.medication" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Medikamentenverlauf erfordert iOS oder Mac Catalyst 26.0 oder neuer: Frühere Systeme stellen keine HealthKit-Ereignisse zu Medikamenteneinnahmen und keine Abfragen erfasster Medikamente bereit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medication history requires iOS or Mac Catalyst 26.0 or later: earlier systems do not expose HealthKit medication dose events and tracked-medication queries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial de medicamentos requiere iOS o Mac Catalyst 26.0 o posterior: los sistemas anteriores no ofrecen acceso a los eventos de dosis de medicamentos ni a las consultas de medicamentos en seguimiento de HealthKit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique de médicaments nécessite iOS ou Mac Catalyst 26.0 ou une version ultérieure : les systèmes antérieurs ne donnent pas accès aux événements de prise de médicaments ni aux requêtes sur les médicaments suivis dans HealthKit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia dei farmaci richiede iOS o Mac Catalyst 26.0 o versioni successive: i sistemi precedenti non consentono l’accesso agli eventi delle dosi di farmaci né alle query sui farmaci monitorati di HealthKit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服薬履歴には、iOSまたはMac Catalyst 26.0以降が必要です。それ以前のシステムでは、HealthKitの服薬イベントや追跡中の薬を照会するAPIが提供されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복약 기록을 읽으려면 iOS 또는 Mac Catalyst 26.0 이상이 필요합니다. 이전 버전에서는 HealthKit 복약 이벤트 및 추적 중인 약 조회 API를 제공하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取用药历史记录需要 iOS 或 Mac Catalyst 26.0 或更高版本：较早版本的系统不提供 HealthKit 服药剂量事件及正在跟踪的药物查询接口。"
          }
        }
      }
    },
