    "meeting.offlineTranscription.changedDuringRetry": {
      "comment": "Offline transcription was not applied because the meeting changed.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 내용이 변경되어 오프라인 전사를 적용하지 않았습니다. 다시 시도하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting changed, so the offline transcript was not applied. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reunión ha cambiado, por lo que no se aplicó la transcripción sin conexión. Vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の内容が変更されたため、オフライン文字起こしを適用しませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议内容已更改，因此未应用离线转写结果。请重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réunion a changé ; la transcription hors ligne n’a donc pas été appliquée. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riunione è cambiata, quindi la trascrizione offline non è stata applicata. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Besprechung wurde geändert, daher wurde das Offline-Transkript nicht übernommen. Versuche es erneut."
          }
        }
      }
    },
    "meeting.offlineTranscription.confirm.imported": {
      "comment": "Offline retranscription confirmation for imported audio.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 전사와 분석 결과가 대체됩니다. 가져온 음성은 보존됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces the current transcript and analysis. The imported audio remains saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sustituye la transcripción y el análisis actuales. El audio importado permanece guardado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の文字起こしと分析結果が置き換えられます。読み込んだ音声は保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将替换当前转写文本和分析结果。导入的音频仍会保留。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription et l’analyse actuelles seront remplacées. L’audio importé reste enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione e l’analisi attuali verranno sostituite. L’audio importato resta salvato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ersetzt das aktuelle Transkript und die Analyse. Die importierten Audiodaten bleiben gespeichert."
          }
        }
      }
    },
    "meeting.offlineTranscription.confirm.recorded": {
      "comment": "Offline retranscription confirmation for recorded audio.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 전사와 분석 결과가 대체됩니다. 저장된 음성과 Apple 원본 전사는 보존됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces the current transcript and analysis. Saved audio and the original Apple transcript are preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sustituye la transcripción y el análisis actuales. Se conservan el audio guardado y la transcripción original de Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより現在の文字起こしと分析が置き換えられます。保存された音声と元のApple文字起こしは保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将替换当前的转写文本和分析结果。已保存的音频和 Apple 原始转写文本会保留。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette opération remplace la transcription et l’analyse actuelles. L’audio sauvegardé et la transcription originale Apple sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione sostituisce la trascrizione e l'analisi attuali. L'audio salvato e la trascrizione originale Apple vengono conservati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ersetzt das aktuelle Transkript und die Analyse. Das gespeicherte Audio und das ursprüngliche Apple-Transkript bleiben erhalten."
          }
        }
      }
    },
    "meeting.offlineTranscription.confirm.title": {
      "comment": "Confirmation before replacing the transcript with offline transcription.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 음성을 오프라인으로 전사할까요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe saved audio offline?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Transcribir el audio guardado sin conexión?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された音声をオフラインで文字起こししますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要离线转写已保存的音频吗？"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrire l’audio enregistré hors ligne ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrivere l'audio salvato offline?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichertes Audio offline transkribieren?"
          }
        }
      }
    },
    "meeting.offlineTranscription.error.audioUnavailable": {
      "comment": "Saved-audio transcription could not prepare the original audio.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 녹음을 준비하지 못했습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved recording could not be prepared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo preparar la grabación guardada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの録音を準備できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备已保存的录音。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement sauvegardé n’a pas pu être préparé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile preparare la registrazione salvata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Aufnahme konnte nicht vorbereitet werden."
          }
        }
      }
    },
    "meeting.offlineTranscription.error.busy": {
      "comment": "Saved-audio transcription is blocked by the shared model execution gate.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 녹음에서 기기 내 오디오 모델을 사용 중입니다. 종료된 후 다시 시도하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another recording is using the on-device audio model. Try again after it ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra grabación está usando el modelo de audio del dispositivo. Vuelve a intentarlo cuando termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の録音でデバイス内の音声モデルを使用中です。終了してからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一段录音正在使用设备端音频模型。请等其结束后重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre enregistrement utilise le modèle audio sur l’appareil. Réessayez lorsqu’il sera terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra registrazione sta usando il modello audio sul dispositivo. Riprova al termine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Aufnahme verwendet das Audiomodell auf dem Gerät. Versuche es nach ihrem Ende erneut."
          }
        }
      }
    },
    "meeting.offlineTranscription.error.cleanupFailed": {
      "comment": "Saved-audio transcription could not remove its temporary WAV.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사에 사용한 임시 오디오를 삭제하지 못했습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary transcription audio could not be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar el audio temporal de la transcripción."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こし用の一時音声ファイルを削除できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除转写时使用的临时音频。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio temporaire de transcription n’a pas pu être supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rimuovere l’audio temporaneo della trascrizione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Audiodaten der Transkription konnten nicht entfernt werden."
          }
        }
      }
    },
    "meeting.offlineTranscription.error.invalidManifest": {
      "comment": "Saved-audio transcription error: invalid recording timeline, without private diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 녹음 타임라인이 올바르지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved recording timeline is invalid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea de tiempo de la grabación guardada no es válida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済み録音のタイムラインが無効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存录音的时间线无效。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La chronologie de l’enregistrement sauvegardé est invalide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sequenza temporale della registrazione salvata non è valida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeitleiste der gespeicherten Aufnahme ist ungültig."
          }
        }
      }
    },
    "meeting.offlineTranscription.error.invalidOutput": {
      "comment": "Saved-audio transcription output failed validation before commit.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 전사에서 올바르지 않은 전사를 반환했습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline transcription returned an invalid transcript."
          }
        },
        "es": {
          "stringUnit": {
