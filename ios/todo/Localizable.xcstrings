            "state": "translated",
            "value": "Aceptar la invitación te permite participar en el calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待を承認すると、カレンダーに参加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受邀请后，你即可参与该日历。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepter l’invitation vous permet de participer au calendrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accettando l’invito puoi partecipare al calendario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die Einladung annimmst, kannst du am Kalender teilnehmen."
          }
        }
      }
    },
    "mail.invitation.acceptSummary": {
      "comment": "Generated service prose; interpolated values preserve source content.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 캘린더 공유 초대입니다. 참여하려면 초대를 수락하세요."
          }
        },
        "en": {
          "stringUnit": {
