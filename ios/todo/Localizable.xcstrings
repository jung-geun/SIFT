          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google IDトークンがないため、Firebaseの同期を開始できません。Gmailを再接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少 Google ID 令牌，无法启动 Firebase 同步。请重新连接 Gmail。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation Firebase ne peut pas démarrer, car le jeton d’identification Google est manquant. Reconnectez Gmail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
