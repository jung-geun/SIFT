    "meeting.help.autoRefine.message" : {
      "comment" : "Automatic transcript proofreading help message.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After recording and retranscription, on-device AI (Apple Intelligence) automatically corrects recognition errors and typos to improve summary quality. Turn it off to summarize the original transcript."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음 완료·재전사 후 온디바이스 AI(Apple Intelligence)로 전사의 오인식·오탈자를 자동 교정해 요약 품질을 높입니다. 끄면 원문을 그대로 요약합니다."
          }
        }
      }
    },
