    "routines.uncertainty.summary" : {
      "comment" : "Arguments: localized sample count, distinct-day count, confidence, confidence-dependent review caveat. Rendered from structured fields, never persisted uncertainty prose.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basierend auf %1$@ an %2$@ (%3$@). Abhakzeiten belegen weder den tatsächlichen Zeitpunkt noch die Dauer einer Aktivität. %4$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Based on %1$@ across %2$@ (%3$@). Checkoff times do not prove actual activity time or duration. %4$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se basa en %1$@ en %2$@ (%3$@). Las horas en que se marca como completado no demuestran la hora ni la duración reales de la actividad. %4$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur la base de %1$@ sur %2$@ (%3$@). Les heures de validation ne prouvent ni l’heure ni la durée de l’activité réelle. %4$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In base a %1$@ in %2$@ (%3$@). Gli orari di completamento registrati non dimostrano l’orario o la durata effettiva dell’attività. %4$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@にわたる%1$@に基づいています（%3$@）。完了チェックの時刻は、実際の活動時刻や所要時間を証明するものではありません。%4$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@의 근거입니다. %3$@. 완료 시각은 실제 활동 시각이나 소요 시간을 증명하지 않습니다. %4$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依据为 %2$@内的%1$@（%3$@）。勾选完成的时间不能证明实际活动的发生时间或持续时长。%4$@"
          }
        }
      }
    },
