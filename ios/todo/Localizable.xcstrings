    "legal.privacy.diagnostics.transmission": {
      "comment": "Privacy policy diagnostic transmission consent terms.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app never automatically transmits diagnostic logs. They are sent only when the user reviews and sends a report through Mail or the share sheet"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 진단 로그를 자동 전송하지 않으며, 사용자가 메일 또는 공유 시트에서 검토하고 보낼 때만 전송"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app nunca transmite automáticamente los registros de diagnóstico. Solo se envían cuando el usuario revisa y envía un informe mediante Mail o la hoja para compartir"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが診断ログを自動送信することはありません。ユーザーがメールまたは共有シートでレポートを確認して送信した場合にのみ送信されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用绝不会自动传输诊断日志。仅当用户通过邮件或共享面板审核并发送报告时，才会传输日志"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app ne transmet jamais automatiquement les journaux de diagnostic. Ils ne sont envoyés que lorsque l’utilisateur consulte et envoie un rapport via Mail ou la feuille de partage"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app non trasmette mai automaticamente i log diagnostici. Vengono inviati solo quando l'utente esamina e invia un rapporto tramite Mail o il pannello di condivisione"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App überträgt Diagnoseprotokolle niemals automatisch. Sie werden nur gesendet, wenn der Benutzer einen Bericht über Mail oder das Teilen-Menü prüft und versendet"
          }
        }
      }
    },
