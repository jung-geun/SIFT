          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 数据在传输和存储时使用 Apple 的加密基础设施"
          }
        }
      }
    },
    "legal.text.iCloud 동기화 충돌·지연은 Apple 인프라에 의존하므로 운영자가 보장할 수 없습니다." : {
      "comment" : "English legal translation preserving the Korean source structure and meaning.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Betreiber kann die Lösung von Synchronisierungskonflikten oder den Zeitpunkt der iCloud-Synchronisierung nicht garantieren, da diese von Apples Infrastruktur abhängen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The operator cannot guarantee iCloud sync conflict resolution or timing because it depends on Apple infrastructure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El operador no puede garantizar la resolución de conflictos ni los plazos de sincronización con iCloud, ya que dependen de la infraestructura de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’exploitant ne peut garantir ni la résolution des conflits ni les délais de synchronisation iCloud, qui dépendent de l’infrastructure d’Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gestore non può garantire la risoluzione dei conflitti o i tempi di sincronizzazione iCloud, poiché dipendono dall'infrastruttura Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud同期の競合解決やタイミングはAppleの基盤に依存するため、運営者は保証できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 동기화 충돌·지연은 Apple 인프라에 의존하므로 운영자가 보장할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步的冲突解决和时效取决于 Apple 基础设施，因此运营者无法作出保证。"
          }
        }
      }
    },
