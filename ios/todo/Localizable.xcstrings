          }
        }
      }
    },
    "schedule.error.notificationDenied": {
      "comment": "Schedule approval error: notificationDenied.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 권한이 허용되지 않았습니다. 시스템 설정에서 허용하거나 새 알림을 끄세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission is not allowed. Enable it in System Settings or turn off the new reminder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha permitido el envío de notificaciones. Actívalo en Ajustes del sistema o desactiva el nuevo recordatorio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が許可されていません。システム設定で許可するか、新しいリマインダーをオフにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未允许通知权限。请在系统设置中启用，或关闭新增提醒。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications ne sont pas autorisées. Activez-les dans les réglages système ou désactivez le nouveau rappel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorizzazione alle notifiche non è concessa. Abilitala nelle impostazioni di sistema oppure disattiva il nuovo promemoria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind nicht erlaubt. Aktiviere die Berechtigung in den Systemeinstellungen oder deaktiviere die neue Erinnerung."
          }
        }
      }
    },
    "schedule.error.savedFollowUp": {
      "comment": "Argument: app-owned localized follow-up error; saving a task is not rolled back.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일은 저장되었습니다. 후속 처리 확인 실패: %@"
          }
        },
        "en": {
          "stringUnit": {
