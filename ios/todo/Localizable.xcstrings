    "legal.privacy.diagnostics.title": {
      "comment": "Privacy policy title for user-consented diagnostic reporting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1-6. User-consented diagnostic reporting (optional)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1-6. 사용자 동의형 오류 진단 (선택)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1-6. Informes de diagnóstico con consentimiento del usuario (opcional)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1-6. ユーザーの同意に基づく診断レポート（任意）"
          }
        },
        "zh-Hans": {
