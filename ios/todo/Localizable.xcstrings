    "mail.connection.manualFooter": {
      "comment": "Connected mail accounts support manual refresh and inbox access.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 메일 계정으로 수동 메일 확인 및 받은편지함 조회가 가능합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected mail accounts support manual mail refresh and inbox access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas de correo conectadas permiten actualizar el correo manualmente y acceder a la bandeja de entrada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続済みのメールアカウントでは、手動でのメール更新と受信トレイの閲覧ができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接的邮件账户支持手动刷新邮件和查看收件箱。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes e-mail connectés permettent d’actualiser manuellement les messages et de consulter la boîte de réception."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli account email collegati consentono l’aggiornamento manuale della posta e l’accesso alla posta in arrivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbundene E-Mail-Konten ermöglichen das manuelle Aktualisieren von E-Mails und den Zugriff auf den Posteingang."
          }
        }
      }
    },
