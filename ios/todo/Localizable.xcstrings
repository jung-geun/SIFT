    "openai.connection.check.invalidResponse" : {
      "comment" : "The fixed connection probe failed validation; do not imply app-data analysis occurred.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI hat eine ungültige Antwort auf die Verbindungsprüfung geliefert. Der Inferenzzugriff wurde nicht bestätigt. Es wurden keine gespeicherten App-Daten gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
