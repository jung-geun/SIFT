    "health.error.storage" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der geschützte Gesundheitsverlauf konnte nicht gespeichert oder gelesen werden. Die automatische Erstellung ist gestoppt. Setze zur Wiederherstellung die lokalen Gesundheitsdaten zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protected health history could not be saved or read. Automatic creation is stopped. Reset local health data to recover."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar o leer el historial de salud protegido. La creación automática se ha detenido. Restablece los datos de salud locales para recuperar el funcionamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer ou de lire l’historique de santé protégé. La création automatique est arrêtée. Réinitialisez les données de santé locales pour rétablir le fonctionnement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare o leggere la cronologia sanitaria protetta. La creazione automatica è stata interrotta. Reimposta i dati sanitari locali per ripristinare il funzionamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保護された健康履歴を保存または読み取りできませんでした。自動作成は停止しています。復旧するにはローカルの健康データをリセットしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보호된 건강 기록을 저장하거나 읽을 수 없어 자동 생성을 중지했습니다. 로컬 건강 데이터를 초기화하여 복구하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存或读取受保护的健康历史记录。自动创建已停止。请重置本地健康数据以恢复。"
          }
        }
      }
    },
