    "routines.storage.explanation": {
      "comment": "Routine review UI: routines.storage.explanation.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 보호된 파일에만 저장하며 iCloud로 동기화하지 않습니다. 이미 승인해 만든 할 일은 따로 삭제해야 합니다. 삭제 후 다시 학습하려면 분석을 직접 실행해야 합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored only in a protected local file, not synced with iCloud. Previously accepted tasks must be deleted separately. Relearning after deletion requires an explicit analysis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda únicamente en un archivo local protegido, sin sincronización con iCloud. Las tareas aceptadas anteriormente deben eliminarse por separado. Para volver a aprender tras la eliminación, debes iniciar un análisis de forma explícita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護されたローカルファイルにのみ保存され、iCloudとは同期されません。受け入れて作成したタスクは別途削除する必要があります。削除後に再学習するには、分析を手動で実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存在设备上受保护的本地文件中，不会通过 iCloud 同步。此前接受建议后创建的待办事项需要单独删除。删除后，只有手动运行分析才会重新学习。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockage uniquement dans un fichier local protégé, sans synchronisation iCloud. Les tâches déjà acceptées doivent être supprimées séparément. Après suppression, une analyse doit être lancée explicitement pour reprendre l’apprentissage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvati solo in un file locale protetto, senza sincronizzazione con iCloud. Le attività già accettate vanno eliminate separatamente. Dopo l’eliminazione, per riprendere l’apprendimento devi avviare esplicitamente un’analisi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in einer geschützten lokalen Datei gespeichert, ohne iCloud-Synchronisierung. Bereits angenommene Aufgaben müssen separat gelöscht werden. Nach dem Löschen ist zum erneuten Lernen eine ausdrücklich gestartete Analyse erforderlich."
          }
        }
      }
    },
