    "diagnostics.collection.detail" : {
      "comment" : "Diagnostic collection consent detail.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only with your consent, error timestamps, locations, and source line numbers, error codes and messages, device specs and setting states, recent app error logs, app and OS versions, and Apple system diagnostics are kept on this device. Recordings, transcripts, to-dos, email content, and account information are excluded."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동의한 경우에만 오류 발생 시각·위치·소스 줄 번호, 오류 코드·메시지, 기기 사양과 설정 상태, 최근 앱 오류 로그, 앱·OS 버전과 Apple 시스템 진단을 이 기기에 보관합니다. 음성 녹음, 전사문, TODO, 이메일 내용, 계정 정보는 포함하지 않습니다."
          }
        }
      }
