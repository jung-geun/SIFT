    "legal.privacy.ads.boundary" : {
      "comment" : "Advertising-version privacy disclosure; preserve SDK data collection, consent and content-isolation boundaries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFT übermittelt keine Inhalte von Aufgaben, E-Mails, Kalendern, Gesundheitsdaten, Sprachaufnahmen, Transkripten oder Personas für Werbe-Targeting. HealthKit-Daten werden niemals für Werbung verwendet oder an Werbe-SDKs weitergeleitet. SDK-Diagnosen sind von optionalen SIFT-Fehlerberichten getrennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFT does not send todo, email, calendar, health, voice, transcript or persona contents for ad targeting. HealthKit data is never used for advertising or routed to advertising SDKs. SDK diagnostics are separate from optional SIFT error reports."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFT no envía contenido de tareas, correo, calendario, salud, voz, transcripciones o perfiles de persona para segmentar anuncios. Los datos de HealthKit nunca se utilizan para publicidad ni se envían a SDK publicitarios. Los diagnósticos del SDK son independientes de los informes de errores opcionales de SIFT."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFT ne transmet pas le contenu des tâches, e-mails, calendriers, données de santé, voix, transcriptions ou personas pour le ciblage publicitaire. Les données HealthKit ne sont jamais utilisées à des fins publicitaires ni envoyées aux SDK publicitaires. Les diagnostics du SDK sont distincts des rapports d’erreurs facultatifs de SIFT."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFT non invia contenuti di attività, email, calendari, salute, voce, trascrizioni o persona per il targeting pubblicitario. I dati HealthKit non vengono mai usati per la pubblicità né inviati agli SDK pubblicitari. La diagnostica dell’SDK è separata dalle segnalazioni di errori facoltative di SIFT."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFTは、タスク・メール・カレンダー・健康・音声・文字起こし・ペルソナの内容を広告ターゲティングに渡しません。HealthKitデータは広告に一切使用せず、広告SDKにも送りません。SDKの診断処理は、任意のSIFTエラー報告とは別です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFT는 할 일·이메일·캘린더·건강·음성·전사·페르소나 내용을 광고 타기팅에 전달하지 않습니다. HealthKit 데이터는 광고에 절대 사용하지 않으며 광고 SDK로 보내지 않습니다. SDK의 진단 처리는 별도 선택형 SIFT 오류 보고와 구분됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SIFT 不会将待办事项、邮件、日历、健康、语音、转录或 persona 的内容用于广告定向。HealthKit 数据绝不用于广告，也不会发送至广告 SDK。SDK 的诊断处理独立于可选的 SIFT 错误报告。"
          }
        }
      }
    },
    "legal.privacy.ads.consent" : {
      "comment" : "Advertising-version privacy disclosure; preserve SDK data collection, consent and content-isolation boundaries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor Anzeigenanfragen prüfen wir den Einwilligungsstatus über Google UMP und zeigen erforderliche Hinweise und Formulare. Anzeigen werden nur angefordert, wenn UMP dies erlaubt. Falls erforderlich, kannst du das Formular in den Einstellungen über die Datenschutzoptionen für Werbung erneut öffnen und deine Auswahl ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before requesting ads, we check consent status through Google UMP and show any required notices and consent forms. We request ads only when UMP permits it. When required, ad privacy options in Settings let you reopen the form and change your choices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de solicitar anuncios, comprobamos el estado del consentimiento mediante Google UMP y mostramos los avisos y formularios necesarios. Solo solicitamos anuncios cuando UMP lo permite. Cuando se requiera, las opciones de privacidad de anuncios en Ajustes permiten reabrir el formulario y cambiar tus decisiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de demander des annonces, nous vérifions le consentement via Google UMP et affichons les avis et formulaires requis. Nous ne demandons des annonces que si UMP le permet. Lorsque cela est requis, les options de confidentialité publicitaire dans Réglages permettent de rouvrir le formulaire et de modifier vos choix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di richiedere annunci, verifichiamo lo stato del consenso tramite Google UMP e mostriamo gli avvisi e i moduli necessari. Richiediamo annunci solo quando UMP lo consente. Quando richiesto, le opzioni privacy degli annunci in Impostazioni permettono di riaprire il modulo e modificare le scelte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告をリクエストする前にGoogle UMPで同意状況を確認し、必要な案内・同意フォームを表示します。UMPが許可する場合にのみ広告をリクエストします。必要な場合は、設定の広告プライバシー設定からフォームを開き直して選択を変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고 요청 전 Google UMP로 동의 상태를 확인하고 필요한 안내·동의 양식을 표시합니다. UMP가 광고 요청을 허용하는 경우에만 요청하며, 필요한 경우 설정에서 광고 개인정보 옵션을 다시 열어 선택을 변경할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求广告前，我们通过 Google UMP 检查同意状态，并显示所需的提示和同意表单。仅在 UMP 允许时请求广告。需要时，可在设置中的广告隐私选项重新打开表单并更改选择。"
          }
        }
      }
    },
    "legal.privacy.ads.controls" : {
      "comment" : "Advertising-version privacy disclosure; preserve SDK data collection, consent and content-isolation boundaries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Googles Verarbeitung, Aufbewahrung und Löschung richten sich nach den Google-Richtlinien und den geltenden UMP-Entscheidungen. Das Löschen von App-Daten oder lokalen Diagnosen löscht bereits von Google verarbeitete Informationen nicht sofort. Datenschutz- und Löschoptionen findest du in Googles Richtlinien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google processing, retention and deletion follow Google policies and applicable UMP choices. Deleting app data or local diagnostics does not immediately delete information already processed by Google. See Google policies for privacy and deletion controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tratamiento, la conservación y la eliminación por parte de Google se rigen por sus políticas y las decisiones aplicables de UMP. Eliminar los datos de la app o los diagnósticos locales no elimina de inmediato la información ya tratada por Google. Consulta sus políticas para conocer los controles de privacidad y eliminación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le traitement, la conservation et la suppression par Google suivent ses politiques et les choix UMP applicables. Supprimer les données de l’app ou les diagnostics locaux ne supprime pas immédiatement les informations déjà traitées par Google. Consultez ses politiques pour les contrôles de confidentialité et de suppression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il trattamento, la conservazione e l’eliminazione da parte di Google seguono le sue norme e le scelte UMP applicabili. Eliminare i dati dell’app o la diagnostica locale non elimina immediatamente le informazioni già trattate da Google. Consulta le norme di Google per i controlli sulla privacy e sull’eliminazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Googleによる処理・保存・削除には、Googleのポリシーと適用されるUMPの選択が適用されます。アプリのデータやローカル診断を削除しても、Googleが処理済みの情報が直ちに削除されるわけではありません。プライバシー管理・削除方法はGoogleのポリシーをご確認ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google의 처리·보관·삭제에는 Google 정책과 적용되는 UMP 선택이 따릅니다. 앱 데이터나 로컬 진단을 삭제해도 Google이 이미 처리한 정보가 즉시 삭제되는 것은 아닙니다. Google 정책에서 개인정보 관리·삭제 방법을 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 的处理、保留和删除遵循其政策及适用的 UMP 选择。删除应用数据或本地诊断不会立即删除 Google 已处理的信息。隐私管理和删除方式请参阅 Google 政策。"
          }
        }
      }
    },
    "legal.privacy.ads.data" : {
      "comment" : "Advertising-version privacy disclosure; preserve SDK data collection, consent and content-isolation boundaries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Googles Werbe- und Einwilligungs-SDKs können IP-Adresse und daraus abgeleiteten ungefähren Standort, App- und Gerätekennungen, Interaktionen wie Anzeigenaufrufe und Klicks sowie Absturz-, Diagnose- und Leistungsdaten zur Anzeigenauslieferung, Betrugsprävention, Messung und Einwilligungsverwaltung verarbeiten. Einige Kennungen sowie Werbe- und Interaktionsdaten können mit dir verknüpft oder zum Tracking verwendet werden. Nicht personalisierte Anzeigen sind weder vollständig anonym noch ohne Datenerfassung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google advertising and consent SDKs may process your IP address and inferred coarse location, app and device identifiers, interactions such as ad views and clicks, and crash, diagnostic and performance data for ad serving, fraud prevention, measurement and consent management. Some identifiers, advertising and interaction data may be linked to you or used for tracking. Non-personalized ads are not fully anonymous or free of data collection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los SDK de publicidad y consentimiento de Google pueden tratar la dirección IP y la ubicación aproximada inferida, identificadores de la app y del dispositivo, interacciones como vistas y clics en anuncios y datos de fallos, diagnóstico y rendimiento para mostrar anuncios, prevenir el fraude, realizar mediciones y gestionar el consentimiento. Algunos identificadores y datos publicitarios y de interacción pueden vincularse contigo o usarse para el seguimiento. Los anuncios no personalizados no son totalmente anónimos ni están exentos de recopilación de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les SDK publicitaires et de consentement de Google peuvent traiter l’adresse IP et la position approximative déduite, les identifiants d’application et d’appareil, les interactions telles que les vues et clics publicitaires, ainsi que les données de plantage, de diagnostic et de performances pour diffuser des annonces, prévenir la fraude, effectuer des mesures et gérer le consentement. Certains identifiants et données publicitaires et d’interaction peuvent vous être associés ou servir au suivi. Les annonces non personnalisées ne sont pas totalement anonymes ni exemptes de collecte de données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli SDK pubblicitari e di consenso di Google possono trattare l’indirizzo IP e la posizione approssimativa dedotta, identificatori dell’app e del dispositivo, interazioni come visualizzazioni e clic sugli annunci e dati su arresti anomali, diagnostica e prestazioni per pubblicare annunci, prevenire frodi, effettuare misurazioni e gestire il consenso. Alcuni identificatori e dati pubblicitari e di interazione possono essere collegati a te o usati per il tracciamento. Gli annunci non personalizzati non sono completamente anonimi né privi di raccolta dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Googleの広告・同意SDKは、広告配信、不正防止、測定、同意管理のために、IPアドレスとそこから推定したおおよその位置、アプリ・デバイス識別子、広告の表示・クリックなどの操作、クラッシュ・診断・パフォーマンス情報を処理する場合があります。一部の識別子・広告・操作情報はユーザーに関連付けられたり、トラッキングに使用されたりする場合があります。非パーソナライズ広告も完全に匿名ではなく、データ収集がないわけではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 광고·동의 SDK는 IP 주소와 그로부터 추정한 대략적 위치, 앱·기기 식별자, 광고 조회·클릭 등 상호작용, 충돌·진단·성능 정보를 광고 제공·부정행위 방지·측정 및 동의 관리에 처리할 수 있습니다. 일부 식별자·광고 및 상호작용 정보는 사용자와 연결되거나 추적에 사용될 수 있습니다. 비개인 맞춤 광고도 완전 익명이나 수집 없음이 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 广告和同意 SDK 可能为广告投放、防欺诈、衡量和同意管理处理 IP 地址及由此推断的大致位置、应用和设备标识符、广告浏览和点击等互动，以及崩溃、诊断和性能数据。部分标识符、广告和互动数据可能与您关联或用于跟踪。非个性化广告并不等于完全匿名或不收集数据。"
          }
        }
      }
    },
