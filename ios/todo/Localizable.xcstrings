    "openai.error.unknown": {
      "comment": "Safe fallback for unknown errors; do not expose private diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI 작업을 완료하지 못했습니다. 다시 시도해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The OpenAI operation could not be completed. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la operación de OpenAI. Vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAIの処理を完了できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成 OpenAI 操作。请重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération OpenAI n’a pas pu être terminée. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare l’operazione OpenAI. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die OpenAI-Aktion konnte nicht abgeschlossen werden. Bitte versuche es erneut."
          }
        }
      }
    },
