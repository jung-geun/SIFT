    "meeting.alert.recordingNotice.message": {
      "comment": "Recording notice alert message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other people’s voices will be recorded. Review the required notice and consent before starting. This meeting starts with on-device processing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람의 음성이 녹음됩니다. 시작 전에 필요한 고지와 동의를 확인하세요. 이 회의는 기기 내 처리로 시작합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se grabarán las voces de otras personas. Revisa el aviso y el consentimiento necesarios antes de empezar. Esta reunión comienza con el procesamiento en el dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の人の声が録音されます。開始する前に、必要な告知と同意を確認してください。この会議はデバイス内処理で開始します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音将包含他人的声音。开始前，请确认已履行必要的告知义务并取得同意。此会议将以设备端处理方式开始。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les voix d’autres personnes seront enregistrées. Vérifiez les informations et le consentement requis avant de commencer. Cette réunion commence avec un traitement sur l’appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno registrate le voci di altre persone. Prima di iniziare, verifica gli obblighi di informativa e consenso. Questa riunione inizia con l'elaborazione sul dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stimmen anderer Personen werden aufgenommen. Prüfe vor dem Start die erforderlichen Hinweise und Einwilligungen. Diese Besprechung beginnt mit der Verarbeitung auf dem Gerät."
          }
        }
      }
    },
    "meeting.alert.recordingNotice.title": {
