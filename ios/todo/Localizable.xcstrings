    "calendar.settings.autoRegister" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fristen automatisch in den Kalender exportieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically Export Deadlines"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportar plazos automáticamente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporter automatiquement les échéances"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta automaticamente le scadenze"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期限を自動でカレンダーに書き出す"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마감 자동 캘린더 등록"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动将截止时间导出到日历"
          }
        }
      }
    },
    "calendar.settings.autoRegisterFooter" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur aktive Aufgaben mit einer Frist aus den ausgewählten Quellen werden automatisch exportiert. Aufgaben, die auf eine Prüfung warten, Aufgaben aus Kalendern und Gesundheitsroutinen sind ausgeschlossen. Auch dringende Aufgaben und Aufgaben mit höchster Priorität erfordern diese Zustimmung. Kalenderzugriff und ein Zielkalender mit Schreibzugriff sind erforderlich. Das Ausschalten entfernt keine bestehenden Ereignisse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only active to-dos with a deadline from the selected sources are exported automatically. To-dos awaiting review, calendar-sourced to-dos, and health routines are excluded. Urgent and highest-priority to-dos also require this consent. Calendar access and a writable destination are required; turning this off does not remove existing events."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se exportan automáticamente las tareas activas con plazo de los orígenes seleccionados. Se excluyen las tareas pendientes de revisión, las procedentes de calendarios y las rutinas de salud. Las tareas urgentes y de máxima prioridad también requieren este consentimiento. Se necesita acceso al calendario y un calendario de destino con permiso de escritura; desactivar esta opción no elimina los eventos existentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les tâches actives ayant une échéance et provenant des sources sélectionnées sont exportées automatiquement. Les tâches en attente de révision, celles issues des calendriers et les routines de santé sont exclues. Les tâches urgentes et de priorité maximale nécessitent également ce consentement. L’accès au calendrier et un calendrier de destination accessible en écriture sont requis ; désactiver cette option ne supprime pas les événements existants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono esportate automaticamente solo le attività attive con una scadenza provenienti dalle origini selezionate. Sono escluse le attività in attesa di revisione, quelle provenienti dai calendari e le routine di salute. Anche le attività urgenti e con priorità massima richiedono questo consenso. Sono necessari l’accesso al calendario e un calendario di destinazione con accesso in scrittura; disattivare questa opzione non rimuove gli eventi esistenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した作成元のタスクのうち、期限が設定された進行中のタスクだけが自動で書き出されます。レビュー待ちのタスク、カレンダーから作成したタスク、健康ルーティンは対象外です。緊急および最優先のタスクにも、この同意が必要です。カレンダーへのアクセス権と書き込み可能な書き出し先が必要です。オフにしても既存の予定は削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 출처의 마감이 있는 진행 중 할 일만 자동으로 등록합니다. 검토 대기·캘린더 출처 할 일과 건강 루틴은 제외됩니다. 긴급·최우선 할 일도 이 동의가 필요합니다. 캘린더 접근 권한과 쓰기 가능한 등록 대상이 필요하며, 자동 등록을 꺼도 기존 일정은 삭제되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅自动导出所选来源中设有截止时间且进行中的待办事项。待审核的待办事项、来自日历的待办事项和健康日常计划不在导出范围内。紧急和最高优先级的待办事项也需要此项同意。必须具有日历访问权限并选择可写入的目标日历；关闭此功能不会删除已有日程。"
          }
        }
      }
    },
