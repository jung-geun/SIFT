    "schedule.calendar.checked": {
      "comment": "Schedule approval UI: schedule.calendar.checked.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 일정·할 일과 겹치지 않는 구간을 검사합니다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks intervals against calendar events and scheduled tasks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba los intervalos con los eventos del calendario y las tareas programadas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーの予定や日時設定済みのタスクと時間枠を照合します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查时段是否与日历日程及已安排的待办事项冲突"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie les créneaux par rapport aux événements du calendrier et aux tâches planifiées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica gli intervalli rispetto agli eventi del calendario e alle attività pianificate"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft Zeiträume auf Überschneidungen mit Kalenderereignissen und geplanten Aufgaben"
          }
        }
      }
    },
    "schedule.calendar.explanation": {
      "comment": "Schedule approval UI: schedule.calendar.explanation.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 없으면 다른 캘린더의 충돌 여부를 알 수 없습니다. 앱 안의 확정된 할 일만 검사합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without permission, conflicts in other calendars cannot be checked. Only confirmed scheduled tasks in this app are checked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin permiso, no se pueden comprobar los conflictos en otros calendarios. Solo se comprueban las tareas programadas confirmadas en esta app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス許可がない場合、ほかのカレンダーとの重複は確認できません。このアプリ内の確定済みタスクの予定のみを確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未获得权限时，无法检查其他日历中的冲突。仅检查此应用中已确认安排的待办事项。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans autorisation, les conflits avec les autres calendriers ne peuvent pas être vérifiés. Seules les tâches planifiées confirmées dans cette app sont vérifiées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza autorizzazione non è possibile verificare i conflitti negli altri calendari. Vengono controllate solo le attività pianificate confermate in questa app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Berechtigung können Konflikte in anderen Kalendern nicht geprüft werden. Es werden nur bestätigte geplante Aufgaben in dieser App geprüft."
          }
        }
      }
    },
