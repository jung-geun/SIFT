    "meeting.diarization.modelUnavailableState": {
      "comment": "Saved-audio analysis skipped without an installed model.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speaker model was not installed. Install it in Beta Features, then detect speakers again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화자 모델이 없어 분석하지 못했습니다. 베타 기능에서 설치한 뒤 다시 분석하세요."
