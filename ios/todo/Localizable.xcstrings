    "legal.text.캘린더 권한 철회: iOS 설정 → 개인정보 보호 → 캘린더 → SIFT 비활성화": {
      "comment": "English legal translation preserving the Korean source structure and meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke Calendar permission: iOS Settings → Privacy & Security → Calendar → disable SIFT"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 권한 철회: iOS 설정 → 개인정보 보호 → 캘린더 → SIFT 비활성화"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revocar el permiso del calendario: Ajustes de iOS → Privacidad y seguridad → Calendarios → desactivar SIFT"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーのアクセス許可を取り消す：iOSの設定 → プライバシーとセキュリティ → カレンダー → SIFTを無効にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销日历权限：iOS 设置 → 隐私与安全性 → 日历 → 关闭 SIFT"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Révoquer l’autorisation du calendrier : Réglages iOS → Confidentialité et sécurité → Calendriers → désactiver SIFT"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Revocare l'autorizzazione al Calendario: Impostazioni iOS → Privacy e sicurezza → Calendari → disattiva SIFT"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderberechtigung widerrufen: iOS-Einstellungen → Datenschutz & Sicherheit → Kalender → SIFT deaktivieren"
          }
        }
      }
    },
