    "legal.text.사용자가 루틴 기록을 삭제할 때까지": {
      "comment": "English legal translation preserving source meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until the user deletes routine records"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자가 루틴 기록을 삭제할 때까지"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que el usuario elimine los registros de rutinas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーがルーティンの記録を削除するまで"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直至用户删除日常规律记录"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à la suppression des données de routine par l’utilisateur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché l’utente non elimina i record delle routine"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis der Nutzer die Routinendatensätze löscht"
          }
        }
      }
    },
