    "데이터가 이 기기에만 저장됩니다" : {
      "comment" : "Localized UI copy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daten werden nur auf diesem Gerät gespeichert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data is stored only on this device"
          }
        },
        "es" : {
          "stringUnit" : {
