          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivare la sincronizzazione iCloud: Impostazioni → Sincronizzazione iCloud → Disattiva"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Synchronisierung ausschalten: Einstellungen → iCloud-Synchronisierung → Deaktivieren"
          }
        }
      }
    },
    "legal.text.iCloud.com에서 직접 삭제 시": {
