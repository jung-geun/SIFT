    "100%는 원본 · 미만은 감쇠 · 초과는 증폭" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% ist das Original · darunter Dämpfung · darüber Verstärkung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% is original · below 100% attenuates · above 100% amplifies"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% es el original · menos del 100% atenúa · más del 100% amplifica"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% : volume d’origine · moins : atténuation · plus : amplification"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% è l’originale · sotto il 100% attenua · sopra il 100% amplifica"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100%は元の音量 · 100%未満は減衰 · 100%超は増幅"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100%는 원본 · 미만은 감쇠 · 초과는 증폭"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% 为原始音量 · 低于 100% 为衰减 · 高于 100% 为放大"
          }
        }
      }
    },
    "100%를 넘는 증폭은 왜곡될 수 있습니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Verstärkung über 100% kann den Ton verzerren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amplification above 100% may distort the audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una amplificación superior al 100% puede distorsionar el audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une amplification au-delà de 100% peut déformer l’audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’amplificazione oltre il 100% può distorcere l’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100%を超える増幅では、音声がひずむ場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100%를 넘는 증폭은 왜곡될 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大至超过 100% 可能导致音频失真。"
          }
        }
      }
    },
    "A saved %@ App Password is available. The last connection attempt failed, but the password was not removed." : {
