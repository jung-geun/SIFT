    "legal.privacy.storage.localDetail" : {
      "comment" : "Full opt-in iCloud storage and device-local authorization boundaries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Daten bleiben lokal verfügbar. Das Deaktivieren der iCloud-Speicherung löscht weder lokale Daten noch Daten anderer Geräte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App data remains available locally. Turning off iCloud storage does not erase local data or data on other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de la app siguen disponibles localmente. Desactivar el almacenamiento en iCloud no borra los datos locales ni los de otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de l’app restent disponibles localement. Désactiver le stockage iCloud n’efface ni les données locales ni celles des autres appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati dell’app restano disponibili localmente. Disattivare l’archiviazione iCloud non elimina i dati locali né quelli degli altri dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリデータはローカルで引き続き利用できます。iCloudへの保存をオフにしても、ローカルデータやほかのデバイスのデータは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 데이터는 기기에서 계속 사용할 수 있습니다. iCloud 저장을 꺼도 로컬 데이터와 다른 기기의 데이터는 삭제하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用数据仍可在本地使用。关闭 iCloud 存储不会删除本地数据或其他设备上的数据。"
          }
        }
      }
    },
