    "meeting.alert.consentWithdrawal.message": {
      "comment": "Consent withdrawal alert message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdrawing consent stops recording and live transcription. The meeting recorded so far will be preserved."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동의를 철회하면 녹음과 실시간 전사가 중지됩니다. 지금까지 기록된 회의는 보존됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al retirar el consentimiento se detienen la grabación y la transcripción en directo. Se conservará la parte de la reunión grabada hasta ese momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同意を撤回すると、録音とリアルタイム文字起こしが停止します。それまでに記録された会議は保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回同意将停止录音和实时转写。目前已录制的会议内容会予以保留。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retrait du consentement arrête l’enregistrement et la transcription en direct. La partie de la réunion déjà enregistrée sera conservée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La revoca del consenso interrompe la registrazione e la trascrizione in tempo reale. La parte della riunione registrata finora verrà conservata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du deine Einwilligung widerrufst, werden die Aufnahme und die Live-Transkription beendet. Der bisher aufgezeichnete Teil der Besprechung bleibt erhalten."
          }
        }
      }
    },
