    "meeting.conversation.partialAudio" : {
      "comment" : "Meeting playback and evidence provenance; original source records remain unchanged.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur abspielbare Quellen mit bekannter gemeinsamer Zeitbasis werden gemischt. Prüfe die übrigen Quellen einzeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
