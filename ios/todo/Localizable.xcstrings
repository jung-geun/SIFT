    "legal.text.서비스가 이메일·캘린더에서 자동 추출하거나 AI가 생성한 할 일·우선순위·요약은 참고용입니다." : {
      "comment" : "English legal translation preserving the Korean source structure and meaning.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus E-Mails oder dem Kalender extrahierte oder von KI erzeugte Aufgaben, Prioritäten und Zusammenfassungen dienen nur als Orientierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To-dos, priorities, and summaries extracted from email or Calendar or generated by AI are for reference only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tareas, prioridades y resúmenes extraídos del correo o del calendario, o generados mediante IA, son meramente orientativos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tâches, priorités et résumés extraits des e-mails ou du calendrier, ou générés par IA, sont fournis uniquement à titre indicatif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le attività, le priorità e i riepiloghi estratti dalle email o dal Calendario o generati dall'IA hanno solo valore indicativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールやカレンダーから抽出された、またはAIが生成したTo-Do、優先順位、要約は、参考情報としてのみ提供されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서비스가 이메일·캘린더에서 자동 추출하거나 AI가 생성한 할 일·우선순위·요약은 참고용입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从邮件或日历中提取的、或由 AI 生成的待办事项、优先级和摘要仅供参考。"
          }
        }
      }
    },
    "legal.text.서비스는 아래 제3자 서비스와 연동됩니다. 각 서비스의 독자적인 이용약관 및 개인정보 처리방침이 함께 적용됩니다." : {
      "comment" : "English legal translation preserving the Korean source structure and meaning.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst ist mit den unten aufgeführten Diensten Dritter verbunden. Es gelten zusätzlich die jeweiligen Nutzungsbedingungen und Datenschutzerklärungen dieser Dienste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The service integrates with the third-party services below. Each service’s own terms and privacy policy also apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio se integra con los servicios de terceros indicados a continuación. También se aplican las condiciones y la política de privacidad propias de cada servicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service s’intègre aux services tiers ci-dessous. Les conditions d’utilisation et la politique de confidentialité propres à chaque service s’appliquent également."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio si integra con i servizi di terze parti elencati di seguito. Si applicano anche le condizioni e l'informativa sulla privacy di ciascun servizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本サービスは、以下の第三者サービスと連携します。各サービス独自の利用規約とプライバシーポリシーも適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서비스는 아래 제3자 서비스와 연동됩니다. 각 서비스의 독자적인 이용약관 및 개인정보 처리방침이 함께 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本服务与以下第三方服务集成。各服务各自的使用条款和隐私政策也同时适用。"
          }
        }
