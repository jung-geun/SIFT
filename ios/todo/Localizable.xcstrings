    "mail.lookback.scope" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unabhängig vom Anzeigezeitraum des Posteingangs ist die automatische Aufgaben- und Kalenderanalyse auf die letzten %lld Tage begrenzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independent of Inbox display period; automatic To-Do/calendar analysis is limited to the latest %lld days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independientemente del periodo que se muestra en la bandeja de entrada, el análisis automático de tareas y calendario se limita a los últimos %lld días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indépendamment de la période d’affichage de la boîte de réception, l’analyse automatique des tâches et du calendrier est limitée aux %lld derniers jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indipendentemente dal periodo visualizzato nella posta in arrivo, l'analisi automatica di attività ed eventi del calendario è limitata agli ultimi %lld giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
