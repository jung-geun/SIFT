      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 %@ App Password가 있습니다. 마지막 연결 시도는 실패했지만 비밀번호는 삭제되지 않았습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved %@ App Password is available. The last connection attempt failed, but the password was not removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una App Password de %@ guardada disponible. El último intento de conexión falló, pero la contraseña no se eliminó."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの%@のApp Passwordを利用できます。前回の接続は失敗しましたが、パスワードは削除されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有保存的 %@ 应用专用密码。上次连接尝试失败，但密码未被移除。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mot de passe d’application %@ enregistré est disponible. La dernière tentative de connexion a échoué, mais le mot de passe n’a pas été supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È disponibile una password per app %@ salvata. L’ultimo tentativo di connessione non è riuscito, ma la password non è stata rimossa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gespeichertes App-Passwort für %@ ist verfügbar. Der letzte Verbindungsversuch ist fehlgeschlagen, das Passwort wurde jedoch nicht entfernt."
