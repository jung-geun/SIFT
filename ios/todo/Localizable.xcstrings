    },
    "legal.terms.ownership.userData": {
      "comment": "User-entered content ownership is unchanged by open-source licensing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data entered by users, such as to-dos and notes, belongs to the user and is not used by the operator for marketing or training."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이용자가 앱에 입력한 데이터(할 일·메모 등)는 이용자 본인의 소유이며, 운영자는 이를 마케팅·학습 등 목적으로 사용하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos introducidos por los usuarios, como tareas y notas, pertenecen al usuario y el operador no los utiliza con fines de marketing ni de entrenamiento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "To-Doやメモなど、ユーザーが入力したデータはユーザーに帰属し、運営者がマーケティングや学習に使用することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户输入的待办事项、备注等数据归用户所有，运营者不会将其用于营销或训练。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données saisies par les utilisateurs, telles que les tâches et les notes, appartiennent à l’utilisateur et ne sont pas utilisées par l’exploitant à des fins de marketing ou d’entraînement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati inseriti dagli utenti, come attività e note, appartengono all'utente e non vengono usati dal gestore per marketing o addestramento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Benutzer eingegebene Daten, etwa Aufgaben und Notizen, gehören dem Benutzer und werden vom Betreiber nicht für Marketing oder Training verwendet."
          }
        }
      }
    },
