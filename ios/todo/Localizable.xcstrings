    "legal.privacy.storage.cloudDetail" : {
      "comment" : "Full opt-in iCloud storage and device-local authorization boundaries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgaben, Personas, Prüfprotokolle und Verhaltensanalysen, E-Mail-Inhalte und Analysen, Besprechungsaudio und Transkripte, Sprecher und Bearbeitungen, Routinen, Wortschatz und Einstellungen – nur nach Zustimmung zum vollständigen Umfang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasks, personas, audit and behavior history, email content and analysis, meeting audio and transcripts, speakers and edits, routines, vocabulary and settings—only after full-scope consent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tareas, personas, historiales de auditoría y comportamiento, contenido y análisis de correos, audio y transcripciones de reuniones, hablantes y ediciones, rutinas, vocabulario y ajustes, solo tras consentir el alcance completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tâches, personas, historiques d’audit et de comportement, contenu et analyses des e-mails, audio et transcriptions des réunions, intervenants et modifications, routines, vocabulaire et réglages, uniquement après consentement à l’ensemble du périmètre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attività, personas, cronologia di audit e comportamento, contenuto e analisi delle email, audio e trascrizioni delle riunioni, parlanti e modifiche, routine, vocabolario e impostazioni, solo dopo il consenso all’intero ambito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タスク、ペルソナ、監査・行動履歴、メール本文と分析、会議の音声・文字起こし、話者と編集履歴、ルーティン、語彙、設定。全体の対象範囲に同意した場合のみ保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "할 일·페르소나·감사/행동 기록·메일 본문/분석·회의 음성/전사·화자/편집·루틴·학습 사전·설정 — 전체 범위에 동의한 경우에만 저장합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任务、角色、审计和行为历史、邮件内容与分析、会议音频与转写、说话人与编辑记录、例程、词汇和设置，仅在同意完整范围后存储。"
          }
        }
      }
    },
    "legal.privacy.storage.excluded" : {
      "comment" : "Full opt-in iCloud storage and device-local authorization boundaries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht in iCloud gespeichert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluded from iCloud storage"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluido del almacenamiento en iCloud"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
