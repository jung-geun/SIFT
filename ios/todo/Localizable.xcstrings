    "meeting.diarization.failedState": {
      "comment": "Saved-audio speaker analysis failed; older results remain.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker detection failed. Previous speaker results were kept; try again from the menu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화자 분석에 실패했습니다. 이전 결과는 유지되며 메뉴에서 다시 시도할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección de interlocutores ha fallado. Se conservaron los resultados anteriores; vuelve a intentarlo desde el menú."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話者検出に失敗しました。以前の話者検出結果は保持されています。メニューから再度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话人检测失败。已保留此前的说话人结果；请从菜单中重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection des intervenants a échoué. Les résultats précédents ont été conservés ; réessayez depuis le menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevamento degli interlocutori non riuscito. I risultati precedenti sono stati conservati; riprova dal menu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechererkennung fehlgeschlagen. Die bisherigen Sprecherergebnisse wurden beibehalten. Versuche es über das Menü erneut."
          }
        }
      }
    },
    "meeting.diarization.finalFailed": {
      "comment": "Non-fatal saved-audio speaker analysis error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker detection failed. The audio and transcript were saved; try again from the meeting detail."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화자 분석을 완료하지 못했습니다. 녹음과 전사는 저장되었습니다. 회의 기록에서 다시 시도할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección de interlocutores ha fallado. Se guardaron el audio y la transcripción; vuelve a intentarlo desde los detalles de la reunión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話者検出に失敗しました。音声と文字起こしは保存されました。会議の詳細画面から再度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话人检测失败。音频和转写文本已保存；请在会议详情中重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection des intervenants a échoué. L’audio et la transcription ont été enregistrés ; réessayez depuis les détails de la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevamento degli interlocutori non riuscito. L'audio e la trascrizione sono stati salvati; riprova dai dettagli della riunione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechererkennung fehlgeschlagen. Die Aufnahme und das Transkript wurden gespeichert. Versuche es in den Besprechungsdetails erneut."
          }
        }
      }
    },
    "meeting.diarization.interrupted": {
      "comment": "Non-fatal live speaker detection failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live speaker detection stopped. Recording and transcription continue; saved audio is analyzed after stopping."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 화자 감지가 중단되었습니다. 녹음과 전사는 계속되며 녹음 종료 후 저장된 음성으로 분석합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección de interlocutores en directo se ha detenido. La grabación y la transcripción continúan; el audio guardado se analizará cuando termine la grabación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアルタイムの話者検出が中断されました。録音と文字起こしは継続され、停止後に保存された音声から話者が分析されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时说话人检测已停止。录音和转写将继续；录音停止后会分析已保存的音频。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection des intervenants en direct s’est arrêtée. L’enregistrement et la transcription continuent ; l’audio sauvegardé sera analysé après l’arrêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rilevamento degli interlocutori in tempo reale si è interrotto. La registrazione e la trascrizione continuano; l'audio salvato verrà analizzato al termine della registrazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Sprechererkennung wurde unterbrochen. Aufnahme und Transkription laufen weiter. Das gespeicherte Audio wird nach dem Aufnahmeende analysiert."
          }
        }
      }
    },
