      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close Settings and tap Calendar in the tab bar to open the Calendar tab."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 설정을 닫고 탭바의 캘린더를 눌러 실제 캘린더 탭을 열어보세요."
          }
        }
      }
    },
    "tutorial.body.이제 설정을 닫고 할 일 탭으로 돌아가 AI 정리를 눌러보세요." : {
      "comment" : "Tutorial hint body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close Settings, return to To-Dos, and tap Prioritize with AI."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 설정을 닫고 할 일 탭으로 돌아가 AI 정리를 눌러보세요."
          }
        }
      }
    },
    "tutorial.body.탭바의 메일을 눌러 연결된 메일을 확인하는 화면을 열어보세요." : {
