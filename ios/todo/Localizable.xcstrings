    "meeting.conversation.explanation" : {
      "comment" : "Common-clock conversation display; audio and speaker identities remain source-local.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach gemeinsamer Aufnahmezeit sortiert. Überlappende Beiträge bleiben getrennt; gleiche Sprechernummern oder Namen aus verschiedenen Quellen bezeichnen nicht dieselbe Person."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordered by common recording time. Overlapping speech stays separate; matching speaker numbers or names across sources do not identify the same person."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordenada por el tiempo común de grabación. Las intervenciones superpuestas se mantienen separadas; los mismos números o nombres de hablante en distintas fuentes no identifican a la misma persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classée selon le temps commun d’enregistrement. Les paroles qui se chevauchent restent séparées ; des numéros ou noms de locuteur identiques entre sources ne désignent pas la même personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordinata in base al tempo comune di registrazione. Le voci sovrapposte restano separate; numeri o nomi di parlante uguali tra fonti non identificano la stessa persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共通の録音時刻順に表示します。重なった発話は別々に表示し、異なるソースの同じ話者番号や名前は同一人物を意味しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공통 녹음 시각 순서입니다. 겹치는 발화는 따로 표시하며, 같은 화자 번호·이름도 소스 간 동일 인물을 뜻하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按共同录音时间排序。重叠发言分别显示；不同来源中相同的说话人编号或姓名不代表同一个人。"
          }
        }
      }
    },
    "meeting.conversation.localTiming" : {
      "comment" : "Common-clock conversation display; audio and speaker identities remain source-local.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
