    "openai.models.notice" : {
      "comment" : "ChatGPT account model discovery and endpoint capability boundaries. Listing does not grant API permission.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nur die Modellliste des Kontos abgerufen. Es erfolgt weder eine Inferenz noch eine Übertragung gespeicherter App-Daten. Ein Listeneintrag gewährt nicht den Zugriff auf alle APIs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the account’s model list is retrieved; no inference or stored app data is sent. Being listed does not grant access to every API."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se consulta la lista de modelos de la cuenta; no se realizan inferencias ni se envían datos guardados de la app. Que un modelo aparezca en la lista no concede acceso a todas las API."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule la liste des modèles du compte est récupérée ; aucune inférence n’est effectuée et aucune donnée enregistrée de l’app n’est envoyée. La présence dans la liste ne donne pas accès à toutes les API."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene recuperato solo l’elenco dei modelli dell’account; non viene eseguita alcuna inferenza né vengono inviati dati salvati dell’app. La presenza nell’elenco non garantisce l’accesso a tutte le API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントのモデル一覧のみを取得します。推論の実行や保存済みアプリデータの送信は行いません。一覧に表示されても、すべてのAPIを利用できるとは限りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정의 모델 목록만 조회합니다. 추론이나 저장된 앱 데이터 전송은 없으며, 목록이 모든 API 사용 권한을 뜻하지는 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅查询账户的模型列表，不进行推理或发送应用中已保存的数据。模型列在列表中并不代表拥有所有 API 的访问权限。"
          }
        }
      }
    },
