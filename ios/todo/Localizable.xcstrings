    "mail.connection.automaticFooter": {
      "comment": "Gmail automatic analysis settings explanation.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'메일 자동 분석'을 켜면 연결된 Gmail을 분석해 할 일 후보를 자동으로 정리합니다. 실행 시각은 기기 상태나 네트워크 상황에 따라 달라질 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When 'Automatic Mail Analysis' is enabled, connected Gmail is analyzed and potential to-dos are organized automatically. The run time may vary depending on device and network conditions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activar «Análisis automático del correo», se analiza la cuenta de Gmail conectada y se organizan automáticamente las posibles tareas. El momento de ejecución puede variar según el estado del dispositivo y de la red."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メールの自動分析」をオンにすると、接続したGmailを分析し、タスク候補を自動で整理します。実行時刻はデバイスやネットワークの状態によって変わる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用“自动邮件分析”后，会自动分析已连接的 Gmail，并整理可能的待办事项。运行时间可能因设备和网络状况而异。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque l’analyse automatique des e-mails est activée, le compte Gmail connecté est analysé pour organiser automatiquement les tâches potentielles. L’heure d’exécution peut varier selon l’état de l’appareil et du réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilitando “Analisi automatica delle email”, Gmail collegato viene analizzato per organizzare automaticamente le possibili attività. L’orario di esecuzione può variare in base alle condizioni del dispositivo e della rete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn „Automatische E-Mail-Analyse“ aktiviert ist, wird das verbundene Gmail-Konto analysiert und mögliche Aufgaben werden automatisch geordnet. Der Ausführungszeitpunkt kann je nach Geräte- und Netzwerkzustand variieren."
          }
        }
      }
    },
