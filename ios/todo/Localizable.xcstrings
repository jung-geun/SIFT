      }
    },
    "legal.text.약관이 변경될 경우 앱 업데이트 노트 또는 앱 내 알림을 통해 최소 7일 전에 고지합니다. 변경된 약관의 시행일 이후 서비스를 계속 사용하면 변경 사항에 동의한 것으로 간주합니다." : {
      "comment" : "English legal translation preserving source meaning.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen der Bedingungen werden mindestens sieben Tage im Voraus in den App-Update-Hinweisen oder durch eine Mitteilung in der App angekündigt. Wenn du den Dienst nach dem Inkrafttreten weiter nutzt, gilt dies als Zustimmung zu den Änderungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the terms change, notice is provided at least seven days in advance in app update notes or an in-app notification. Continued use after the effective date means you accept the changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si las condiciones cambian, se avisará con al menos siete días de antelación en las notas de actualización de la app o mediante una notificación dentro de la app. Seguir utilizando el servicio después de la fecha de entrada en vigor implica la aceptación de los cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cas de modification des conditions, un préavis d’au moins sept jours est donné dans les notes de mise à jour de l’app ou par une notification dans l’app. En continuant à utiliser le service après la date d’entrée en vigueur, vous acceptez les modifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In caso di modifica delle condizioni, verrà fornito un preavviso di almeno sette giorni nelle note di aggiornamento dell'app o tramite una notifica nell'app. L'uso continuato dopo la data di entrata in vigore implica l'accettazione delle modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "規約を変更する場合、アプリのアップデート情報またはアプリ内通知で、少なくとも7日前にお知らせします。施行日以降も本サービスの利用を継続した場合、変更に同意したものとみなします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약관이 변경될 경우 앱 업데이트 노트 또는 앱 내 알림을 통해 최소 7일 전에 고지합니다. 변경된 약관의 시행일 이후 서비스를 계속 사용하면 변경 사항에 동의한 것으로 간주합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如条款发生变更，我们会至少提前七天通过 App 更新说明或 App 内通知告知。生效日期后继续使用本服务，即视为您接受相关变更。"
          }
        }
      }
    },
    "legal.text.약관이 변경될 경우 앱 업데이트 노트 또는 앱 내 알림을 통해 최소 7일 전에 고지합니다. 변경된 약관의 시행일 이후 서비스를 계속 사용하면 변경된 약관에 동의한 것으로 간주합니다." : {
      "comment" : "English legal translation preserving the Korean source structure and meaning.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen dieser Bedingungen werden mindestens sieben Tage im Voraus in den App-Update-Hinweisen oder durch eine Mitteilung in der App angekündigt. Wenn du den Dienst nach dem Inkrafttreten weiter nutzt, gilt dies als Zustimmung zu den geänderten Bedingungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If these terms change, notice is provided at least seven days in advance in app update notes or an in-app notification. Continued use after the effective date means you accept the changed terms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si estas condiciones cambian, se avisará con al menos siete días de antelación en las notas de actualización de la app o mediante una notificación dentro de la app. Seguir utilizando el servicio después de la fecha de entrada en vigor implica la aceptación de las condiciones modificadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cas de modification des présentes conditions, un préavis d’au moins sept jours est donné dans les notes de mise à jour de l’app ou par une notification dans l’app. En continuant à utiliser le service après la date d’entrée en vigueur, vous acceptez les conditions modifiées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In caso di modifica delle presenti condizioni, verrà fornito un preavviso di almeno sette giorni nelle note di aggiornamento dell'app o tramite una notifica nell'app. L'uso continuato dopo la data di entrata in vigore implica l'accettazione delle condizioni modificate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本規約を変更する場合、アプリのアップデート情報またはアプリ内通知で、少なくとも7日前にお知らせします。施行日以降も本サービスの利用を継続した場合、変更後の規約に同意したものとみなします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약관이 변경될 경우 앱 업데이트 노트 또는 앱 내 알림을 통해 최소 7일 전에 고지합니다. 변경된 약관의 시행일 이후 서비스를 계속 사용하면 변경된 약관에 동의한 것으로 간주합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如本条款发生变更，我们会至少提前七天通过 App 更新说明或 App 内通知告知。生效日期后继续使用本服务，即视为您同意变更后的条款。"
          }
        }
      }
    },
    "legal.text.연결 해제 시 토큰 제거, 계정 매핑은 재연결용 유지" : {
      "comment" : "English legal translation preserving source meaning.",
