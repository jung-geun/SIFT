    "legal.text.iOS 26.5 이상, 특정 기기 성능을 요구하는 온디바이스 AI 기능은 구형 기기에서 이용이 제한될 수 있습니다.": {
      "comment": "English legal translation preserving the Korean source structure and meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device AI features requiring iOS 26.5 or later and specific device performance may be limited on older devices."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26.5 이상, 특정 기기 성능을 요구하는 온디바이스 AI 기능은 구형 기기에서 이용이 제한될 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones de IA en el dispositivo que requieren iOS 26.5 o posterior y un rendimiento específico del dispositivo pueden estar limitadas en dispositivos antiguos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26.5以降や一定のデバイス性能を必要とするオンデバイスAI機能は、古いデバイスでは利用が制限される場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 iOS 26.5 或更高版本及特定设备性能的设备端 AI 功能，在较旧设备上可能受到限制。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctionnalités d’IA sur l’appareil nécessitant iOS 26.5 ou une version ultérieure et des performances matérielles spécifiques peuvent être limitées sur les appareils plus anciens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le funzionalità IA sul dispositivo che richiedono iOS 26.5 o versioni successive e determinate prestazioni hardware potrebbero essere limitate sui dispositivi meno recenti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Funktionen auf dem Gerät, die iOS 26.5 oder neuer und eine bestimmte Geräteleistung voraussetzen, sind auf älteren Geräten möglicherweise nur eingeschränkt verfügbar."
          }
        }
      }
    },
