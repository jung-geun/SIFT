            "state": "translated",
            "value": "Añadir plazos automáticamente al calendario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限をカレンダーに自動登録"
          }
        },
        "zh-Hans": {
