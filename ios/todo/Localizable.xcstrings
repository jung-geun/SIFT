          }
        }
      }
    },
    "meeting.error.processingSave": {
      "comment": "Meeting AI processing save failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI proofreading or summary could not be saved. Try processing again from the meeting menu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 검수 또는 요약을 저장하지 못했습니다. 회의 상단의 다시 정리 메뉴에서 다시 시도할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la corrección con IA o el resumen. Vuelve a procesar la reunión desde su menú."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI校正または要約を保存できませんでした。会議メニューから再処理をお試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存 AI 校对结果或摘要。请从会议菜单中重新处理。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La correction par IA ou le résumé n’a pas pu être enregistré. Relancez le traitement depuis le menu de la réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la revisione IA o il riepilogo. Riprova a elaborare la riunione dal relativo menu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI-Korrektur oder die Zusammenfassung konnte nicht gespeichert werden. Starte die Verarbeitung über das Besprechungsmenü erneut."
          }
        }
      }
    },
    "meeting.error.proofreadAfterRetry": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retranscription was saved, but AI proofreading or summary could not be completed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재전사는 저장했지만 AI 검수 또는 요약을 완료하지 못했습니다."
          }
        },
        "es": {
