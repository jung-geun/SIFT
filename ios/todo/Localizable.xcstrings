    "legal.terms.ownership.project": {
      "comment": "Original project copyright and Apache licensing; service terms must not narrow the license grant.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copyright in the original SIFT source code, documentation, and project assets remains with the respective copyright holders, with rights granted under Apache License 2.0. These terms do not restrict those license rights. See the project's LICENSE and NOTICE."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SIFT 자체 소스코드·문서·프로젝트 자산의 저작권은 해당 저작권자에게 있으며 Apache License 2.0의 이용 권한이 부여됩니다. 이 약관은 해당 라이선스의 권한을 제한하지 않습니다. 프로젝트의 LICENSE와 NOTICE를 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los derechos de autor del código fuente, la documentación y los recursos originales del proyecto SIFT siguen perteneciendo a sus respectivos titulares, con los derechos otorgados por Apache License 2.0. Estas condiciones no restringen los derechos de dicha licencia. Consulta los archivos LICENSE y NOTICE del proyecto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SIFT独自のソースコード、ドキュメント、プロジェクト資産の著作権は、それぞれの著作権者に帰属し、Apache License 2.0に基づく利用権が付与されます。本規約は、同ライセンスに基づく権利を制限しません。プロジェクトのLICENSEおよびNOTICEをご確認ください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SIFT 原创源代码、文档和项目资源的版权归各自的版权所有者所有，并依据 Apache License 2.0 授予使用权。本条款不限制该许可证授予的权利。请参阅项目的 LICENSE 和 NOTICE。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les droits d’auteur sur le code source original de SIFT, sa documentation et les ressources du projet restent la propriété de leurs titulaires respectifs, les droits d’utilisation étant accordés sous la licence Apache License 2.0. Les présentes conditions ne limitent pas les droits accordés par cette licence. Consultez les fichiers LICENSE et NOTICE du projet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I diritti d'autore sul codice sorgente originale, sulla documentazione e sulle risorse del progetto SIFT rimangono ai rispettivi titolari, con i diritti concessi ai sensi della Apache License 2.0. Queste condizioni non limitano tali diritti di licenza. Consulta i file LICENSE e NOTICE del progetto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Urheberrecht am ursprünglichen SIFT-Quellcode, an der Dokumentation und an den Projektmaterialien verbleibt bei den jeweiligen Rechteinhabern; Nutzungsrechte werden gemäß Apache License 2.0 eingeräumt. Diese Bedingungen schränken diese Lizenzrechte nicht ein. Siehe LICENSE und NOTICE des Projekts."
          }
        }
      }
    },
    "legal.terms.ownership.thirdParty": {
      "comment": "Third-party software, model, asset and service terms remain separate from SIFT's Apache license.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Third-party libraries, model weights, icons, and other material retain their respective licenses and are not relicensed by SIFT's adoption of Apache-2.0. Access to Apple, Google, Microsoft, and OpenAI services is also governed by each provider's terms."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제3자 라이브러리·모델 가중치·아이콘 등은 각 저작권자의 별도 라이선스를 따르며, SIFT의 Apache-2.0 전환으로 재라이선스되지 않습니다. Apple·Google·Microsoft·OpenAI 서비스의 이용 권한도 각 제공사의 조건을 따릅니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las bibliotecas, los pesos de modelos, los iconos y otros materiales de terceros conservan sus respectivas licencias y no cambian de licencia por la adopción de Apache-2.0 por parte de SIFT. El acceso a los servicios de Apple, Google, Microsoft y OpenAI también está sujeto a las condiciones de cada proveedor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サードパーティ製ライブラリ、モデルの重み、アイコン、その他の素材には、それぞれのライセンスが引き続き適用され、SIFTによるApache-2.0の採用によって再ライセンスされることはありません。Apple、Google、Microsoft、OpenAIのサービスへのアクセスには、各提供者の規約も適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三方库、模型权重、图标及其他材料仍适用其各自的许可证，不会因 SIFT 采用 Apache-2.0 而重新授权。访问 Apple、Google、Microsoft 和 OpenAI 服务也须遵守各提供商的条款。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bibliothèques, poids de modèles, icônes et autres éléments de tiers conservent leurs licences respectives et ne changent pas de licence du fait de l’adoption d’Apache-2.0 par SIFT. L’accès aux services d’Apple, Google, Microsoft et OpenAI est également régi par les conditions de chaque fournisseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le librerie di terze parti, i pesi dei modelli, le icone e gli altri materiali mantengono le rispettive licenze e non vengono concessi con una nuova licenza in seguito all'adozione di Apache-2.0 da parte di SIFT. L'accesso ai servizi Apple, Google, Microsoft e OpenAI è inoltre disciplinato dalle condizioni di ciascun fornitore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliotheken, Modellgewichte, Symbole und sonstige Materialien Dritter unterliegen weiterhin ihren jeweiligen Lizenzen und werden durch SIFTs Übernahme von Apache-2.0 nicht neu lizenziert. Der Zugang zu Diensten von Apple, Google, Microsoft und OpenAI unterliegt außerdem den Bedingungen des jeweiligen Anbieters."
          }
        }
      }
    },
    "legal.terms.ownership.trademarks": {
      "comment": "Apache-2.0 does not grant trademark rights or imply endorsement.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apache License 2.0 does not grant permission to use SIFT or third-party trademarks or imply affiliation with the official app or its operator."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apache License 2.0은 SIFT 또는 제3자의 상표 사용 권한이나 공식 앱·운영자와의 제휴를 보장하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apache License 2.0 no concede permiso para usar las marcas comerciales de SIFT o de terceros ni implica afiliación con la app oficial o su operador."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apache License 2.0は、SIFTまたは第三者の商標を使用する権利を付与するものではなく、公式アプリやその運営者との提携を示唆するものでもありません。"
