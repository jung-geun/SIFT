    "openai.settings.models": {
      "comment": "OpenAI settings and data-sharing consent copy.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기초 분석: gpt-6-luna\n직접 누른 고급 재요청: gpt-6.1-sol"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic analysis: gpt-6-luna\nExplicit advanced re-request: gpt-6.1-sol"
          }
        },
        "es": {
          "stringUnit": {
