          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acceptation de routine en attente est introuvable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accettazione della routine in sospeso non trovata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausstehende Routinenannahme wurde nicht gefunden."
          }
        }
      }
    },
    "error.routine.duplicateOccurrence": {
      "comment": "Routine store error preventing a duplicate task or decision for an occurrence.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This routine occurrence already has a task or decision."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 루틴 회차에는 이미 할 일이나 결정이 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta repetición de la rutina ya tiene una tarea o una decisión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルーティンの実施回には、すでにタスクまたは判断の記録があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次日常规律安排已有待办事项或决定。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette occurrence de routine a déjà une tâche ou une décision."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa occorrenza della routine ha già un’attività o una decisione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Routinentermin gibt es bereits eine Aufgabe oder Entscheidung."
          }
        }
      }
    },
    "error.routine.invalidFeedback": {
      "comment": "Routine store error for incomplete or conflicting occurrence feedback.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The routine feedback is incomplete or conflicts with an accepted occurrence."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴 피드백이 불완전하거나 이미 수락한 회차와 충돌합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comentarios sobre la rutina están incompletos o entran en conflicto con una repetición aceptada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティンのフィードバックが不完全か、受け入れ済みの実施回と矛盾しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日常规律反馈不完整，或与已接受的某次安排冲突。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retour sur la routine est incomplet ou entre en conflit avec une occurrence acceptée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il feedback sulla routine è incompleto o è in conflitto con un’occorrenza accettata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Rückmeldung zur Routine ist unvollständig oder widerspricht einem angenommenen Termin."
          }
        }
      }
    },
    "error.routine.invalidRoutine": {
      "comment": "Routine store error for invalid editable scheduling fields.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The routine needs a title, valid local time, period and duration."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴에 제목과 올바른 현지 시간, 반복 주기, 소요 시간이 필요합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La rutina necesita un título y valores válidos de hora local, frecuencia y duración."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティンには活動名と、有効な現地時刻、周期、所要時間が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日常规律需要标题、有效的本地时间、重复周期和持续时长。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La routine nécessite un titre, une heure locale valide, une période et une durée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La routine richiede un titolo, un orario locale valido, una frequenza e una durata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Routine benötigt einen Titel, eine gültige Ortszeit, ein Wiederholungsintervall und eine Dauer."
          }
        }
      }
    },
    "error.routine.learningDisabled": {
