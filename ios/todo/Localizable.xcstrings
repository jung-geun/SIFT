    "error.routine.saveFailed": {
      "comment": "Generic routine store write error; never include paths or underlying diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local routine change could not be saved. Please try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 루틴 변경 사항을 저장할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el cambio local de la rutina. Vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのルーティンの変更を保存できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存本地日常规律更改。请重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la modification locale de la routine. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la modifica locale alla routine. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokale Routinenänderung konnte nicht gespeichert werden. Bitte versuche es erneut."
          }
        }
      }
    },
    "error.routine.staleSuggestion": {
      "comment": "Routine store error when a suggestion changed before acceptance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The routine suggestion changed. Refresh it before accepting."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴 제안이 변경되었습니다. 수락하기 전에 새로고침해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sugerencia de rutina ha cambiado. Actualízala antes de aceptarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティンの提案が変更されました。受け入れる前に更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日常规律建议已更改。请刷新后再接受。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suggestion de routine a changé. Actualisez-la avant de l’accepter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suggerimento della routine è cambiato. Aggiornalo prima di accettare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Routinenvorschlag hat sich geändert. Aktualisiere ihn vor der Annahme."
          }
        }
      }
    },
    "error.routine.storeUnavailable": {
      "comment": "Generic routine store read error; never include paths or underlying diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local routine store could not be read. No changes were saved."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 루틴 저장소를 읽을 수 없습니다. 변경 사항은 저장되지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el almacén local de rutinas. No se guardó ningún cambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのルーティン保存領域を読み込めませんでした。変更は保存されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取本地日常规律存储。未保存任何更改。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le stockage local des routines. Aucune modification n’a été enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l’archivio locale delle routine. Nessuna modifica è stata salvata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Routinenspeicher konnte nicht gelesen werden. Es wurden keine Änderungen gespeichert."
          }
        }
      }
    },
    "error.routine.unreliableSchedule": {
      "comment": "Routine confirmation error requiring a manual schedule for irregular evidence.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The completion intervals are irregular. Edit the recurrence or preferred time before confirming."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 간격이 불규칙합니다. 확정하기 전에 반복 주기나 선호 시간을 수정해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intervalos de finalización son irregulares. Edita la frecuencia o la hora preferida antes de confirmar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了の間隔が不規則です。確定する前に、繰り返しや希望時刻を編集してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成记录的时间间隔不规律。请在确认前修改重复周期或首选时间。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intervalles entre validations sont irréguliers. Modifiez la récurrence ou l’heure souhaitée avant de confirmer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli intervalli tra i completamenti sono irregolari. Modifica la frequenza o l’orario preferito prima di confermare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erledigungsabstände sind unregelmäßig. Ändere vor der Bestätigung die Wiederholung oder die bevorzugte Uhrzeit."
          }
        }
      }
    },
