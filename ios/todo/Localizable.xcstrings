    "meeting.whisper.summary" : {
      "comment" : "Native settings and analysis copy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Stoppen transkribiert ein größeres Whisper-Modell die gespeicherte Aufnahme erneut. Das benötigt mehr Akku und Zeit. Das ca. 631 MB große Modell muss manuell installiert werden; Apples Live-Transkription bleibt bestehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After you stop, a larger Whisper model retranscribes saved audio. This uses more battery and time. Install the ~631 MB model manually; Apple live transcription is retained."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al detener la grabación, un modelo Whisper más grande vuelve a transcribir el audio guardado. Requiere más batería y tiempo. Instala manualmente el modelo de unos 631 MB; se mantiene la transcripción en directo de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l’arrêt de l’enregistrement, un modèle Whisper plus volumineux retranscrit l’audio enregistré. Cela demande plus de batterie et de temps. Installez manuellement le modèle d’environ 631 MB ; la transcription en direct d’Apple est conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al termine della registrazione, un modello Whisper più grande trascrive di nuovo l’audio salvato. Richiede più batteria e tempo. Installa manualmente il modello da circa 631 MB; la trascrizione in tempo reale di Apple resta invariata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音終了後、より大きなWhisperモデルで保存済みの音声を再文字起こしします。より多くのバッテリーと時間が必要です。約631 MBのモデルは手動でインストールしてください。Appleのリアルタイム文字起こしは引き続き使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음 종료 후 더 큰 Whisper 모델로 저장 음성을 다시 전사합니다. 배터리와 시간이 더 필요합니다. 약 631 MB 모델은 직접 설치해야 하며 Apple 실시간 전사는 그대로 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止录音后，使用更大的 Whisper 模型重新转写已保存的音频，需要更多电量和时间。约 631 MB 的模型需手动安装；Apple 实时转写保持不变。"
          }
        }
      }
    },
