            "value" : "사용자 동의형 로컬 진단 로그"
          }
        }
      }
    },
    "legal.privacy.diagnostics.storage" : {
      "comment" : "Privacy policy diagnostic storage and deletion terms.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept in a limited on-device, backup-excluded, file-protected store only after explicit consent; removed immediately when consent is withdrawn or logs are deleted"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
