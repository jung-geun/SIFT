    "meeting.audioImport.error.cleanupFailed": {
      "comment": "Audio import rollback could not remove new app-owned files; original document remains unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기를 중단했지만 새 로컬 파일을 정리하지 못했습니다. 원본 파일은 변경하지 않았습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import stopped, but its new local files could not be removed. The original file was not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación se detuvo, pero no se pudieron eliminar los nuevos archivos locales. El archivo original no se ha modificado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込みは停止しましたが、新しく作成したローカルファイルを削除できませんでした。元のファイルは変更されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入已停止，但无法移除新生成的本地文件。原始文件未被更改。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importation s’est arrêtée, mais ses nouveaux fichiers locaux n’ont pas pu être supprimés. Le fichier original n’a pas été modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importazione si è interrotta, ma non è stato possibile rimuovere i nuovi file locali. Il file originale non è stato modificato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Import wurde gestoppt, seine neuen lokalen Dateien konnten jedoch nicht entfernt werden. Die Originaldatei wurde nicht verändert."
          }
        }
      }
    },
    "meeting.audioImport.error.decodeFailed": {
      "comment": "Audio import failed atomically while decoding; no meeting was created.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
