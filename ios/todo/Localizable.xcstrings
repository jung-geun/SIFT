      }
    },
    "health.sources.explanation" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkannte Quellen sind standardmäßig deaktiviert. Genehmige jede Quelle, der du für das Erlernen von Routinen vertraust, einzeln. Die Genehmigung allein bestätigt keine Routine und erlaubt keine Aufgabenerstellung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discovered sources are off by default. Approve each source you trust for learning; approval alone does not confirm a routine or allow task creation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los orígenes detectados están desactivados de forma predeterminada. Aprueba cada origen en el que confíes para aprender tus hábitos; la aprobación por sí sola no confirma ninguna rutina ni permite crear tareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sources détectées sont désactivées par défaut. Approuvez chaque source de confiance pour l’apprentissage de vos habitudes ; l’approbation seule ne confirme aucune routine et n’autorise pas la création de tâches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le origini rilevate sono disattivate per impostazione predefinita. Approva ogni origine di cui ti fidi per l’apprendimento delle tue abitudini; la sola approvazione non conferma una routine né consente la creazione di attività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検出されたデータ提供元は、デフォルトでは無効です。学習に使用してよいと信頼できるデータ提供元を、それぞれ承認してください。データ提供元を承認するだけでは、ルーティンの確定やタスクの作成の許可にはなりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "발견된 출처는 기본적으로 꺼져 있습니다. 학습에 사용할 신뢰하는 출처를 각각 승인하세요. 출처 승인만으로 루틴이 확정되거나 할 일이 생성되지는 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发现的数据来源默认处于关闭状态。请逐一批准你信任并愿意用于学习的来源。仅批准来源不会确认日常计划，也不会授权创建待办事项。"
          }
        }
      }
    },
