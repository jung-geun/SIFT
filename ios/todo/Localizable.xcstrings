    "meeting.audioImport.error.storageFailed": {
      "comment": "Audio import could not save its local recording.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 녹음을 저장하지 못했습니다. 기기 저장 공간을 확인하고 다시 시도하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The imported recording could not be saved. Check available device storage and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la grabación importada. Comprueba el espacio de almacenamiento disponible en el dispositivo e inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込んだ録音を保存できませんでした。デバイスの空き容量を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存导入的录音。请检查设备可用存储空间，然后重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement importé n’a pas pu être sauvegardé. Vérifiez l’espace disponible sur l’appareil et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la registrazione importata. Controlla lo spazio disponibile sul dispositivo e riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die importierte Aufnahme konnte nicht gespeichert werden. Prüfe den verfügbaren Gerätespeicher und versuche es erneut."
          }
        }
      }
    },
    "meeting.audioImport.error.unavailableInput": {
      "comment": "Audio import cannot access the selected Files document.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 파일을 읽을 수 없습니다. 파일 앱에서 다운로드한 후 다시 선택하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected file is unavailable or unreadable. Download it in Files and select it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo seleccionado no está disponible o no se puede leer. Descárgalo en Archivos y vuelve a seleccionarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファイルが利用できないか、読み取れません。「ファイル」アプリでダウンロードしてから、もう一度選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件不可用或无法读取。请在“文件”App 中下载该文件，然后重新选择。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier sélectionné est indisponible ou illisible. Téléchargez-le dans Fichiers et sélectionnez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file selezionato non è disponibile o leggibile. Scaricalo in File e selezionalo di nuovo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Datei ist nicht verfügbar oder nicht lesbar. Lade sie in „Dateien“ herunter und wähle sie erneut aus."
          }
        }
      }
    },
    "meeting.audioImport.error.unsupportedAudio": {
      "comment": "Audio import requires an audio format supported by the device decoder; preserve format names.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 해독할 수 없는 오디오입니다. WAV, M4A, MP3, AIFF, CAF 또는 FLAC 파일을 선택하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file cannot be decoded as audio on this device. Try WAV, M4A, MP3, AIFF, CAF, or FLAC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no se puede decodificar como audio en este dispositivo. Prueba con WAV, M4A, MP3, AIFF, CAF o FLAC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは、このファイルを音声としてデコードできません。WAV、M4A、MP3、AIFF、CAF、FLACのいずれかをお試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法将该文件解码为音频。请尝试 WAV、M4A、MP3、AIFF、CAF 或 FLAC 格式。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne peut pas être décodé en audio sur cet appareil. Essayez WAV, M4A, MP3, AIFF, CAF ou FLAC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non può essere decodificato come audio su questo dispositivo. Prova WAV, M4A, MP3, AIFF, CAF o FLAC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei kann auf diesem Gerät nicht als Audio decodiert werden. Versuche WAV, M4A, MP3, AIFF, CAF oder FLAC."
          }
        }
      }
    },
    "meeting.audioImport.explanation": {
      "comment": "Local audio import privacy and processing explanation.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 파일을 선택해 로컬 회의로 복사합니다. 원본은 변경하지 않습니다. 변환과 전사는 이 기기에서 실행하며 마이크 권한이나 서버 업로드가 필요하지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an audio file to copy into a local meeting. The original stays untouched. Audio conversion and transcription run on this device; no microphone access or server upload is needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un archivo de audio para copiarlo a una reunión local. El original no se modifica. La conversión y la transcripción del audio se realizan en este dispositivo; no se necesita acceso al micrófono ni subir datos a un servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声ファイルを選択して、ローカルの会議にコピーします。元のファイルは変更されません。音声の変換と文字起こしはこのデバイス内で行われ、マイクへのアクセスやサーバーへのアップロードは不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择音频文件，将其复制到本地会议中。原始文件不会更改。音频转换和转写均在此设备上进行，无需麦克风权限，也无需上传至服务器。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier audio à copier dans une réunion locale. L’original reste intact. La conversion audio et la transcription s’effectuent sur cet appareil ; aucun accès au microphone ni envoi vers un serveur n’est nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un file audio da copiare in una riunione locale. L’originale resta invariato. Conversione audio e trascrizione avvengono su questo dispositivo, senza accesso al microfono né caricamento su server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Audiodatei aus, um sie in eine lokale Besprechung zu kopieren. Das Original bleibt unverändert. Audiokonvertierung und Transkription erfolgen auf diesem Gerät; Mikrofonzugriff oder ein Server-Upload sind nicht erforderlich."
          }
        }
      }
    },
    "meeting.audioImport.formats": {
      "comment": "Supported audio import formats remain subject to device support.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기가 지원하는 M4A, MP3, WAV, AIFF, CAF, FLAC 등의 오디오를 최대 6시간까지 가져옵니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common formats include M4A, MP3, WAV, AIFF, CAF, and FLAC, when supported by this device. Maximum duration: 6 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre los formatos habituales están M4A, MP3, WAV, AIFF, CAF y FLAC, siempre que este dispositivo los admita. Duración máxima: 6 horas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスが対応している場合、M4A、MP3、WAV、AIFF、CAF、FLACなどの一般的な形式を読み込めます。最長6時間です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备支持时，可导入 M4A、MP3、WAV、AIFF、CAF 和 FLAC 等常见格式。最长时长：6 小时。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les formats courants incluent M4A, MP3, WAV, AIFF, CAF et FLAC, selon leur prise en charge par cet appareil. Durée maximale : 6 heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I formati più comuni includono M4A, MP3, WAV, AIFF, CAF e FLAC, se supportati da questo dispositivo. Durata massima: 6 ore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gängige Formate sind M4A, MP3, WAV, AIFF, CAF und FLAC, sofern dieses Gerät sie unterstützt. Maximale Dauer: 6 Stunden."
          }
        }
      }
    },
