    "diagnostics.recovery.detail" : {
      "comment" : "Unexpected termination recovery explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die letzte aktive Sitzung hat keine normale Deaktivierung aufgezeichnet. Dies bestätigt keinen Absturz. Erlaube die Diagnoseerfassung, um auf diesem Gerät einen minimalen Bericht über dieses Beendigungssignal zu erstellen. Die App sendet nie Informationen ohne deine Einwilligung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The previous active session did not record a normal deactivation. This does not confirm a crash. Allow diagnostic collection to create a minimal on-device report about this termination signal. The app never sends information without your consent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión activa anterior no registró una desactivación normal. Esto no confirma un cierre inesperado. Permite recopilar diagnósticos para crear en el dispositivo un informe mínimo sobre este indicio de terminación. La app nunca envía información sin tu consentimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session active précédente n’a pas enregistré de désactivation normale. Cela ne confirme pas un plantage. Autorisez la collecte des diagnostics pour créer sur cet appareil un rapport minimal sur ce signe d’arrêt. L’app ne transmet jamais d’informations sans votre consentement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La precedente sessione attiva non ha registrato una normale disattivazione. Ciò non conferma un arresto anomalo. Consenti la raccolta diagnostica per creare sul dispositivo un rapporto minimo su questo segnale di chiusura. L’app non invia mai informazioni senza il tuo consenso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回のアクティブなセッションでは、通常の非アクティブ化が記録されていません。これはクラッシュを断定するものではありません。診断情報の収集を許可すると、この終了の兆候について最小限のレポートをデバイス内に作成できます。アプリは同意なく情報を送信することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 활성 세션이 일반적인 비활성 전환을 기록하지 못했습니다. 이는 충돌을 확정하지 않습니다. 진단 로그 수집을 허용하면 이 종료 징후만 포함한 최소 보고서를 이 기기에 만들 수 있습니다. 앱은 사용자의 동의 없이 정보를 전송하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次活跃会话未记录到正常的停用过程。这并不能确认发生了崩溃。允许收集诊断信息后，可在设备端创建仅包含此终止迹象的最小报告。应用绝不会在未经您同意的情况下发送信息。"
          }
        }
      }
    },
    "diagnostics.recovery.title" : {
      "comment" : "Unexpected termination recovery section title.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederherstellung der letzten Sitzung"
          }
        },
        "en" : {
