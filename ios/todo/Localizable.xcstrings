          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te han invitado a compartir el calendario %@. Acepta la invitación para participar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダー「%@」の共有に招待されました。参加するには招待を承認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
