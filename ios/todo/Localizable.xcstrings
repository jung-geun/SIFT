          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の「その他」>「設定」をタップし、「システムの権限と状態」を確認してみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点右上角的“更多 > 设置”，然后查看“系统权限与状态”。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Plus > Réglages en haut à droite, puis consultez Autorisations et état du système."
          }
        },
        "it": {
