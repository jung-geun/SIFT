            "state": "translated",
            "value": "Tap More > Settings in the upper right, then review My Persona."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Más > Ajustes en la esquina superior derecha y revisa Mi perfil personal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の「その他」>「設定」をタップし、「マイペルソナ」を確認してみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点右上角的“更多 > 设置”，然后查看“我的个人画像”。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Plus > Réglages en haut à droite, puis consultez Mon profil personnel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
