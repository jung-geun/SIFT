    "beta.voiceProcessing.description" : {
      "comment" : "Device-local optional voice noise reduction; off by default, raw input when disabled.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduziert Echo und Rauschen mit Apples Sprachverarbeitung. Deaktivieren, um das Originalsignal aufzunehmen. Änderungen gelten ab der nächsten Aufnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduces echo and noise with Apple voice processing. Turn off to record the original input. Changes apply to the next recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce el eco y el ruido con el procesamiento de voz de Apple. Desactívalo para grabar la entrada original. Los cambios se aplican a la próxima grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduit l’écho et le bruit grâce au traitement vocal d’Apple. Désactivez cette option pour enregistrer le signal d’origine. Les changements s’appliquent au prochain enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduce eco e rumore con l’elaborazione vocale di Apple. Disattiva l’opzione per registrare il segnale originale. Le modifiche si applicano alla prossima registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleの音声処理でエコーとノイズを抑えます。オフにすると元の入力音声を録音します。変更は次の録音から適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 음성 처리로 에코와 잡음을 줄입니다. 끄면 원본 입력으로 녹음합니다. 변경은 다음 녹음부터 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Apple 语音处理减少回声和噪声。关闭后录制原始输入音频。更改从下次录音起生效。"
          }
        }
      }
    },
