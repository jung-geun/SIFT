    "100%는 원본 · 미만은 감쇠 · 초과는 증폭": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "100% is original · below 100% attenuates · above 100% amplifies"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "100%는 원본 · 미만은 감쇠 · 초과는 증폭"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "100% es el original · menos del 100% atenúa · más del 100% amplifica"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100%は元の音量 · 100%未満は減衰 · 100%超は増幅"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 为原始音量 · 低于 100% 为衰减 · 高于 100% 为放大"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "100% : volume d’origine · moins : atténuation · plus : amplification"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "100% è l’originale · sotto il 100% attenua · sopra il 100% amplifica"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "100% ist das Original · darunter Dämpfung · darüber Verstärkung"
          }
        }
      }
    },
    "100%를 넘는 증폭은 왜곡될 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplification above 100% may distort the audio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "100%를 넘는 증폭은 왜곡될 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una amplificación superior al 100% puede distorsionar el audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100%を超える増幅では、音声がひずむ場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大至超过 100% 可能导致音频失真。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une amplification au-delà de 100% peut déformer l’audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’amplificazione oltre il 100% può distorcere l’audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Verstärkung über 100% kann den Ton verzerren."
          }
        }
      }
    },
    "A saved %@ App Password is available. The last connection attempt failed, but the password was not removed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved %@ App Password is available. The last connection attempt failed, but the password was not removed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 %@ App Password가 있습니다. 마지막 연결 시도는 실패했지만 비밀번호는 삭제되지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una App Password de %@ guardada disponible. El último intento de conexión falló, pero la contraseña no se eliminó."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの%@のApp Passwordを利用できます。前回の接続は失敗しましたが、パスワードは削除されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有保存的 %@ 应用专用密码。上次连接尝试失败，但密码未被移除。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mot de passe d’application %@ enregistré est disponible. La dernière tentative de connexion a échoué, mais le mot de passe n’a pas été supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È disponibile una password per app %@ salvata. L’ultimo tentativo di connessione non è riuscito, ma la password non è stata rimossa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gespeichertes App-Passwort für %@ ist verfügbar. Der letzte Verbindungsversuch ist fehlgeschlagen, das Passwort wurde jedoch nicht entfernt."
          }
        }
      }
    },
