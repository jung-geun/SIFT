    "beta.warning": {
      "comment": "Beta feature warning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beta features are experimental and may be inaccurate or unavailable for some devices, languages, or data. Enable only the providers you need."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "베타 기능은 실험 중이며 일부 기기·언어·데이터에서 부정확하거나 동작하지 않을 수 있습니다. 필요한 provider만 직접 켜세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones beta son experimentales y pueden ser imprecisas o no estar disponibles para algunos dispositivos, idiomas o datos. Activa solo los proveedores que necesites."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベータ機能は実験中のため、一部のデバイス、言語、データでは不正確だったり、利用できなかったりする場合があります。必要なプロバイダのみを有効にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试版功能尚处于实验阶段，可能在某些设备、语言或数据上不准确或不可用。请仅启用所需的提供商。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctionnalités bêta sont expérimentales et peuvent être imprécises ou indisponibles pour certains appareils, langues ou données. Activez uniquement les fournisseurs dont vous avez besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le funzioni beta sono sperimentali e potrebbero essere imprecise o non disponibili per alcuni dispositivi, lingue o dati. Abilita solo i fornitori necessari."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beta-Funktionen sind experimentell und können auf manchen Geräten, für bestimmte Sprachen oder Daten ungenau oder nicht verfügbar sein. Aktiviere nur die benötigten Anbieter."
          }
        }
      }
    },
