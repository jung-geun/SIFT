    "feedback.receipt.detail" : {
      "comment" : "Private SIFT feedback flow. Preserve explicit consent and privacy disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Feedback wurde im privaten SIFT-Postfach gespeichert. Bewahre diese Bestätigung für deine Unterlagen auf; es erfolgt keine individuelle Antwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your feedback was saved to the private SIFT inbox. Keep this receipt for your records; no individual reply is provided."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus comentarios se han guardado en el buzón privado de SIFT. Conserva este recibo como comprobante; no se ofrece una respuesta individual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre commentaire a été enregistré dans la boîte de réception privée de SIFT. Conservez cet accusé de réception pour vos archives ; aucune réponse individuelle n’est fournie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo feedback è stato salvato nella casella privata di SIFT. Conserva questa ricevuta per i tuoi archivi; non viene fornita una risposta individuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードバックはSIFTの非公開の受信箱に保存されました。記録としてこの受付票を保管してください。個別の返信は行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의견이 비공개 SIFT 수신함에 저장되었습니다. 기록용으로 이 접수증을 보관하세요. 개별 답변은 제공하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
