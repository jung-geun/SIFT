    "아직 분석 데이터가 없습니다. 할 일을 완료한 후 분석을 실행하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no analysis data yet. Complete some to-dos, then run analysis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 분석 데이터가 없습니다. 할 일을 완료한 후 분석을 실행하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay datos de análisis. Completa algunas tareas y, después, ejecuta el análisis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分析データはまだありません。To-Doを完了してから分析を実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无分析数据。请先完成一些待办事项，再运行分析。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée d’analyse pour le moment. Terminez quelques tâches, puis lancez l’analyse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora dati da analizzare. Completa alcune attività, poi avvia l'analisi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es liegen noch keine Analysedaten vor. Erledige einige Aufgaben und starte dann die Analyse."
          }
        }
      }
    },
    "아직 불러오지 않은 이전 메일이 있으면 목록 아래에서 계속 불러올 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If older mail has not been loaded, you can continue loading it below the list."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 불러오지 않은 이전 메일이 있으면 목록 아래에서 계속 불러올 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quedan correos antiguos sin cargar, puedes seguir cargándolos debajo de la lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ読み込まれていない古いメールがある場合は、リストの下から続けて読み込めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果还有尚未加载的较早邮件，你可以在列表底部继续加载。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si des e-mails plus anciens n’ont pas encore été chargés, vous pouvez poursuivre leur chargement sous la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ci sono email meno recenti non ancora caricate, puoi continuare a caricarle in fondo all'elenco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls ältere E-Mails noch nicht geladen wurden, kannst du sie unterhalb der Liste weiter laden."
          }
        }
      }
    },
