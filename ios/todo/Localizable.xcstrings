    "legal.text.제3자 서비스 이용으로 발생하는 책임은 해당 제공사와의 관계에서 이용자가 직접 부담합니다.": {
      "comment": "English legal translation preserving the Korean source structure and meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The user bears responsibility arising from third-party service use in their relationship with the provider."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제3자 서비스 이용으로 발생하는 책임은 해당 제공사와의 관계에서 이용자가 직접 부담합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El usuario asume directamente la responsabilidad derivada del uso de servicios de terceros en su relación con el proveedor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第三者サービスの利用により生じる責任は、当該提供者との関係においてユーザーが直接負うものとします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因使用第三方服务而产生的责任，由用户在与该提供商的关系中自行承担。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilisateur assume directement la responsabilité découlant de l’utilisation des services tiers dans sa relation avec leur fournisseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'utente si assume direttamente le responsabilità derivanti dall'uso di servizi di terze parti nel rapporto con il relativo fornitore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verantwortung aus der Nutzung von Diensten Dritter trägt der Benutzer selbst im Verhältnis zum jeweiligen Anbieter."
          }
        }
      }
    },
