            "state" : "translated",
            "value" : "Aktive Aufgaben können später nur dann exportiert werden, wenn der automatische Export aktiviert ist und ihre Quelle deinem Filter entspricht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active to-dos may be exported later only when automatic export is enabled and their source matches your filter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tareas activas solo podrán exportarse más adelante si la exportación automática está activada y su origen coincide con tu filtro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tâches actives ne pourront être exportées ultérieurement que si l’exportation automatique est activée et que leur source correspond à votre filtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le attività attive potranno essere esportate in seguito solo se l’esportazione automatica è attiva e la loro origine corrisponde al filtro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動書き出しが有効で、タスクの作成元がフィルター条件に一致する場合に限り、進行中のタスクが後で書き出されることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 캘린더 등록에 동의한 경우에만, 출처 필터에 맞는 진행중 할 일이 나중에 자동 등록됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
