    "todo.settings.notifications.footer" : {
      "comment" : "Notification permission does not create reminders; denied permission is changed in system app settings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch mit erteilter Berechtigung richten sich Benachrichtigungen nach den Erinnerungen der jeweiligen Aufgabe. Wurde die Berechtigung verweigert, ändere sie in den Systemeinstellungen der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even with permission, notifications follow the reminders configured for each to-do. If permission was denied, change it in the app’s system settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque concedas el permiso, las notificaciones siguen los recordatorios configurados en cada tarea. Si se denegó el permiso, cámbialo en los ajustes del sistema de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même avec votre autorisation, les notifications suivent les rappels définis pour chaque tâche. Si l’autorisation a été refusée, modifiez-la dans les réglages système de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche con l’autorizzazione, le notifiche seguono i promemoria impostati per ogni attività. Se l’autorizzazione è stata negata, modificala nelle impostazioni di sistema dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知を許可しても、各タスクで設定したリマインダーに従って通知されます。許可を拒否した場合は、システムのアプリ設定で変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한을 허용해도 할 일에서 설정한 미리 알림에 따라 알림을 보냅니다. 거부된 경우 앱 시스템 설정에서 변경하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使已授予权限，通知也会按照各待办事项中设置的提醒发送。如果已拒绝权限，请在系统的应用设置中更改。"
          }
        }
      }
    },
