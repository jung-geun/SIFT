    "%@ 모델을 기기에 다운로드합니다. Wi-Fi 환경에서 진행을 권장하며, 모든 추론은 기기 내에서만 이루어집니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade das Modell %@ auf dieses Gerät herunter. WLAN wird empfohlen; alle Inferenzen erfolgen auf dem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download the %@ model to this device. Wi-Fi is recommended, and all inference runs on device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga el modelo %@ en este dispositivo. Se recomienda usar Wi-Fi y toda la inferencia se realiza en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez le modèle %@ sur cet appareil. Le Wi-Fi est recommandé et toute l’inférence s’effectue sur l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica il modello %@ su questo dispositivo. Si consiglia il Wi-Fi e tutte le inferenze vengono eseguite sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@モデルをこのデバイスにダウンロードします。Wi-Fiの利用をおすすめします。すべての推論はデバイス内で行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 모델을 기기에 다운로드합니다. Wi-Fi 환경에서 진행을 권장하며, 모든 추론은 기기 내에서만 이루어집니다."
