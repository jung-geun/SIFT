    "memory.analysis.footer" : {
      "comment" : "Behavior-pattern analysis scope and AFM narrative explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Current to-do state, user-deletion snapshots, and typed change events from the last 90 days are kept separate. Structured metrics and confidence are calculated identically on every supported device; when selected, AFM improves only the narrative describing those metrics. Results are saved only when you tap Apply."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 90일의 현재 TODO 상태, 사용자 삭제 스냅샷, typed 변경 이벤트를 분리합니다. 구조화 지표와 신뢰도는 모든 지원 기기에서 동일하게 계산하고, AFM은 선택되었을 때 그 지표의 서술만 개선합니다. 결과는 적용을 눌러야 저장됩니다."
          }
        }
      }
    },
