    "health.erase.disclosure" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen deaktiviert alle Kategorieverbindungen und die Zustimmung zur automatischen Erstellung und entfernt lokale unverarbeitete Verläufe, Quellengenehmigungen und Routinenkandidaten. Bereits erstellte Aufgaben bleiben erhalten. Nichtklinische Markierungen bereits verarbeiteter Termine bleiben zur Vermeidung von Duplikaten gespeichert. HealthKit-Aufzeichnungen und iOS-Health-Berechtigungen bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erasing stops all category connections and automatic-creation consent, and deletes local raw history, source approvals, and routine candidates. Existing generated tasks remain. Nonclinical consumed-occurrence markers are kept to prevent duplicates. HealthKit records and iOS Health permissions are unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al borrar, se desactivan todas las conexiones de categorías y el consentimiento para la creación automática, y se eliminan el historial original local, las aprobaciones de orígenes y las propuestas de rutina. Las tareas ya generadas se conservan. Los marcadores no clínicos de ocurrencias ya procesadas se conservan para evitar duplicados. Los registros de HealthKit y los permisos de Salud de iOS no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’effacement désactive toutes les connexions de catégories et le consentement à la création automatique, et supprime l’historique brut local, les approbations de sources et les propositions de routine. Les tâches déjà générées sont conservées. Les marqueurs non cliniques des occurrences déjà traitées sont conservés pour éviter les doublons. Les données HealthKit et les autorisations Santé d’iOS restent inchangées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cancellazione disattiva tutte le connessioni delle categorie e il consenso alla creazione automatica ed elimina la cronologia grezza locale, le approvazioni delle origini e le proposte di routine. Le attività già generate restano. I marcatori non clinici delle occorrenze già elaborate vengono conservati per evitare duplicati. I dati di HealthKit e le autorizzazioni di Salute di iOS restano invariati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消去すると、すべてのカテゴリの接続と自動作成への同意が無効になり、ローカルの元の履歴、データ提供元の承認、ルーティン候補が削除されます。すでに作成されたタスクは残ります。重複を防ぐため、処理済みの実行予定を示す非臨床マーカーは保持されます。HealthKitの記録とiOSのヘルスケアへのアクセス権は変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지우면 모든 항목의 연결과 자동 생성 동의를 중지하고 로컬 원본 기록·출처 승인·루틴 후보를 삭제합니다. 이미 생성된 할 일은 남습니다. 중복 방지를 위해 비임상 처리 일정 표식은 유지합니다. HealthKit 기록과 iOS 건강 권한은 변경하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除操作会停用所有类别连接和自动创建授权，并删除本地原始历史记录、来源批准和候选日常计划。已生成的待办事项会保留。为防止重复，已处理计划时间点的非临床标记会保留。HealthKit 记录和 iOS 健康权限不会改变。"
          }
        }
      }
    },
    "health.error.schedule" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
