    "settings.sync.full.error" : {
      "comment" : "Full iCloud storage scope, consent and real transport status.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die vollständige iCloud-Synchronisierung konnte nicht abgeschlossen werden. Deine Daten bleiben auf dem Gerät erhalten. Prüfe die iCloud-Anmeldung, den Speicherplatz und den Schlüsselbund und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full iCloud sync could not be completed. Your data is retained on this device. Check your iCloud sign-in, storage and Keychain status, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo completar la sincronización completa con iCloud. Tus datos se conservan en el dispositivo. Comprueba el inicio de sesión en iCloud, el espacio disponible y el estado del Llavero, y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation complète avec iCloud n’a pas pu être terminée. Vos données restent sur cet appareil. Vérifiez votre connexion à iCloud, l’espace de stockage et l’état du trousseau, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile completare la sincronizzazione completa con iCloud. I dati restano sul dispositivo. Controlla l’accesso a iCloud, lo spazio di archiviazione e lo stato del Portachiavi, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudとの完全同期を完了できませんでした。データはこのデバイスに保持されています。iCloudへのサインイン、ストレージ、キーチェーンの状態を確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 iCloud 동기화를 완료하지 못했습니다. 데이터는 기기에 보존됩니다. iCloud 로그인·저장공간·키체인 상태를 확인한 후 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法完成完整的 iCloud 同步。数据仍保留在此设备上。请检查 iCloud 登录、存储空间和钥匙串状态，然后重试。"
          }
        }
      }
    },
