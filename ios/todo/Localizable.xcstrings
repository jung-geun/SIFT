    "openai.connection.testExplanation": {
      "comment": "Explain that the deliberate connection check sends only a fixed short test message, needs no app-data consent, and may use plan allowance.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧고 고정된 테스트 메시지만 전송하며, 저장된 앱 데이터는 보내지 않습니다. 할 일·메일·루틴·페르소나 전송 동의 없이 테스트할 수 있습니다. 구독 사용 한도를 일부 사용할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends only a short, fixed test message, not stored app data. No task, email, routine, or persona sharing consent is required. This may consume some of your plan allowance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo envía un mensaje de prueba breve y fijo, no datos guardados de la app. No se requiere consentimiento para compartir tareas, correos, rutinas ni el perfil personal. Esto puede consumir parte de los límites de tu plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い固定のテストメッセージのみを送信し、保存済みのアプリデータは送信しません。タスク、メール、ルーティン、ペルソナの共有への同意は不要です。プランの利用枠を一部消費する場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅发送一条简短的固定测试消息，不会发送应用中保存的数据。无需同意共享待办事项、邮件、日常规律或个人画像。此操作可能消耗部分套餐额度。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie uniquement un court message de test fixe, sans données enregistrées dans l’app. Aucun consentement au partage des tâches, e-mails, routines ou du profil personnel n’est nécessaire. Ce test peut consommer une partie du quota de votre forfait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia solo un breve messaggio di prova predefinito, non i dati salvati nell’app. Non è richiesto il consenso alla condivisione di attività, email, routine o persona. Potrebbe consumare parte della disponibilità del tuo piano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet nur eine kurze, festgelegte Testnachricht, keine gespeicherten App-Daten. Eine Einwilligung zur Weitergabe von Aufgaben, E-Mails, Routinen oder Persona-Daten ist nicht erforderlich. Dabei kann ein Teil deines Abo-Kontingents verbraucht werden."
          }
        }
      }
    },
