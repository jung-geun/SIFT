    "legal.privacy.calendar.completionActions" : {
      "comment" : "Native settings and analysis copy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ereignis beibehalten“ lässt den Termin unverändert. „Hinweise entfernen“ behält den Termin und entfernt seine Hinweise (Standard). „Ereignis entfernen“ löscht ihn. Diese Aktionen gelten nur für Termine, die SIFT für diese Aufgabe erstellt hat, nicht für ursprüngliche Termine aus externen Kalendern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep Event leaves the event unchanged. Silence Alerts keeps the event and removes its alerts (the default). Remove Event deletes it. These actions apply only to events SIFT created for that to-do, not original events from an external calendar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservar evento deja el evento sin cambios. Silenciar alertas conserva el evento y elimina sus alertas (opción predeterminada). Eliminar evento lo borra. Estas acciones solo se aplican a los eventos que SIFT creó para esa tarea, no a los eventos originales de un calendario externo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserver l’événement laisse l’événement inchangé. Désactiver les alertes conserve l’événement et supprime ses alertes (option par défaut). Supprimer l’événement l’efface. Ces actions s’appliquent uniquement aux événements créés par SIFT pour cette tâche, pas aux événements d’origine d’un calendrier externe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni evento lascia l’evento invariato. Disattiva avvisi mantiene l’evento e rimuove i suoi avvisi (opzione predefinita). Elimina evento lo cancella. Queste azioni si applicano solo agli eventi creati da SIFT per quella specifica attività, non agli eventi originali di un calendario esterno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「予定を保持」は予定をそのまま残します。標準の「通知のみ削除」は予定を残して通知を削除します。「予定を削除」は予定を削除します。これらの操作は、SIFTがそのタスク用に作成した予定にのみ適用され、外部カレンダーの元の予定には適用されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'일정 유지'는 일정을 그대로 둡니다. 기본값인 '알람만 끄기'는 일정은 남기고 알람만 끕니다. '이벤트 삭제'는 일정을 삭제합니다. 이 처리는 SIFT가 해당 할 일을 위해 만든 일정에만 적용되며, 외부 캘린더의 원본 일정에는 적용되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“保留日程”不更改日程。“仅移除提醒”为默认选项，会保留日程并移除提醒。“删除日程”会删除该日程。这些操作仅适用于 SIFT 为该待办事项创建的日程，不影响外部日历中的原始日程。"
          }
        }
      }
    },
    "legal.privacy.calendar.remoteBoundary" : {
      "comment" : "Calendar-event context is masked, but imported and confirmed tasks share titles and notes under task consent.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verarbeitung: EventKit auf dem Gerät. Der separate, an OpenAI gesendete Kalenderereigniskontext maskiert Titel als Busy und enthält nur Beginn und Ende. Aufgaben, die aus einem externen Kalender importiert und als aktiv bestätigt wurden, können jedoch im Rahmen der Einwilligung zur Aufgabenweitergabe ihre Titel und Notizen übermitteln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processing: on-device EventKit. Separate calendar-event context sent to OpenAI masks titles as Busy and includes only start/end times. However, tasks imported from an external calendar and confirmed as active may share their titles and notes under task-sharing consent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesamiento: EventKit en el dispositivo. El contexto independiente de eventos del calendario enviado a OpenAI oculta los títulos con Busy y solo incluye las horas de inicio y fin. Sin embargo, las tareas importadas de un calendario externo y confirmadas como activas pueden compartir sus títulos y notas según el consentimiento para compartir tareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traitement : EventKit sur l’appareil. Le contexte distinct des événements de calendrier envoyé à OpenAI remplace les titres par Busy et ne contient que les heures de début et de fin. Toutefois, les tâches importées d’un calendrier externe et confirmées comme actives peuvent partager leurs titres et notes dans le cadre du consentement au partage des tâches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elaborazione: EventKit sul dispositivo. Il contesto separato degli eventi del calendario inviato a OpenAI maschera i titoli con Busy e include solo gli orari di inizio e fine. Tuttavia, le attività importate da un calendario esterno e confermate come attive possono condividere titoli e note nell’ambito del consenso alla condivisione delle attività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "処理場所：デバイス内のEventKit。OpenAIに別途送信するカレンダーイベントの情報は、タイトルをBusyに置き換え、開始・終了時刻のみを含めます。ただし、外部カレンダーから読み込んで有効なタスクとして確定したものは、タスク共有への同意に基づいてタイトルとメモが共有される場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처리 위치: 기기 내 EventKit. OpenAI로 보내는 별도 캘린더 이벤트 컨텍스트는 제목을 Busy로 가리고 시작·종료 시각만 포함합니다. 다만 외부 캘린더에서 가져와 진행중으로 확정한 할 일은 일반 할 일 공유 동의 범위에 포함되어 제목·메모가 전송될 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "处理位置：设备端 EventKit。发送至 OpenAI 的独立日历事件上下文会将标题遮蔽为 Busy，且仅包含开始和结束时间。不过，从外部日历导入并确认为进行中的待办事项，可能在待办事项共享授权范围内共享标题和备注。"
          }
        }
      }
    },
    "legal.privacy.diagnostics.collected" : {
      "comment" : "Privacy policy diagnostic data categories.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasst werden: Fehlerzeitpunkte und Wiederholungszahlen; Quelldatei, Zeile und Funktion; Fehlerdomäne, Code, Typ und Meldung (Dateipfade und E-Mail-Adressen entfernt, auf 300 Zeichen begrenzt) samt der Kette zugrunde liegender Fehler; App-Version, Build, Betriebssystemversion und -Build, Laufzeitzustand, Funktionseinstellungen, Sprache, aus den Regionseinstellungen abgeleitetes Land oder Region, Zeitzone, UTC-Abweichung, Kalender und 24-Stunden-Einstellung zum Fehlerzeitpunkt; Gerätemodellkennung, Arbeitsspeicher, Speicherplatz, Bildschirmgröße, Prozessoranzahl, Sprache, Region und Zeitzone bei der Berichtserstellung; die letzten Fehlerprotokolle der App (bis zu 300 Einträge aus den letzten 30 Minuten); sowie Diagnosedaten zu Abstürzen, Hängern und speicherbedingten Beendigungen, die Apple später bereitstellen kann. Land und Region werden aus den Sprache- und Regionseinstellungen des Geräts abgeleitet, nicht aus dem tatsächlichen Standort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collected: error timestamps and repeat counts; source file, line, and function; error domain, code, type, and message (file paths and email addresses removed, capped at 300 characters) with the underlying error chain; app version, build, OS version and build, runtime state, feature settings, language, locale-derived country or region, time zone, UTC offset, calendar, and 24-hour setting at the error; device model identifier, memory, storage, screen size, processor count, language, region, and time zone when the report is prepared; the app's own recent error logs (up to 300 entries from the last 30 minutes); and crash, hang, and memory-termination diagnostics Apple may deliver later. Country and region are derived from device locale settings, not physical location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos recopilados: fechas y horas de los errores y número de repeticiones; archivo de código fuente, línea y función; dominio, código, tipo y mensaje del error (sin rutas de archivos ni direcciones de correo electrónico, con un límite de 300 caracteres), junto con la cadena de errores subyacentes; versión y compilación de la app, versión y compilación del sistema operativo, estado de ejecución, ajustes de funciones, idioma, país o región derivados de la configuración regional, zona horaria, desfase UTC, calendario y ajuste del formato de 24 horas en el momento del error; identificador del modelo del dispositivo, memoria, almacenamiento, tamaño de pantalla, número de procesadores, idioma, región y zona horaria al preparar el informe; registros de errores recientes de la propia app (hasta 300 entradas de los últimos 30 minutos); y diagnósticos de cierres inesperados, bloqueos y terminaciones por memoria que Apple pueda proporcionar más adelante. El país y la región se derivan de la configuración regional del dispositivo, no de la ubicación física."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données collectées : dates et heures des erreurs et nombre de répétitions ; fichier source, ligne et fonction ; domaine, code, type et message de l’erreur (chemins de fichiers et adresses e-mail supprimés, limite de 300 caractères), avec la chaîne d’erreurs sous-jacentes ; version et compilation de l’app, version et compilation du système d’exploitation, état d’exécution, réglages des fonctionnalités, langue, pays ou région déduits des réglages régionaux, fuseau horaire, décalage UTC, calendrier et réglage du format 24 heures au moment de l’erreur ; identifiant du modèle de l’appareil, mémoire, stockage, taille de l’écran, nombre de processeurs, langue, région et fuseau horaire lors de la préparation du rapport ; journaux d’erreurs récents de l’app elle-même (jusqu’à 300 entrées des 30 dernières minutes) ; et diagnostics de plantage, de blocage et d’arrêt dû à la mémoire qu’Apple peut transmettre ultérieurement. Le pays et la région sont déduits des réglages régionaux de l’appareil, et non de la position physique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dati raccolti: data e ora degli errori e numero di ripetizioni; file sorgente, riga e funzione; dominio, codice, tipo e messaggio dell'errore (con percorsi dei file e indirizzi email rimossi e un limite di 300 caratteri), insieme alla catena degli errori sottostanti; versione e build dell'app, versione e build del sistema operativo, stato di esecuzione, impostazioni delle funzionalità, lingua, paese o area geografica derivati dalle impostazioni locali, fuso orario, scostamento UTC, calendario e impostazione del formato a 24 ore al momento dell'errore; identificatore del modello del dispositivo, memoria, spazio di archiviazione, dimensioni dello schermo, numero di processori, lingua, area geografica e fuso orario al momento della preparazione del rapporto; log recenti degli errori dell'app (fino a 300 voci degli ultimi 30 minuti); e dati diagnostici su arresti anomali, blocchi e terminazioni per memoria insufficiente che Apple potrebbe fornire in seguito. Il paese e l'area geografica derivano dalle impostazioni locali del dispositivo, non dalla posizione fisica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収集項目：エラーの発生日時と繰り返し回数、ソースファイル・行番号・関数、エラーのドメイン・コード・種類・メッセージ（ファイルパスとメールアドレスを除去し、300文字以内に制限）および原因となるエラーの連鎖、エラー発生時のアプリのバージョン・ビルド、OSのバージョン・ビルド、実行状態、機能設定、言語、ロケール設定から取得した国または地域、タイムゾーン、UTCオフセット、カレンダー、24時間表示設定、レポート作成時のデバイスのモデル識別子・メモリ・ストレージ・画面サイズ・プロセッサ数・言語・地域・タイムゾーン、アプリ自体の直近のエラーログ（過去30分間の最大300件）、およびAppleが後から提供する場合があるクラッシュ・ハング・メモリ不足による終了の診断情報。国と地域は、実際の位置情報ではなく、デバイスのロケール設定から取得します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수집 항목: 오류 발생 시각·반복 횟수, 소스 파일·줄 번호·함수, 오류 도메인·코드·유형·메시지(파일 경로와 이메일 주소 제거, 300자 제한)와 하위 오류 사슬, 오류 당시 앱 버전·빌드·운영체제 버전·빌드·앱 실행 상태·기능 설정·언어·기기 언어 설정에서 파생한 국가/지역·시간대·UTC 오프셋·달력·24시간 설정, 보고서 준비 시점의 기기 모델 식별자·메모리·저장 공간·화면 크기·프로세서 수·언어·지역·시간대, 앱이 남긴 최근 오류 로그(최대 300건, 30분), Apple이 나중에 제공할 수 있는 충돌·멈춤·메모리 종료 진단. 국가/지역은 실제 위치가 아닌 기기 언어 설정에서 파생합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收集内容：错误发生时间和重复次数；源文件、行号和函数；错误域、代码、类型和消息（移除文件路径与邮件地址，最多 300 个字符），以及底层错误链；错误发生时的应用版本和构建版本、操作系统版本和构建版本、运行状态、功能设置、语言、由区域设置推导的国家或地区、时区、UTC 偏移量、历法和 24 小时制设置；准备报告时的设备型号标识符、内存、存储空间、屏幕尺寸、处理器数量、语言、地区和时区；应用自身的近期错误日志（最近 30 分钟内最多 300 条）；以及 Apple 可能在稍后提供的崩溃、卡死和内存不足终止诊断。国家和地区由设备区域设置推导，并非实际位置。"
          }
        }
      }
    },
    "legal.privacy.diagnostics.deliveryLimit" : {
      "comment" : "Privacy policy MetricKit delivery limitation.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-Systemdiagnosen können verzögert oder gar nicht verfügbar sein und erfassen nicht jede erzwungene Beendigung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple system diagnostics may be delayed or unavailable and do not capture every forced termination"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los diagnósticos del sistema de Apple pueden llegar con retraso o no estar disponibles y no detectan todos los cierres forzados"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les diagnostics système d’Apple peuvent être retardés ou indisponibles et ne détectent pas tous les arrêts forcés"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La diagnostica di sistema Apple potrebbe arrivare in ritardo o non essere disponibile e non rileva tutte le terminazioni forzate"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleのシステム診断は遅延する場合や利用できない場合があり、すべての強制終了を記録するものではありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 시스템 진단은 지연되거나 제공되지 않을 수 있고 모든 강제 종료를 포착하지 않음"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 系统诊断可能延迟或无法提供，且无法捕获每次强制终止"
          }
        }
      }
    },
    "legal.privacy.diagnostics.excluded" : {
      "comment" : "Privacy policy diagnostic data exclusions.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht erfasst werden: tatsächlicher Standort und GPS-Position, Gerätename, Aufnahmen, Transkripte, Aufgaben, E-Mail-Inhalte, -Betreffzeilen und -Adressen, Personas, Kontokennungen und Authentifizierungstoken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluded: physical and GPS location, device name, recordings, transcripts, to-dos, email bodies, subjects, and addresses, personas, account identifiers, and authentication tokens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos excluidos: ubicación física y GPS, nombre del dispositivo, grabaciones, transcripciones, tareas, cuerpos, asuntos y direcciones de correo, perfiles personales, identificadores de cuenta y tokens de autenticación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données exclues : position physique et GPS, nom de l’appareil, enregistrements, transcriptions, tâches, corps, objets et adresses des e-mails, profils personnels, identifiants de compte et jetons d’authentification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dati esclusi: posizione fisica e GPS, nome del dispositivo, registrazioni, trascrizioni, attività, corpi, oggetti e indirizzi delle email, persona, identificatori degli account e token di autenticazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象外：実際の位置情報およびGPS位置情報、デバイス名、録音、文字起こし、To-Do、メールの本文・件名・アドレス、ペルソナ、アカウント識別子、認証トークン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제외 항목: 실제 위치·GPS 위치, 기기 이름, 음성 녹음, 전사문, 할 일, 이메일 본문·제목·주소, 페르소나, 계정 식별자, 인증 토큰"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不包含：实际位置和 GPS 位置、设备名称、录音、转写文本、待办事项、邮件正文、主题和地址、个人画像、账户标识符及身份验证令牌。"
          }
        }
      }
    },
    "legal.privacy.diagnostics.retentionCondition" : {
      "comment" : "Privacy policy diagnostic retention condition.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zum Widerruf der Einwilligung oder zum Löschen der Protokolle in der App"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Until consent is withdrawn or logs are deleted in the app"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta que se retire el consentimiento o se eliminen los registros en la app"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’au retrait du consentement ou à la suppression des journaux dans l’app"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino alla revoca del consenso o all'eliminazione dei log nell'app"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同意を撤回するか、アプリ内でログを削除するまで"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동의 철회 또는 앱에서 삭제 시"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直至撤回同意或在应用中删除日志"
          }
        }
      }
    },
    "legal.privacy.diagnostics.retentionDeletion" : {
