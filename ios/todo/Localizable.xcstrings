    "settings.sync.unavailableMessage": {
      "comment": "Cloud sync unavailable in a local-only build.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is unavailable in this build. Existing data remains on this device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에서는 iCloud 동기화를 사용할 수 없습니다. 기존 데이터는 기기에만 보존됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud no está disponible en esta compilación. Los datos existentes permanecen en este dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドではiCloud同期を利用できません。既存のデータはこのデバイス内に保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建版本不支持 iCloud 同步。现有数据仍保留在此设备上。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud est indisponible dans cette version. Les données existantes restent sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione iCloud non è disponibile in questa build. I dati esistenti rimangono su questo dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
