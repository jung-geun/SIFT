    "Your original data has been preserved. Unlock the device and try again. No changes will be saved until storage is available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your original data has been preserved. Unlock the device and try again. No changes will be saved until storage is available."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 데이터는 보존되어 있습니다. 기기 잠금을 해제하고 다시 시도하세요. 저장소를 열기 전에는 데이터를 변경하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos originales se han conservado. Desbloquea el dispositivo y vuelve a intentarlo. No se guardará ningún cambio hasta que el almacenamiento esté disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のデータは保持されています。デバイスのロックを解除してから、もう一度お試しください。ストレージが利用可能になるまで、変更は保存されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的原始数据已保留。请解锁设备后重试。存储恢复可用前，不会保存任何更改。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données d’origine ont été préservées. Déverrouillez l’appareil et réessayez. Aucune modification ne sera enregistrée tant que le stockage ne sera pas disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati originali sono stati conservati. Sblocca il dispositivo e riprova. Nessuna modifica verrà salvata finché lo spazio di archiviazione non sarà disponibile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine ursprünglichen Daten bleiben erhalten. Entsperre das Gerät und versuche es erneut. Änderungen werden erst gespeichert, wenn der Speicher verfügbar ist."
          }
        }
      }
    },
