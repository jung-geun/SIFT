    "error.meeting.transcription.runtimeFailed": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription could not finish. The recording was saved; try accuracy-first transcription again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사를 완료하지 못했습니다. 녹음은 저장되었으니 정확도 우선 재전사를 시도하세요."
