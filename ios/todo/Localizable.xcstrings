    "error.mail.service.mutationIdentityUnavailable": {
      "comment": "Generated service prose; interpolated values preserve source content.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 메일을 확인할 수 없습니다. 메일함을 새로 고친 뒤 다시 시도하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ could not verify this message. Refresh the mailbox and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no pudo verificar este mensaje. Actualiza el buzón e inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@でこのメールを確認できませんでした。メールボックスを更新して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法验证此邮件。请刷新邮箱后重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas pu vérifier ce message. Actualisez la boîte de réception et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha potuto verificare questo messaggio. Aggiorna la casella di posta e riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte diese Nachricht nicht verifizieren. Aktualisiere das Postfach und versuche es erneut."
          }
        }
      }
    },
