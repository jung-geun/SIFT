          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭바의 메일을 눌러 연결된 메일을 확인하는 화면을 열어보세요."
          }
        }
      }
    },
    "tutorial.body.탭바의 캘린더를 눌러 일정과 할 일을 함께 보는 화면을 확인해보세요." : {
      "comment" : "Tutorial hint body.",
      "extractionState" : "manual",
      "localizations" : {
