          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une source audio s’est arrêtée. Les autres sources sélectionnées continuent d’enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sorgente audio si è interrotta. Le altre sorgenti selezionate continuano a registrare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Audioquelle wurde gestoppt. Andere ausgewählte Quellen nehmen weiter auf."
          }
        }
      }
    },
    "meeting.capture.source.transcriptionStopped": {
      "comment": "One source lost live transcription while continuing to save its original audio.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 소스의 실시간 전사가 중단되었습니다. 원본 음성은 계속 저장됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live transcription stopped for this source. Its original audio is still being saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción en directo se ha detenido para esta fuente. Su audio original se sigue guardando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このソースのリアルタイム文字起こしが停止しました。元の音声は引き続き保存されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此来源的实时转写已停止。其原始音频仍在保存。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription en direct de cette source s’est arrêtée. Son audio original continue d’être enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione in tempo reale si è interrotta per questa sorgente. Il suo audio originale continua a essere salvato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Transkription dieser Quelle wurde gestoppt. Ihre Originalaudiodaten werden weiterhin gespeichert."
          }
        }
      }
    },
    "meeting.capture.transcription.warning": {
      "comment": "Live transcription warning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live transcription stopped. Recording continues and the saved audio can be transcribed again after recording ends."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 전사가 중단됐습니다. 녹음은 계속 저장되며 종료 후 저장된 음성으로 다시 전사할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción en directo se ha detenido. La grabación continúa y el audio guardado se podrá volver a transcribir cuando termine la grabación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアルタイム文字起こしが停止しました。録音は継続され、録音終了後に保存された音声から再度文字起こしを行えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时转写已停止。录音仍会继续保存，录音结束后可使用已保存的音频重新转写。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription en direct s’est arrêtée. L’enregistrement continue et l’audio sauvegardé pourra être transcrit à nouveau une fois l’enregistrement terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione in tempo reale si è interrotta. La registrazione continua e l'audio salvato potrà essere trascritto di nuovo al termine della registrazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Transkription wurde unterbrochen. Die Aufnahme läuft weiter. Nach dem Ende der Aufnahme kann das gespeicherte Audio erneut transkribiert werden."
          }
        }
      }
    },
    "meeting.capture.voiceProcessingFallback": {
      "comment": "Voice-processing fallback notice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice noise reduction is unavailable; recording the raw input instead."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 노이즈 감소를 사용할 수 없어 원본 입력으로 녹음합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reducción de ruido de voz no está disponible; se está grabando la entrada sin procesar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声ノイズ低減を利用できないため、未加工の入力で録音します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音降噪不可用，将改为录制原始输入。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réduction du bruit vocal est indisponible ; l’entrée audio brute est enregistrée à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riduzione del rumore vocale non è disponibile; viene registrato l'ingresso non elaborato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rauschunterdrückung für Sprache ist nicht verfügbar. Stattdessen wird das unverarbeitete Eingangssignal aufgenommen."
          }
        }
      }
    },
    "meeting.confidence": {
