          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in der Tableiste auf „E-Mails“, um verbundene E-Mails anzusehen."
          }
        }
      }
    },
    "tutorial.body.탭바의 캘린더를 눌러 일정과 할 일을 함께 보는 화면을 확인해보세요.": {
