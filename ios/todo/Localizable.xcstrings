    "meeting.audioImport.modelNotice": {
      "comment": "Audio import is available without the transcription model.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 Whisper 모델이 없습니다. 음성은 저장할 수 있으며 베타 설정에서 모델을 설치한 후 회의에서 전사를 다시 시도할 수 있습니다. 전사문을 임의로 만들지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The offline Whisper model is not installed. You can still save the audio, then install the model in beta settings and retry transcription from the meeting. No transcript will be invented."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo Whisper sin conexión no está instalado. Puedes guardar el audio, instalar después el modelo en los ajustes beta y volver a intentar la transcripción desde la reunión. No se inventará ninguna transcripción."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン用のWhisperモデルがインストールされていません。音声だけを保存し、ベータ機能の設定でモデルをインストールしてから、会議画面で文字起こしを再試行できます。文字起こしを勝手に生成することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未安装离线 Whisper 模型。你仍可先保存音频，再到测试功能设置中安装模型，并从会议中重试转写。应用不会凭空生成转写文本。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle Whisper hors ligne n’est pas installé. Vous pouvez enregistrer l’audio, puis installer le modèle dans les réglages bêta et relancer la transcription depuis la réunion. Aucune transcription ne sera inventée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello Whisper offline non è installato. Puoi comunque salvare l’audio, poi installare il modello nelle impostazioni beta e riprovare la trascrizione dalla riunione. Non verrà inventata alcuna trascrizione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Offline-Modell von Whisper ist nicht installiert. Du kannst die Audiodaten trotzdem speichern, das Modell anschließend in den Beta-Einstellungen installieren und die Transkription in der Besprechung erneut starten. Es wird kein Transkript erfunden."
          }
        }
      }
    },
