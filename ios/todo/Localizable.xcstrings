    "선택한 날짜의 일정, 이후 일정 또는 전체 시리즈에 적용할 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply changes to the selected occurrence, future occurrences, or the entire series."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 날짜의 일정, 이후 일정 또는 전체 시리즈에 적용할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes aplicarlo al evento de la fecha seleccionada, a los eventos posteriores o a toda la serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した日の予定、以降の予定、または繰り返しの予定全体に適用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可应用于所选日期的日程、之后的日程或整个重复系列。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez appliquer les modifications à l’événement de la date sélectionnée, aux événements suivants ou à toute la série."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi applicare la modifica all'evento della data selezionata, agli eventi successivi o all'intera serie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die Änderung auf den Termin am ausgewählten Datum, alle folgenden Termine oder die gesamte Serie anwenden."
          }
        }
      }
    },
