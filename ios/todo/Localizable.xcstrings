            "value": "Activar la sincronización con iCloud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud同期を有効にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 iCloud 同步"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer la synchronisation iCloud"
          }
        },
        "it": {
          "stringUnit": {
