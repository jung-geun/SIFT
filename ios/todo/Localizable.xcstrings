    "legal.text.이메일 연동 해제: 설정 → 이메일 연동 → 연결 해제 (OAuth 토큰·IMAP 앱 비밀번호 삭제)": {
      "comment": "English legal translation preserving the Korean source structure and meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect email: Settings → Email Integration → Disconnect (OAuth tokens and IMAP app passwords deleted)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 연동 해제: 설정 → 이메일 연동 → 연결 해제 (OAuth 토큰·IMAP 앱 비밀번호 삭제)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar el correo: Ajustes → Integración del correo → Desconectar (se eliminan los tokens de OAuth y las contraseñas de aplicación de IMAP)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メール連携を解除：設定 → メール連携 → 接続を解除（OAuthトークン・IMAPアプリパスワードを削除）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开邮件连接：设置 → 邮件集成 → 断开连接（删除 OAuth 令牌和 IMAP 应用专用密码）"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter les e-mails : Réglages → Intégration des e-mails → Déconnecter (suppression des jetons OAuth et des mots de passe d’application IMAP)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scollegare l'email: Impostazioni → Integrazione email → Scollega (i token OAuth e le password per le app IMAP vengono eliminati)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail-Verbindung trennen: Einstellungen → E-Mail-Integration → Verbindung trennen (OAuth-Token und IMAP-App-Passwörter werden gelöscht)"
          }
        }
      }
    },
