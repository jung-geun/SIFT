          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión de Gmail en SIFT QA requiere su propio cliente OAuth de Google para iOS registrado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
