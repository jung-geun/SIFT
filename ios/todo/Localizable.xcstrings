    "beta.laya.note" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ca. 483 MB große Modell muss manuell installiert werden; die Verarbeitung erfolgt auf dem Gerät. Die Qualitätskriterien für die Priorisierung wurden nicht erfüllt, die Genauigkeit der E-Mail-Bewertung ist ungeprüft. Original prüfen und ausdrücklich speichern. Ohne Modell gelten Regeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manually install the ~483 MB model for on-device processing. Priority quality missed its gate; email accuracy is unverified. Check the source and save explicitly. Without the model, rules apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala manualmente el modelo de unos 483 MB para procesar en el dispositivo. La calidad de las prioridades no alcanzó el umbral exigido; la precisión al evaluar correos no se ha verificado. Comprueba el original y guarda de forma explícita. Sin el modelo, se aplican reglas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez manuellement le modèle d’environ 483 MB pour le traitement sur l’appareil. La qualité des priorités n’a pas atteint le seuil requis ; la précision de l’évaluation des e-mails n’est pas vérifiée. Vérifiez la source et enregistrez explicitement. Sans le modèle, des règles s’appliquent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa manualmente il modello da circa 483 MB per l’elaborazione sul dispositivo. La qualità delle priorità non ha raggiunto la soglia richiesta; l’accuratezza nella valutazione delle email non è verificata. Controlla l’originale e salva esplicitamente. Senza il modello, si applicano regole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約483 MBのモデルを手動でインストールすると、デバイス内で処理します。優先順位付けの品質は基準に達しておらず、メール判定の精度は未検証です。元の内容を確認し、明示的に保存してください。モデルがない場合はルールで処理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약 483 MB 모델을 직접 설치해야 하며 기기에서 처리합니다. 우선순위 품질 기준은 미달, 메일 판단 정확도는 미검증입니다. 원본을 확인하고 직접 저장하세요. 설치하지 않으면 규칙으로 처리합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需手动安装约 483 MB 的模型，处理在设备上进行。优先级质量未达标，邮件判断准确性尚未验证。请核对原始内容并主动保存。未安装模型时按规则处理。"
          }
        }
      }
    },
