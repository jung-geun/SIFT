    "legal.text.메일 본문의 외부 분석은 별도 동의와 선택한 메일에 대한 직접 요청이 있어야 하며, 자동 수집·요약·할 일 정렬은 기기 내에서 처리합니다." : {
      "comment" : "English legal translation preserving source meaning.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die externe Analyse von E-Mail-Inhalten erfordert eine separate Einwilligung und eine ausdrückliche Anfrage für eine ausgewählte E-Mail. Automatisches Erfassen, Zusammenfassen und Priorisieren erfolgt weiterhin auf dem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote email-body analysis requires separate consent and an explicit request for a selected email. Automatic collection, summaries, and prioritization remain on device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El análisis remoto del cuerpo del correo requiere consentimiento independiente y una solicitud explícita para un correo seleccionado. La recopilación, los resúmenes y la priorización automáticos permanecen en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’analyse distante du corps des e-mails nécessite un consentement distinct et une demande explicite pour un e-mail sélectionné. La collecte, les résumés et la priorisation automatiques restent sur l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’analisi remota del corpo delle email richiede un consenso separato e una richiesta esplicita per un’email selezionata. Raccolta, riepiloghi e definizione delle priorità automatici restano sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メール本文の外部分析には、別途同意と、選択したメールに対する明示的なリクエストが必要です。自動収集、要約、優先順位付けは引き続きデバイス内で行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메일 본문의 외부 분석은 별도 동의와 선택한 메일에 대한 직접 요청이 있어야 하며, 자동 수집·요약·할 일 정렬은 기기 내에서 처리합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远程分析邮件正文需要单独同意，并针对所选邮件明确提出请求。自动收集、摘要生成和优先级排序均在设备端处理。"
          }
        }
      }
    },
