    "calendar.timeline.unavailable": {
      "comment": "Calendar timeline direct manipulation and error recovery.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Termin ist nicht mehr verfügbar. Aktualisiere den Kalender und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This event is no longer available. Refresh the calendar and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este evento ya no está disponible. Actualiza el calendario y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet événement n’est plus disponible. Actualisez le calendrier et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo evento non è più disponibile. Aggiorna il calendario e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この予定は見つかりません。カレンダーを更新してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정을 더 이상 찾을 수 없습니다. 캘린더를 새로고침한 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此日程已不可用。请刷新日历后重试。"
          }
        }
      }
    },
    "calendar.timeline.noAccess": {
      "comment": "Calendar timeline direct manipulation and error recovery.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kalenderzugriff. Erlaube den Zugriff in den Einstellungen und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is unavailable. Allow access in Settings and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay acceso al calendario. Permítelo en Ajustes y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier est indisponible. Autorisez-le dans Réglages et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso al calendario non disponibile. Consenti l’accesso nelle Impostazioni e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーにアクセスできません。設定でアクセスを許可してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더에 접근할 수 없습니다. 설정에서 접근을 허용한 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问日历。请在设置中允许访问后重试。"
          }
        }
      }
    },
    "calendar.timeline.readOnly": {
      "comment": "Calendar timeline direct manipulation and error recovery.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kalender ist schreibgeschützt oder nicht verfügbar. Wähle einen beschreibbaren Kalender, um Änderungen vorzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This calendar is read-only or unavailable. Choose a writable calendar to make changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este calendario es de solo lectura o no está disponible. Elige uno editable para realizar cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce calendrier est en lecture seule ou indisponible. Choisissez un calendrier modifiable pour effectuer des changements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo calendario è di sola lettura o non disponibile. Scegli un calendario modificabile per apportare cambiamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカレンダーは読み取り専用か利用できません。変更するには書き込み可能なカレンダーを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용이거나 사용할 수 없는 캘린더입니다. 변경하려면 쓰기 가능한 캘린더를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此日历为只读或不可用。请选择可写入的日历以进行更改。"
          }
        }
      }
    },
