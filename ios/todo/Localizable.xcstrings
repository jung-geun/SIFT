    "analysis.regional.unavailable.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Externe Analysen sind für das aktuelle App-Store-Land oder die aktuelle Region nicht verfügbar. Funktionen auf dem Gerät bleiben verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "External analysis is unavailable for the current App Store country or region. On-device features remain available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El análisis externo no está disponible en el país o la región actual del App Store. Las funciones del dispositivo siguen disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
