    },
    "legal.text.온디바이스 AI와 OpenAI 분석의 가용성은 OS·기기 상태, 계정 권한·구독 한도·모델 제공 여부에 따라 달라집니다. 자동 고급 모델 재호출은 하지 않습니다." : {
      "comment" : "English legal translation preserving source meaning.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verfügbarkeit von KI auf dem Gerät und OpenAI hängt vom Betriebssystem- und Gerätestatus, von Kontoberechtigungen, Abo-Kontingenten und dem Modellzugang ab. Erweiterte Modellanfragen werden nie automatisch wiederholt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-device AI and OpenAI availability depend on OS/device state, account permission, plan limits, and model access. Advanced-model re-requests are never automatic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disponibilidad de la IA en el dispositivo y de OpenAI depende del estado del sistema operativo y del dispositivo, los permisos de la cuenta, los límites del plan y el acceso a modelos. Las nuevas solicitudes al modelo avanzado nunca son automáticas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disponibilité de l’IA sur l’appareil et d’OpenAI dépend de l’état du système et de l’appareil, des autorisations du compte, des quotas du forfait et de l’accès aux modèles. Les nouvelles demandes au modèle avancé ne sont jamais automatiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disponibilità dell’IA sul dispositivo e di OpenAI dipende dallo stato del sistema operativo e del dispositivo, dalle autorizzazioni dell’account, dai limiti del piano e dall’accesso ai modelli. Le nuove richieste con il modello avanzato non sono mai automatiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス内AIとOpenAIの利用可否は、OSやデバイスの状態、アカウント権限、プランの利用上限、モデルへのアクセスによって異なります。高性能モデルへの再リクエストが自動で行われることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온디바이스 AI와 OpenAI 분석의 가용성은 OS·기기 상태, 계정 권한·구독 한도·모델 제공 여부에 따라 달라집니다. 자동 고급 모델 재호출은 하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备端 AI 和 OpenAI 的可用性取决于操作系统及设备状态、账户权限、订阅限额和模型访问权限。绝不会自动使用高级模型再次请求。"
          }
        }
      }
    },
    "legal.text.운영자는 사전 통보 없이 기능을 변경·중단·종료할 수 있습니다." : {
