    "일반 Google 비밀번호가 아닌 App Password를 입력하세요. 저장 후 앱에서는 다시 표시하거나 복사할 수 없습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an App Password, not your regular Google password. After saving it, the app cannot display or copy it again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 Google 비밀번호가 아닌 App Password를 입력하세요. 저장 후 앱에서는 다시 표시하거나 복사할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce App Password, no tu contraseña habitual de Google. Una vez guardada, no podrás volver a verla ni copiarla desde la aplicación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常のGoogleパスワードではなく、App Passwordを入力してください。保存後は、アプリ内で再表示したりコピーしたりすることはできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入应用专用密码（App Password），而不是常规 Google 密码。保存后，无法在 App 中再次显示或复制。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un mot de passe App Password, et non votre mot de passe Google habituel. Une fois enregistré, il ne pourra plus être affiché ni copié dans l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un'App Password, non la normale password di Google. Dopo il salvataggio, non potrai più visualizzarla o copiarla dall'app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ein App Password ein, nicht dein normales Google-Passwort. Nach dem Speichern kann es in der App weder erneut angezeigt noch kopiert werden."
          }
        }
      }
    },
