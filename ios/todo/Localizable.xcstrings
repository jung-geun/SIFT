          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI devolvió una respuesta no válida a la comprobación de conexión. No se ha verificado el acceso a inferencia. No se enviaron datos guardados de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI a renvoyé une réponse invalide à la vérification de connexion. L’accès à l’inférence n’a pas été confirmé. Aucune donnée enregistrée de l’app n’a été envoyée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI ha restituito una risposta non valida alla verifica della connessione. L’accesso all’inferenza non è stato verificato. Nessun dato salvato dell’app è stato inviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAIから接続確認への無効な応答が返されました。推論の利用権限は未確認です。保存済みのアプリデータは送信していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI가 올바르지 않은 연결 확인 응답을 반환했습니다. 추론 사용 권한은 확인되지 않았습니다. 저장된 앱 데이터는 전송하지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
