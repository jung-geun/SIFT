          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez reçu une invitation à partager le calendrier %@. Acceptez-la pour y participer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai ricevuto un invito a condividere il calendario %@. Accetta l’invito per partecipare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wurdest zur gemeinsamen Nutzung des Kalenders %@ eingeladen. Nimm die Einladung an, um teilzunehmen."
          }
        }
      }
    },
