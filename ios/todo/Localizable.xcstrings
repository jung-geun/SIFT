    "openai.cleanup.error": {
      "comment": "Removed-provider cleanup failure shown without Keychain diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 제공자의 비밀정보를 안전하게 삭제하지 못했습니다. 다시 시도해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous provider’s secret could not be removed securely. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar de forma segura el secreto del proveedor anterior. Vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のプロバイダの機密情報を安全に削除できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全删除先前服务提供方的密钥信息。请重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le secret de l’ancien fournisseur n’a pas pu être supprimé de manière sécurisée. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rimuovere in sicurezza il segreto del fornitore precedente. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geheimen Zugangsdaten des bisherigen Anbieters konnten nicht sicher entfernt werden. Bitte versuche es erneut."
          }
        }
      }
    },
    "openai.cleanup.failedNotice": {
      "comment": "OpenAI settings and data-sharing consent copy.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제거된 제공자의 비밀정보 삭제를 확인하지 못했습니다. 해당 제공자는 활성화되지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleanup of the removed provider's secret could not be confirmed. That provider cannot be activated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la eliminación del secreto del proveedor retirado. Ese proveedor no se puede activar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除済みプロバイダの機密情報が消去されたか確認できませんでした。そのプロバイダは有効にできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认已移除服务提供方的密钥信息是否已清除。该提供方无法启用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression du secret de l’ancien fournisseur n’a pas pu être confirmée. Ce fournisseur ne peut pas être activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile confermare la rimozione del segreto del fornitore eliminato. Quel fornitore non può essere attivato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen der geheimen Zugangsdaten des entfernten Anbieters konnte nicht bestätigt werden. Dieser Anbieter kann nicht aktiviert werden."
          }
        }
      }
    },
    "openai.cleanup.retry": {
      "comment": "OpenAI settings and data-sharing consent copy.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
