    "meeting.audioTrack.offlineFailed": {
      "comment": "Source-isolated meeting track navigation, processing and export.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline transcription failed. The previous valid transcript is retained."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 전사 실패 · 이전 유효 전사를 유지합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción sin conexión ha fallado. Se conserva la transcripción válida anterior."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン文字起こしに失敗しました。以前の有効な文字起こしが保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线转写失败。已保留此前有效的转写文本。"
          }
        },
        "fr": {
