    "저장된 %@ App Password가 있습니다. 마지막 연결 시도는 실패했지만 비밀번호는 삭제되지 않았습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved %@ App Password is available. The last connection attempt failed, but the password was not removed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 %@ App Password가 있습니다. 마지막 연결 시도는 실패했지만 비밀번호는 삭제되지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una App Password de %@ guardada. El último intento de conexión falló, pero la contraseña no se ha eliminado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のApp Passwordは保存されています。前回の接続試行は失敗しましたが、パスワードは削除されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存 %@ 应用专用密码（App Password）。上次连接尝试失败，但密码未被删除。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mot de passe App Password %@ est enregistré. La dernière tentative de connexion a échoué, mais le mot de passe n’a pas été supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È presente un'App Password salvata per %@. L'ultimo tentativo di connessione non è riuscito, ma la password non è stata eliminata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein App Password für %@ ist gespeichert. Der letzte Verbindungsversuch ist fehlgeschlagen, aber das Passwort wurde nicht gelöscht."
          }
        }
      }
    },
