    "meeting.speaker.continuity.provisional": {
      "comment": "Accessibility provenance for display-only speaker continuity on a brief undecided fragment.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorläufige Sprecherzuordnung anhand der vorherigen Sprache; nicht bestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provisional speaker based on the preceding speech; not confirmed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hablante provisional según el habla anterior; sin confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Locuteur provisoire d’après la parole précédente ; non confirmé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlante provvisorio basato sul parlato precedente; non confermato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前の発話に基づく暫定的な話者です。確定情報ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞선 발화를 바탕으로 한 임시 화자이며, 확정된 정보가 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据前文语音暂定的说话人，尚未确认。"
          }
        }
      }
    },
