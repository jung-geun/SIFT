    "openai.models.subscriptionCapabilities" : {
      "comment" : "Documented subscription capability boundaries; model discovery is not endpoint authorization.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Abonnementverbindung unterstützt nur berechtigte Responses-API-Anfragen, keine Audio- oder Videoeingaben und keine Transkriptions-APIs wie die Sprechertrennung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This subscription connection supports eligible Responses API requests, not audio/video input or transcription APIs such as speaker diarization."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conexión mediante suscripción admite las solicitudes compatibles de Responses API, pero no entradas de audio o vídeo ni API de transcripción como las de separación de hablantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion par abonnement prend en charge les requêtes admissibles à Responses API, mais pas les entrées audio ou vidéo ni les API de transcription, notamment celles de séparation des locuteurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa connessione tramite abbonamento supporta le richieste idonee a Responses API, ma non gli input audio o video né le API di trascrizione come quelle per la separazione dei parlanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサブスクリプション接続は、対象のResponses APIリクエストにのみ対応します。音声・動画入力や、話者分離などの文字起こしAPIには対応していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 구독 연결은 지원 대상 Responses API 요청에만 사용하며 음성·영상 입력과 화자 분리 등 전사 API는 지원하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此订阅连接仅支持符合条件的 Responses API 请求，不支持音频或视频输入，也不支持说话人分离等转写 API。"
          }
        }
      }
    },
    "openai.settings.connectionNotice" : {
      "comment" : "Native settings and analysis copy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Nutzt die Kontingente von ChatGPT Plus/Pro und genehmigte App-Berechtigungen; eine Anmeldung ist keine Zustimmung zur Datenweitergabe. Verfügbar für lokale persönliche Projekte, Open Source und genehmigte Apps. Kostenpflichtiger oder remote gehosteter Vertrieb erfordert die Genehmigung von OpenAI. Modellzugriff und Limits legt OpenAI fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Uses ChatGPT Plus/Pro allowances and approved app permissions; signing in is not consent to share data. Available to local personal projects, open source and approved apps; paid or remotely hosted distribution needs OpenAI approval. OpenAI sets model access and limits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Usa las cuotas de ChatGPT Plus/Pro y los permisos aprobados de la app; iniciar sesión no implica consentir el envío de datos. Disponible para proyectos personales locales, código abierto y apps aprobadas; la distribución de pago o alojada de forma remota requiere la aprobación de OpenAI. OpenAI determina el acceso a los modelos y los límites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Utilise les quotas ChatGPT Plus/Pro et les autorisations approuvées de l’app ; se connecter ne vaut pas consentement au partage des données. Disponible pour les projets personnels locaux, les projets open source et les apps approuvées ; la distribution payante ou hébergée à distance nécessite l’accord d’OpenAI. OpenAI détermine l’accès aux modèles et les limites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Usa le quote di ChatGPT Plus/Pro e i permessi approvati dell’app; l’accesso non equivale al consenso alla condivisione dei dati. Disponibile per progetti personali locali, progetti open source e app approvate; la distribuzione a pagamento o con hosting remoto richiede l’approvazione di OpenAI. OpenAI stabilisce l’accesso ai modelli e i limiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意の機能です。ChatGPT Plus/Proの利用枠と承認済みのアプリ権限を使用します。ログインはデータ送信への同意ではありません。ローカルの個人プロジェクト、オープンソース、承認済みのアプリで利用できます。有料配布やリモートホスティングでの提供にはOpenAIの承認が必要です。利用可能なモデルと上限はOpenAIが定めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항입니다. ChatGPT Plus·Pro 한도와 승인된 앱 권한을 사용하며, 로그인은 데이터 전송 동의가 아닙니다. 로컬 개인 프로젝트·오픈소스·승인된 앱에서 제공되며 유료·원격 호스팅 배포에는 OpenAI 승인이 필요합니다. 모델과 한도는 OpenAI가 정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此功能为可选项，使用 ChatGPT Plus/Pro 额度和已批准的应用权限；登录不代表同意共享数据。适用于本地个人项目、开源项目及已获批准的应用；付费分发或远程托管分发需经 OpenAI 批准。模型访问权限和限额由 OpenAI 决定。"
          }
        }
      }
    },
