          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail 검색의 카테고리(category:) 분류를 IMAP으로 조회해 그대로 사용합니다."
          }
        },
        "es": {
          "stringUnit": {
