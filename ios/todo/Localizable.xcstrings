    "legal.privacy.ads.recipient" : {
      "comment" : "Advertising-version privacy disclosure; preserve SDK data collection, consent and content-isolation boundaries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versionen mit Werbung: IP-Adresse, ungefährer Standort, App-/Gerätekennungen, Werbeinteraktionen und Diagnose-/Leistungsdaten für Anzeigenauslieferung, Betrugsprävention, Messung und Einwilligungsverwaltung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versions offering ads: IP address, coarse location, app/device identifiers, ad interactions and diagnostic/performance data for ad serving, fraud prevention, measurement and consent management."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versiones con anuncios: dirección IP, ubicación aproximada, identificadores de app/dispositivo, interacciones publicitarias y datos de diagnóstico/rendimiento para mostrar anuncios, prevenir el fraude, realizar mediciones y gestionar el consentimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versions proposant des annonces : adresse IP, position approximative, identifiants d’app/appareil, interactions publicitaires et données de diagnostic/performances pour la diffusion, la prévention de la fraude, les mesures et la gestion du consentement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versioni con annunci: indirizzo IP, posizione approssimativa, identificatori app/dispositivo, interazioni pubblicitarie e dati diagnostici/prestazioni per pubblicare annunci, prevenire frodi, misurare e gestire il consenso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告を提供するバージョン：IPアドレス・おおよその位置・アプリ/デバイス識別子・広告操作・診断/パフォーマンス情報を、広告配信・不正防止・測定・同意管理に使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고 제공 버전: IP·대략적 위치·앱/기기 식별자·광고 상호작용·진단/성능 정보 — 광고 제공·부정행위 방지·측정·동의 관리"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供广告的版本：IP 地址、大致位置、应用/设备标识符、广告互动及诊断/性能信息，用于广告投放、防欺诈、衡量和同意管理。"
          }
        }
      }
    },
    "legal.privacy.ads.requests" : {
      "comment" : "Advertising-version privacy disclosure; preserve SDK data collection, consent and content-isolation boundaries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für Versionen mit Werbung. Wir fordern nicht personalisierte Anzeigen an und deaktivieren die Publisher-First-Party-ID. Wir zeigen keine ATT-Abfrage und fordern keine Berechtigung zum Zugriff auf die IDFA an. Das bedeutet nicht, dass das SDK keine Daten erfasst oder Daten nicht zum Tracking verwenden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to versions that offer ads. We request non-personalized ads and disable publisher first-party ID. We do not display an ATT authorization prompt or request permission to access IDFA. This does not mean the SDK collects no data or cannot use data for tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a las versiones que ofrecen anuncios. Solicitamos anuncios no personalizados y desactivamos el ID propio del editor. No mostramos la solicitud de autorización ATT ni pedimos permiso para acceder al IDFA. Esto no significa que el SDK no recopile datos o no pueda usarlos para el seguimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique aux versions proposant des annonces. Nous demandons des annonces non personnalisées et désactivons l’identifiant propriétaire de l’éditeur. Nous n’affichons pas de demande d’autorisation ATT et ne demandons pas l’accès à l’IDFA. Cela ne signifie pas que le SDK ne collecte aucune donnée ou ne peut pas les utiliser pour le suivi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica alle versioni che offrono annunci. Richiediamo annunci non personalizzati e disattiviamo l’ID proprietario del publisher. Non mostriamo la richiesta di autorizzazione ATT né chiediamo il permesso di accedere all’IDFA. Ciò non significa che l’SDK non raccolga dati o non possa usarli per il tracciamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告を提供するバージョンに適用されます。非パーソナライズ広告をリクエストし、パブリッシャーのファーストパーティIDを無効にします。ATTの許可画面やIDFAへのアクセス許可は要求しませんが、SDKによるデータ収集やトラッキングの可能性がないという意味ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고를 제공하는 버전에 적용됩니다. 비개인 맞춤 광고를 요청하고 게시자 퍼스트 파티 ID를 비활성화합니다. ATT 추적 허용 팝업이나 IDFA 접근 권한은 요청하지 않지만, 이것이 SDK의 데이터 수집이나 추적 가능성이 없다는 뜻은 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于提供广告的版本。我们请求非个性化广告，并停用发布商第一方 ID。不显示 ATT 授权提示，也不请求访问 IDFA 的权限，但这并不意味着 SDK 不收集数据或无法将数据用于跟踪。"
          }
        }
      }
    },
