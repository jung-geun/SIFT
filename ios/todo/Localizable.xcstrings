    "schedule.reminder.explanation" : {
      "comment" : "Schedule approval UI: schedule.reminder.explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mitteilungsberechtigung wird nur geprüft oder angefordert, wenn du eine Erinnerung auswählst. Bestehende Erinnerungen bleiben relativ zur genehmigten Fälligkeit erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notification permission is checked or requested only if you choose a reminder. Existing reminders remain relative to the approved due date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El permiso para notificaciones solo se comprueba o solicita si eliges un recordatorio. Los recordatorios existentes se mantienen en relación con la fecha de vencimiento aprobada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autorisation des notifications n’est vérifiée ou demandée que si vous choisissez un rappel. Les rappels existants restent relatifs à l’échéance approuvée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autorizzazione alle notifiche viene verificata o richiesta solo se scegli un promemoria. I promemoria esistenti restano relativi alla scadenza approvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知を選択した場合にのみ、通知の許可を確認・リクエストします。既存のリマインダーは、承認した期限を基準とする設定が維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림은 직접 선택한 경우에만 권한을 확인·요청합니다. 기존 알림은 승인한 새 마감 기준으로 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在你选择提醒时才会检查或请求通知权限。现有提醒将继续以批准后的截止时间为基准。"
          }
        }
      }
    },
