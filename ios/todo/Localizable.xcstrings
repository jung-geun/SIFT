          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许远程分析个人画像"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’analyse distante du profil personnel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’analisi remota della persona"
          }
        },
        "de": {
