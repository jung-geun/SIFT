    "todo.settings.priority.footer" : {
      "comment" : "Explain AI availability, rule fallback, preserved manual priorities, separate account/transfer consent, and model installation management.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist keine KI verfügbar, wird nach Fälligkeit und Wichtigkeit sortiert. Manuell festgelegte Prioritäten bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When AI is unavailable, sorting uses due-date and importance rules. Manually pinned priorities are preserved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la IA no está disponible, las tareas se ordenan según reglas de vencimiento e importancia. Se conservan las prioridades fijadas manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque l’IA est indisponible, le tri suit des règles d’échéance et d’importance. Les priorités fixées manuellement sont conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando l’IA non è disponibile, l’ordinamento segue regole basate su scadenza e importanza. Le priorità fissate manualmente vengono mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIを利用できない場合は、期限と重要度のルールで並べ替えます。手動で固定した優先順位は維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI를 사용할 수 없으면 마감·중요도 규칙으로 정렬합니다. 직접 고정한 우선순위는 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 不可用时，按截止日期和重要性规则排序。手动固定的优先级会保留。"
          }
        }
      }
    },
