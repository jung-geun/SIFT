    "meeting.audioTrack.groupExplanation": {
      "comment": "Source-isolated meeting track navigation, processing and export.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each source has its own original audio, transcript and speakers. Open a track to play, edit or reprocess it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 음성 소스의 원음·전사·화자를 따로 저장합니다. 트랙을 열어 재생·편집·재처리하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fuente tiene su propio audio original, transcripción e interlocutores. Abre una pista para reproducirla, editarla o volver a procesarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各音声ソースの元の音声、文字起こし、話者を個別に保存します。トラックを開いて再生、編集、再処理ができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个来源都有独立的原始音频、转写文本和说话人信息。打开音轨即可播放、编辑或重新处理。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque source dispose de son propre audio original, de sa transcription et de ses intervenants. Ouvrez une piste pour la lire, la modifier ou la traiter à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni sorgente ha il proprio audio originale, la propria trascrizione e i propri interlocutori. Apri una traccia per riprodurla, modificarla o rielaborarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Quelle hat eine eigene Originalaufnahme, ein eigenes Transkript und eigene Sprecher. Öffne eine Spur, um sie abzuspielen, zu bearbeiten oder erneut zu verarbeiten."
          }
        }
      }
    },
    "meeting.audioTrack.independent": {
      "comment": "Source-isolated meeting track navigation, processing and export.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This track's original audio, transcript and speakers are processed independently of other audio sources."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 트랙의 원음·전사·화자는 다른 음성 소스와 독립적으로 처리됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio original, la transcripción y los interlocutores de esta pista se procesan de forma independiente de las demás fuentes de audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このトラックの元の音声、文字起こし、話者は他の音声ソースとは独立して処理されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此音轨的原始音频、转写文本和说话人信息独立于其他音频来源进行处理。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio original, la transcription et les intervenants de cette piste sont traités indépendamment des autres sources audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio originale, la trascrizione e gli interlocutori di questa traccia vengono elaborati indipendentemente dalle altre sorgenti audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originalaufnahme, das Transkript und die Sprecher dieser Spur werden unabhängig von anderen Audioquellen verarbeitet."
          }
        }
      }
    },
    "meeting.audioTrack.independentCapture": {
      "comment": "Independent source capture controls and per-track live transcript status.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources are saved and processed separately. App or screen audio can still contain several participants; speaker IDs belong only to their track."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스별로 원음과 전사·화자를 따로 저장합니다. 앱·화면 오디오 안에는 여러 참가자의 소리가 섞일 수 있으며 화자 ID는 해당 트랙 안에서만 사용합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes se guardan y procesan por separado. El audio de una app o de la pantalla puede contener a varios participantes; los identificadores de hablante pertenecen solo a su pista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声ソースは個別に保存・処理されます。アプリや画面の音声には複数の参加者の声が含まれる場合があります。話者IDは、そのトラック内でのみ有効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各来源分别保存和处理。应用或屏幕音频仍可能包含多位参与者的声音；说话人 ID 仅在其所属音轨内有效。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sources sont enregistrées et traitées séparément. L’audio d’une app ou de l’écran peut néanmoins contenir plusieurs participants ; les identifiants des intervenants ne sont valables que pour leur piste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sorgenti vengono salvate ed elaborate separatamente. L'audio dell'app o dello schermo può comunque contenere più partecipanti; gli ID dei parlanti appartengono solo alla rispettiva traccia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quellen werden getrennt gespeichert und verarbeitet. App- oder Bildschirmaudio kann dennoch mehrere Teilnehmende enthalten; Sprecher-IDs gelten nur innerhalb ihrer jeweiligen Spur."
          }
        }
      }
    },
