    "beta.localFallback.supported" : {
      "comment" : "Native settings and analysis copy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät unterstützt Apple Intelligence. Heruntergeladene Modelle werden daher nicht als Ersatz-KI verwendet. Installierte Modelle können weiterhin gelöscht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device supports Apple Intelligence, so downloaded models are not used as fallback AI. Installed models can still be deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo es compatible con Apple Intelligence, por lo que los modelos descargados no se usan como IA alternativa. Puedes eliminar los modelos instalados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil prend en charge Apple Intelligence ; les modèles téléchargés ne sont donc pas utilisés comme IA de secours. Vous pouvez toujours supprimer les modèles installés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo supporta Apple Intelligence, quindi i modelli scaricati non vengono usati come IA alternativa. Puoi comunque eliminare i modelli installati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスはApple Intelligenceに対応しているため、ダウンロードしたモデルは代替AIとして使用しません。インストール済みのモデルは削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 Apple Intelligence를 지원하므로 다운로드 모델을 대체 AI로 사용하지 않습니다. 설치된 모델은 삭제할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备支持 Apple Intelligence，因此不会将已下载的模型用作备用 AI。已安装的模型仍可删除。"
          }
        }
      }
    },
