    "meeting.error.changedDuringRetry": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting changed, so the retranscription was not applied. Try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의가 변경되어 재전사 결과를 적용하지 못했습니다. 다시 시도해주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reunión cambió, por lo que no se aplicó la nueva transcripción. Vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議内容が変更されたため、再文字起こしの結果が適用されませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议内容已更改，因此未应用重新转写的结果。请重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réunion a changé ; la nouvelle transcription n’a donc pas été appliquée. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riunione è cambiata, quindi la nuova trascrizione non è stata applicata. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Besprechung wurde geändert. Die erneute Transkription wurde daher nicht angewendet. Versuche es erneut."
          }
        }
      }
    },
    "meeting.error.changedDuringSummary": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting changed, so the summary was not saved. Try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의가 변경되어 요약을 저장하지 못했습니다. 다시 시도해주세요."
          }
        },
        "es": {
          "stringUnit": {
