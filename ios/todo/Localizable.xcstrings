    "mail.openai.preview.notice" : {
      "comment" : "Remote email preview notice: no automatic task or event creation; original deadlines need verification and explicit saving.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus diesem Ergebnis werden keine Aufgaben oder Ereignisse erstellt. Prüfe Fristen im Original und nutze ausdrücklich den bestehenden Speicherablauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tasks or events are created from this output. Verify deadlines in the original and use the existing save flow explicitly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se crean tareas ni eventos a partir de este resultado. Verifica las fechas límite en el original y usa de forma explícita el proceso de guardado existente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune tâche ni aucun événement n’est créé à partir de ce résultat. Vérifiez les échéances dans l’original et utilisez explicitement la procédure d’enregistrement existante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo risultato non crea attività né eventi. Verifica le scadenze nell’originale e usa esplicitamente la procedura di salvataggio esistente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この結果からタスクや予定が作成されることはありません。締め切りは原文で確認し、既存の保存手順で手動登録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결과에서 할 일·일정을 자동으로 만들지 않습니다. 마감은 원문에서 확인하고 기존 저장 화면에서 직접 등록하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会根据此结果创建待办事项或日程。请在原文中核实截止时间，并手动使用现有保存流程。"
          }
        }
      }
    },
