    "routines.suggestions.disabled": {
      "comment": "Routine review UI: routines.suggestions.disabled.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습이 꺼져 있어 추천하지 않습니다. 저장 기록은 직접 삭제할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learning is off, so suggestions are disabled. Saved records can still be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aprendizaje está desactivado, por lo que no hay sugerencias. Aún puedes eliminar los registros guardados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習がオフのため、提案は無効です。保存済みの記録は引き続き削除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习已关闭，因此不会提供建议。仍可删除已保存的记录。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’apprentissage est désactivé, donc les suggestions le sont aussi. Vous pouvez toujours supprimer les données enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’apprendimento è disattivato, quindi i suggerimenti sono disabilitati. Puoi comunque eliminare i record salvati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lernen ist ausgeschaltet, daher sind Vorschläge deaktiviert. Gespeicherte Datensätze können weiterhin gelöscht werden."
          }
        }
      }
    },
    "routines.suggestions.empty": {
      "comment": "Routine review UI: routines.suggestions.empty.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인된 신뢰 가능한 루틴의 새 발생분만 추천합니다. 이미 만든 할 일·거절한 발생분은 중복 제안하지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only new occurrences of confirmed reliable routines are suggested. Existing tasks and rejected occurrences are not duplicated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se sugieren nuevas repeticiones de rutinas confirmadas y fiables. No se duplican tareas existentes ni repeticiones rechazadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認済みで信頼性のあるルーティンの、新たな実施回のみを提案します。既存のタスクや拒否した実施回は重複して提案しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为已确认且可靠的日常规律建议新的发生项。不会重复建议已有待办事项或已拒绝的发生项。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les nouvelles occurrences de routines confirmées et fiables sont suggérées. Les tâches existantes et les occurrences refusées ne sont pas proposées en double."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono suggerite solo nuove occorrenze di routine confermate e affidabili. Le attività esistenti e le occorrenze rifiutate non vengono duplicate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgeschlagen werden nur neue Termine bestätigter, verlässlicher Routinen. Bestehende Aufgaben und abgelehnte Termine werden nicht erneut vorgeschlagen."
          }
        }
      }
    },
