        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信結果を確認できませんでした。下書きは保持されています。再試行では同じ送信データを使用するため、保存済みのレポートが重複することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전달 여부를 확인하지 못했습니다. 작성 중인 내용은 보관됩니다. 재시도 시 같은 제출을 사용하므로 저장된 보고서가 중복되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认送达。您的草稿已保留。重试会使用同一次提交，以免重复保存报告。"
          }
        }
      }
    },
    "feedback.failure.unavailable" : {
      "comment" : "Private SIFT feedback flow. Preserve explicit consent and privacy disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das private Postfach ist vorübergehend nicht verfügbar oder voll. Dein Entwurf bleibt erhalten. Versuche es später erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The private inbox is temporarily unavailable or full. Your draft is kept. Try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El buzón privado no está disponible temporalmente o está lleno. Tu borrador se conserva. Vuelve a intentarlo más tarde."
