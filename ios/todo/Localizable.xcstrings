      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Lernen ist ausgeschaltet, daher sind Vorschläge deaktiviert. Gespeicherte Datensätze können weiterhin gelöscht werden."
          }
        },
        "en" : {
          "stringUnit" : {
