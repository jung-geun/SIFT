          }
        }
      }
    },
    "meeting.help.recordingConsent.message": {
      "comment": "Recording consent help message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device processing is the default. Recordings stay on this device, and only selected items are added to the To-Do review queue."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 기기 내 처리입니다. 녹음은 이 기기에만 저장되며, 선택한 항목만 할 일 검토함으로 추가됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesamiento en el dispositivo es la opción predeterminada. Las grabaciones permanecen en este dispositivo y solo los elementos seleccionados se añaden a las tareas pendientes de revisión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトでオンデバイス処理が行われます。録音はこのデバイスにのみ保存され、選択した項目のみがタスクの確認待ちキューに追加されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认在设备端处理。录音保留在此设备上，仅将选中的项目添加到待办事项待审核队列。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traitement sur l’appareil est activé par défaut. Les enregistrements restent sur cet appareil et seuls les éléments sélectionnés sont ajoutés à la file d’attente des tâches à examiner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elaborazione sul dispositivo è l'impostazione predefinita. Le registrazioni restano su questo dispositivo e solo gli elementi selezionati vengono aggiunti alla coda di verifica delle attività."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verarbeitung erfolgt standardmäßig auf dem Gerät. Aufnahmen bleiben auf diesem Gerät. Nur ausgewählte Einträge werden zur Aufgaben-Prüfliste hinzugefügt."
          }
        }
      }
    },
    "meeting.help.recordingConsent.title": {
      "comment": "Recording consent help title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording Notice and Consent"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 고지 및 동의"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso y consentimiento de grabación"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音に関する告知と同意"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音告知与同意"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Informations et consentement à l’enregistrement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informativa e consenso alla registrazione"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahmehinweis und Einwilligung"
          }
        }
      }
    },
    "meeting.help.voiceProcessing.message": {
      "comment": "Voice processing help message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a beta feature. Apple voice processing (echo cancellation and noise suppression) is applied. Turn it off to record the unprocessed original input."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "베타 기능입니다. Apple 음성 처리(에코 제거·잡음 억제)를 적용합니다. 끄면 가공하지 않은 원본 입력으로 녹음합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una función beta. Se aplica el procesamiento de voz de Apple (cancelación de eco y supresión de ruido). Desactívala para grabar la entrada original sin procesar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベータ機能です。Appleの音声処理（エコーキャンセレーションとノイズ抑制）が適用されます。オフにすると、未加工のオリジナル入力で録音します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一项测试版功能。将应用 Apple 语音处理（回声消除和噪声抑制）。关闭后将录制未经处理的原始输入。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit d’une fonctionnalité bêta. Le traitement vocal Apple (annulation de l’écho et suppression du bruit) est appliqué. Désactivez cette option pour enregistrer l’entrée originale sans traitement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è una funzionalità beta. Viene applicata l'elaborazione vocale Apple (cancellazione dell'eco e soppressione del rumore). Disattivala per registrare l'ingresso originale non elaborato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Beta-Funktion. Die Sprachverarbeitung von Apple (Echounterdrückung und Rauschunterdrückung) wird angewendet. Deaktiviere diese Option, um das unverarbeitete Originalsignal aufzunehmen."
          }
        }
      }
    },
    "meeting.help.voiceProcessing.title": {
      "comment": "Voice processing help title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice Noise Reduction"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 노이즈 감소"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducción de ruido de voz"
          }
        },
        "ja": {
