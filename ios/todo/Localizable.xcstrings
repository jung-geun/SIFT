    "openai.consent.email.explanation" : {
      "comment" : "OpenAI settings and data-sharing consent copy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet Betreff und Inhalt nur, wenn du in den E-Mail-Details ausdrücklich eine externe Analyse anforderst. Automatisches Erfassen und Analysieren des Posteingangs erfolgt weiterhin auf dem Gerät. Das Original und die vorhandene lokale Zusammenfassung werden nicht überschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends the subject and body only when you explicitly request remote analysis in email detail. Automatic inbox collection and analysis stay on device. The original and existing local summary are not overwritten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía el asunto y el cuerpo solo cuando solicitas explícitamente un análisis remoto en el detalle de un correo. La recopilación y el análisis automáticos de la bandeja de entrada permanecen en el dispositivo. No se sobrescriben el original ni el resumen local existente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie l’objet et le corps du message uniquement lorsque vous demandez explicitement une analyse distante depuis le détail d’un e-mail. La collecte et l’analyse automatiques de la boîte de réception restent sur l’appareil. L’original et le résumé local existant ne sont pas écrasés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia oggetto e corpo solo quando richiedi esplicitamente l’analisi remota nei dettagli dell’email. La raccolta e l’analisi automatiche della posta in arrivo restano sul dispositivo. L’originale e il riepilogo locale esistente non vengono sovrascritti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールの詳細画面で外部分析を明示的にリクエストした場合にのみ、件名と本文を送信します。受信トレイの自動収集・分析は引き続きデバイス内で行われます。原文と既存のローカル要約は上書きされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메일 상세에서 직접 외부 분석을 요청한 메일의 제목과 본문을 OpenAI로 보냅니다. 받은편지함 자동 수집·분석은 계속 기기 내에서 처리합니다. 원문·기존 로컬 요약은 덮어쓰지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在你于邮件详情中明确请求远程分析时，才会发送邮件主题和正文。收件箱的自动收集与分析仍在设备上进行。原文和已有本地摘要不会被覆盖。"
          }
        }
      }
    },
    "openai.consent.email.title" : {
      "comment" : "OpenAI settings and data-sharing consent copy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Externe Analyse ausgewählter E-Mails erlauben"
          }
        },
        "en" : {
