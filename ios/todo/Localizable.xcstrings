    "error.openai.connection.synchronizationConflict" : {
      "comment" : "The local ChatGPT login is retained when another device changed the portable connection; no secret is discarded.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät verbunden, aber die iCloud-Verbindung wurde auf einem anderen Gerät geändert. Beide Versionen bleiben erhalten; die automatische Synchronisierung ist pausiert. Prüfe vor dem erneuten Verbinden das andere Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connected on this device, but the iCloud connection changed elsewhere. Both versions were preserved; automatic sync is paused. Check the other device before reconnecting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectado en este dispositivo, pero la conexión de iCloud cambió en otro lugar. Se conservaron ambas versiones y la sincronización automática está en pausa. Comprueba el otro dispositivo antes de volver a conectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecté sur cet appareil, mais la connexion iCloud a été modifiée ailleurs. Les deux versions ont été conservées et la synchronisation automatique est suspendue. Vérifiez l’autre appareil avant de reconnecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connesso su questo dispositivo, ma la connessione iCloud è stata modificata altrove. Entrambe le versioni sono state conservate e la sincronizzazione automatica è sospesa. Controlla l’altro dispositivo prima di riconnetterti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでは接続されていますが、iCloudの接続情報が別のデバイスで変更されました。両方の状態を保持し、自動同期を一時停止しています。再接続する前に別のデバイスを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서는 연결되었지만 다른 기기에서 iCloud 연결이 변경되었습니다. 두 버전을 모두 유지하고 자동 동기화를 중지했습니다. 다시 연결하기 전에 다른 기기를 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备已连接，但 iCloud 连接信息已在其他设备上更改。两个版本均已保留，自动同步已暂停。重新连接前请先检查另一台设备。"
          }
        }
      }
    },
