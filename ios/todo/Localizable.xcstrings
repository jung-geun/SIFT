      }
    },
    "tutorial.body.우측 상단 더 보기 > 설정을 눌러 이메일 연동 항목을 확인해보세요.": {
      "comment": "Tutorial hint body.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
