        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir vérifié les détails, touchez Ajouter pour enregistrer la tâche. Vous pouvez annuler sans enregistrer : le tutoriel passera quand même à l’étape suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver rivisto i dettagli, tocca Aggiungi per salvare l’attività. Puoi annullare senza salvare e il tutorial passerà alla fase successiva."
