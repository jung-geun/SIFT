    "이 기기는 온디바이스 AI 모델을 실행할 수 있는 메모리 요건을 충족하지 않습니다.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device does not meet the memory requirements to run an on-device AI model."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 온디바이스 AI 모델을 실행할 수 있는 메모리 요건을 충족하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no cumple los requisitos de memoria para ejecutar un modelo de IA en el dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは、オンデバイスAIモデルの実行に必要なメモリ要件を満たしていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不满足运行设备端 AI 模型所需的内存要求。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
