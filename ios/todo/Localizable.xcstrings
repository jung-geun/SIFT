    "mail.connection.outlook.legacyNotice" : {
      "comment" : "Outlook legacy connection notice.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Ältere IMAP-Verbindung für Outlook/Hotmail/Office365 (Beta/ohne Funktionsgarantie)\nMicrosoft-Richtlinien können die Standardauthentifizierung oder die Anmeldung mit App-Passwort blockieren. Einzelheiten findest du in der Anleitung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Outlook/Hotmail/Office365 IMAP legacy connection (beta/best-effort)\nMicrosoft policy may block basic/app-password authentication. Check the guide for details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Conexión IMAP heredada de Outlook/Hotmail/Office365 (beta, sin garantías)\nLa política de Microsoft puede bloquear la autenticación básica o con contraseña de aplicación. Consulta la guía para obtener más información."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Connexion IMAP héritée Outlook/Hotmail/Office365 (bêta/sans garantie de fonctionnement)\nLa politique de Microsoft peut bloquer l’authentification de base ou par mot de passe d’application. Consultez le guide pour en savoir plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Connessione IMAP legacy Outlook/Hotmail/Office365 (beta, senza garanzia di funzionamento)\nI criteri Microsoft potrebbero bloccare l'autenticazione di base o con password per le app. Consulta la guida per i dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Outlook/Hotmail/Office365 IMAPの従来方式の接続（ベータ版・動作保証なし）\nMicrosoftのポリシーにより、基本認証やアプリパスワード認証がブロックされる場合があります。詳しくはガイドをご確認ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Outlook/Hotmail/Office365 IMAP 레거시 연결 (베타/best-effort)\nMicrosoft 정책상 기본/앱 비밀번호 인증이 차단되어 있을 수 있습니다. 가이드를 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Outlook/Hotmail/Office365 IMAP 旧版连接（测试版／尽力提供支持）\nMicrosoft 的政策可能会阻止基本身份验证或应用专用密码验证。详情请参阅指南。"
          }
        }
      }
    },
