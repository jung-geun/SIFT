    "health.history.disclosure" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies je Kategorie unabhängig voneinander bis zu 90 Tage des jüngsten Trainings- oder Medikamentenverlaufs. Nur genehmigte Quellen können Routinenvorschläge liefern; nichts wird aktiviert, bevor du es geprüft und bestätigt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read up to the latest 90 days of workout or medication history, independently for each category. Only approved sources can produce routine suggestions; nothing is enabled until you review and confirm it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee hasta los últimos 90 días del historial de entrenamientos o medicamentos, de forma independiente para cada categoría. Solo los orígenes aprobados pueden generar sugerencias de rutina; nada se activa hasta que lo revises y confirmes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit jusqu’aux 90 derniers jours de l’historique d’entraînements ou de médicaments, indépendamment pour chaque catégorie. Seules les sources approuvées peuvent produire des suggestions de routine ; rien n’est activé avant votre vérification et votre confirmation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge fino agli ultimi 90 giorni della cronologia di allenamenti o farmaci, separatamente per ogni categoria. Solo le origini approvate possono generare suggerimenti di routine; nulla viene attivato finché non lo rivedi e confermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウトまたは服薬の履歴を、カテゴリごとに個別に、直近の最大90日分まで読み取ります。ルーティンの提案に使用できるのは、承認済みのデータ提供元だけです。自分でレビューして確定するまでは何も有効になりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동 또는 복약 기록을 각 항목별로 최근 최대 90일까지만 읽습니다. 승인한 출처만 루틴을 제안하며, 직접 검토하고 확정하기 전에는 활성화되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分别读取各类别最近最多 90 天的体能训练或用药历史记录。只有已批准的来源才能用于生成日常计划建议；在你审核并确认之前，不会启用任何日常计划。"
          }
        }
      }
    },
    "health.history.empty" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine sichtbaren Einträge. Möglicherweise gibt es in den letzten 90 Tagen keinen Verlauf, oder der Lesezugriff wurde verweigert oder eingeschränkt. HealthKit legt den Status der Leseberechtigung nicht offen, daher kann diese App die Fälle nicht unterscheiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No visible records. There may be no history in the last 90 days, or read access may be denied or restricted. HealthKit hides read authorization, so this app cannot tell the difference."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay registros visibles. Puede que no haya historial de los últimos 90 días o que el acceso de lectura esté denegado o restringido. HealthKit oculta la autorización de lectura, por lo que esta app no puede distinguir entre estos casos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun enregistrement visible. Il se peut qu’il n’y ait aucun historique sur les 90 derniers jours ou que l’accès en lecture soit refusé ou restreint. HealthKit masque l’autorisation de lecture ; cette app ne peut donc pas distinguer ces cas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna registrazione visibile. Potrebbe non esserci una cronologia degli ultimi 90 giorni oppure l’accesso in lettura potrebbe essere negato o limitato. HealthKit nasconde l’autorizzazione di lettura, quindi questa app non può distinguere i due casi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示可能な記録がありません。過去90日間に履歴がないか、読み取りアクセスが拒否または制限されている可能性があります。HealthKitは読み取りの許可状態を公開しないため、このアプリでは区別できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보이는 기록이 없습니다. 최근 90일 동안 기록이 없거나 읽기 접근이 거부·제한되었을 수 있습니다. HealthKit은 읽기 권한 상태를 숨기므로 앱에서 구별할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可见的记录。可能是最近 90 天内没有历史记录，也可能是读取权限被拒绝或受到限制。HealthKit 不公开读取授权状态，因此本应用无法区分这些情况。"
          }
        }
      }
    },
