          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用できない選択済みカレンダー"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용할 수 없는 선택된 캘린더"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
