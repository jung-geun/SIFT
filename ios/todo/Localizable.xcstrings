          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクは見つからなくなりました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此待办事项已不可用。"
          }
        },
        "fr": {
