          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭同步不会删除当前设备或其他设备上的数据。"
          }
        }
      }
    },
    "settings.sync.full.onboardingPrompt" : {
      "comment" : "Full iCloud storage scope, consent and real transport status.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die lokale Nutzung ist auch ohne iCloud möglich. Wenn du iCloud wählst, werden App-Daten einschließlich E-Mails und Besprechungsaufnahmen unter demselben Apple Account gespeichert und wiederhergestellt. Sie erscheinen auf anderen Geräten, sobald Apple die Übertragung abgeschlossen hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local use is available without iCloud. If you choose iCloud, app data, including email and meeting recordings, is stored and restored under the same Apple account. It appears on other devices after Apple's transfer completes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes usar la app localmente sin iCloud. Si eliges iCloud, los datos de la app, incluidos los correos y las grabaciones de reuniones, se guardan y restauran con la misma cuenta de Apple. Aparecerán en otros dispositivos cuando Apple complete la transferencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’utilisation locale est possible sans iCloud. Si vous choisissez iCloud, les données de l’app, y compris les e-mails et les enregistrements de réunions, sont stockées et restaurées sous le même compte Apple. Elles apparaissent sur les autres appareils une fois le transfert d’Apple terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’uso locale è disponibile senza iCloud. Se scegli iCloud, i dati dell’app, incluse le email e le registrazioni delle riunioni, vengono archiviati e ripristinati con lo stesso account Apple. Appariranno sugli altri dispositivi al termine del trasferimento da parte di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudがなくてもローカルで利用できます。iCloudを選択すると、メールや会議の録音を含むアプリデータが同じApple Accountに保存・復元されます。Appleによる転送が完了すると、ほかのデバイスに反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 실행은 iCloud 없이도 사용할 수 있습니다. iCloud를 선택하면 메일·회의 녹음까지 포함한 앱 데이터를 같은 Apple 계정에서 저장·복원합니다. 다른 기기에는 Apple의 전송 완료 후 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需 iCloud 也可在本地使用。选择 iCloud 后，应用数据（包括邮件和会议录音）将存储在同一 Apple 账户下并可恢复。Apple 完成传输后，数据才会出现在其他设备上。"
          }
        }
      }
    },
    "settings.sync.full.onboardingScope" : {
      "comment" : "Full iCloud storage scope, consent and real transport status.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeichert werden Aufgaben, Personas, Analysen, E-Mail-Inhalte, Besprechungsaudio und Transkripte, Routinen, Wortschatz, Einstellungen und Kontoverbindungen. Gesundheitsdaten, Betriebssystemberechtigungen und erneut herunterladbare Modelldateien sind ausgeschlossen. Der iCloud-Schlüsselbund ist erforderlich; dies ist unabhängig von der Einwilligung zur Übermittlung an ChatGPT."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stores tasks, personas, analysis, email bodies, meeting audio and transcripts, routines, vocabulary, settings and account connections. Health data, OS permissions and redownloadable model files are excluded. Requires iCloud Keychain and is separate from consent to send content to ChatGPT."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tareas, personas, análisis, cuerpos de correos, audio y transcripciones de reuniones, rutinas, vocabulario, ajustes y conexiones de cuentas. Se excluyen los datos de salud, los permisos del sistema y los archivos de modelos que se pueden volver a descargar. Requiere el Llavero de iCloud y es independiente del consentimiento para enviar contenido a ChatGPT."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocke les tâches, personas, analyses, corps des e-mails, audio et transcriptions des réunions, routines, vocabulaire, réglages et connexions aux comptes. Les données de santé, les autorisations du système et les fichiers de modèles pouvant être téléchargés à nouveau sont exclus. Le trousseau iCloud est requis. Ce choix est distinct du consentement à l’envoi de contenu à ChatGPT."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivia attività, personas, analisi, corpo delle email, audio e trascrizioni delle riunioni, routine, vocabolario, impostazioni e connessioni agli account. Sono esclusi i dati sanitari, le autorizzazioni del sistema e i file dei modelli riscaricabili. Richiede il Portachiavi iCloud ed è separato dal consenso all’invio di contenuti a ChatGPT."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タスク、ペルソナ、分析結果、メール本文、会議の音声・文字起こし、ルーティン、語彙、設定、アカウント接続情報を保存します。健康データ、OSの権限、再ダウンロード可能なモデルファイルは対象外です。iCloudキーチェーンが必要で、ChatGPTへのコンテンツ送信の同意とは別です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "할 일·페르소나·분석·메일 본문·회의 음성/전사·루틴·학습 사전·설정·연결 정보를 저장합니다. 건강정보·OS 권한·재다운로드 가능한 모델 파일은 제외합니다. iCloud 키체인이 필요하며 ChatGPT 전송 동의와는 별개입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储任务、角色、分析结果、邮件正文、会议音频与转写、例程、词汇、设置和账户连接信息。不包含健康数据、操作系统权限以及可重新下载的模型文件。需要启用 iCloud 钥匙串，且此选择与向 ChatGPT 发送内容的授权无关。"
          }
        }
      }
    },
