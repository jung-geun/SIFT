          "stringUnit": {
            "state": "translated",
            "value": "OpenAI가 올바르지 않은 분석을 반환했습니다. 원본은 변경되지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI devolvió un análisis no válido. El original no se modificó."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAIから無効な分析結果が返されました。元の内容は変更されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI 返回的分析无效。原文未更改。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI a renvoyé une analyse invalide. L’original n’a pas été modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI ha restituito un’analisi non valida. L’originale non è stato modificato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI hat eine ungültige Analyse zurückgegeben. Das Original wurde nicht verändert."
          }
        }
      }
    },
    "error.openai.request.modelUnavailable": {
      "comment": "OpenAI analysis error. Argument 1 is the raw model ID; do not translate it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not available to the selected ChatGPT account. No replacement model was used."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 ChatGPT 계정에서 %@ 모델을 사용할 수 없습니다. 다른 모델로 대체하지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está disponible para la cuenta de ChatGPT seleccionada. No se usó ningún modelo de sustitución."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したChatGPTアカウントでは%@を利用できません。代替モデルは使用していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选 ChatGPT 账户无法使用 %@。未改用其他模型。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas disponible pour le compte ChatGPT sélectionné. Aucun modèle de remplacement n’a été utilisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è disponibile per l’account ChatGPT selezionato. Non è stato usato alcun modello sostitutivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist für das ausgewählte ChatGPT-Konto nicht verfügbar. Es wurde kein Ersatzmodell verwendet."
          }
        }
      }
    },
    "error.openai.request.usageLimit": {
      "comment": "OpenAI analysis error when ChatGPT plan usage is unavailable or exhausted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT plan usage is unavailable or its limit was reached. Manage usage in ChatGPT settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT 요금제 사용량을 이용할 수 없거나 한도에 도달했습니다. ChatGPT 설정에서 사용량을 관리해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El uso del plan de ChatGPT no está disponible o se ha alcanzado su límite. Gestiona el uso en los ajustes de ChatGPT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPTプランの利用枠を使用できないか、上限に達しています。ChatGPTの設定で使用量を管理してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT 套餐用量不可用，或已达到额度上限。请在 ChatGPT 设置中管理用量。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilisation du forfait ChatGPT est indisponible ou son quota est atteint. Gérez l’utilisation dans les paramètres de ChatGPT."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’uso del piano ChatGPT non è disponibile oppure è stato raggiunto il limite. Gestisci l’utilizzo nelle impostazioni di ChatGPT."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nutzung des ChatGPT-Abos ist nicht verfügbar oder das Kontingent ist ausgeschöpft. Verwalte die Nutzung in den ChatGPT-Einstellungen."
          }
        }
      }
    },
    "error.routine.acceptanceNotFound": {
      "comment": "Routine store error when a pending acceptance reservation is missing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pending routine acceptance was not found."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 루틴 수락 기록을 찾을 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró la aceptación de rutina pendiente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受け入れ処理待ちのルーティンの記録が見つかりませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
