    "error.mail.outlookIMAP.legacyAuthUnsupported" : {
      "comment" : "Generated service prose; interpolated values preserve source content.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Standard-/App-Passwort-Authentifizierung ist für dieses Outlook-Konto deaktiviert oder wird nicht unterstützt (LOGINDISABLED/OAuth erforderlich). Die ältere Anmeldung wird nur nach Möglichkeit unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basic/app-password authentication is disabled or unsupported for this Outlook account (LOGINDISABLED/OAuth required). Legacy login is best-effort only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La autenticación básica o mediante contraseña de aplicación está desactivada o no es compatible con esta cuenta de Outlook (LOGINDISABLED / se requiere OAuth). El inicio de sesión heredado se ofrece sin garantía de funcionamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’authentification de base ou par mot de passe d’application est désactivée ou non prise en charge pour ce compte Outlook (LOGINDISABLED/OAuth requis). La connexion avec l’ancienne méthode n’est pas garantie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autenticazione di base o con password per app è disabilitata o non supportata per questo account Outlook (LOGINDISABLED/OAuth richiesto). L’accesso legacy viene tentato senza garanzia di riuscita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このOutlookアカウントでは、基本認証・アプリ パスワード認証が無効になっているか、サポートされていません（LOGINDISABLED／OAuthが必要）。従来方式のログインは、動作を保証するものではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Outlook 계정은 기본/앱 비밀번호 인증이 비활성화되었거나 지원되지 않습니다 (LOGINDISABLED/OAuth 필요). 레거시 로그인 기능은 기본 제공용입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Outlook 账户已禁用或不支持基本身份验证 / 应用专用密码验证（LOGINDISABLED / 需要 OAuth）。旧版登录仅尽力尝试，不保证成功。"
          }
        }
      }
    },
