    "legal.privacy.ai.default" : {
      "comment" : "Native settings and analysis copy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ist der Standard. Nur auf nicht unterstützten Geräten kann in den Beta-Funktionen ein lokales Sprachmodell manuell heruntergeladen und dessen Nutzung erlaubt werden. Ist kein geeignetes Modell verfügbar, erfolgt die Verarbeitung regelbasiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence is the default. Only on unsupported devices, you can download and opt in to a local language model in Beta features. If no eligible model is available, processing uses rules."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence es la opción predeterminada. Solo en dispositivos no compatibles puedes descargar un modelo de lenguaje local y autorizar su uso en Funciones Beta. Si no hay ningún modelo apto disponible, el procesamiento se basa en reglas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence est utilisé par défaut. Uniquement sur les appareils non compatibles, vous pouvez télécharger un modèle de langage local et autoriser son utilisation dans les fonctionnalités Bêta. Si aucun modèle admissible n’est disponible, le traitement repose sur des règles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence è l’opzione predefinita. Solo sui dispositivi non supportati puoi scaricare un modello linguistico locale e autorizzarne l’uso nelle funzionalità Beta. Se non è disponibile un modello idoneo, l’elaborazione si basa su regole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準ではApple Intelligenceを使用します。非対応のデバイスでのみ、ベータ機能からローカル言語モデルを手動でダウンロードし、利用に同意できます。利用可能なモデルがない場合は、ルールに基づいて処理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본값은 Apple Intelligence입니다. 지원하지 않는 기기에서는 베타 기능에서 로컬 언어 모델을 직접 다운로드하고 사용을 허용할 수 있습니다. 사용 가능한 모델이 없으면 규칙 기반으로 처리합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认使用 Apple Intelligence。仅在不受支持的设备上，您可在 Beta 功能中手动下载本地语言模型并选择允许使用。没有可用模型时，按规则处理。"
          }
        }
      }
    },
    "legal.privacy.apple.storage" : {
      "comment" : "Full opt-in iCloud storage and device-local authorization boundaries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionale vollständige iCloud-Speicherung: Aufgaben, E-Mails, Besprechungsaufnahmen und Transkripte, Routinen, Wortschatz, Einstellungen und Kontoverbindungen. Gesundheitsinformationen, Betriebssystemberechtigungen und herunterladbare Modelldateien sind ausgeschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional full iCloud storage: tasks, email, meeting recordings and transcripts, routines, vocabulary, settings and account connections. Health information, OS permissions and downloadable model files are excluded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almacenamiento completo opcional en iCloud: tareas, correos, grabaciones y transcripciones de reuniones, rutinas, vocabulario, ajustes y conexiones de cuentas. Se excluyen la información de salud, los permisos del sistema y los archivos de modelos descargables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockage complet facultatif dans iCloud : tâches, e-mails, enregistrements et transcriptions de réunions, routines, vocabulaire, réglages et connexions aux comptes. Les informations de santé, autorisations du système et fichiers de modèles téléchargeables sont exclus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiviazione completa facoltativa in iCloud: attività, email, registrazioni e trascrizioni delle riunioni, routine, vocabolario, impostazioni e connessioni agli account. Sono esclusi le informazioni sanitarie, i permessi del sistema e i file dei modelli scaricabili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意のiCloud全体保存：タスク、メール、会議の録音・文字起こし、ルーティン、語彙、設定、アカウント接続情報。健康情報、OSの権限、ダウンロード可能なモデルファイルは対象外です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택적 전체 iCloud 저장: 할 일·메일·회의 녹음/전사·루틴·학습 사전·설정·연결 정보. 건강정보·OS 권한·재다운로드 가능한 모델 파일은 제외합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选的完整 iCloud 存储：任务、邮件、会议录音与转写、例程、词汇、设置和账户连接信息。不包含健康信息、操作系统权限和可下载的模型文件。"
          }
        }
      }
    },
    "legal.privacy.audioImport.processing" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Import wird weder Mikrofonzugriff angefordert noch automatisch ein Modell heruntergeladen. Wenn dein Dateianbieter die Quelldatei herunterlädt, gelten dessen Richtlinien. Importierte Audiodaten bleiben für einen erneuten Versuch erhalten, wenn das Offline-Modell fehlt oder die Transkription fehlschlägt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import does not request microphone access or automatically download a model. If your file provider downloads the source file, that provider's policy applies. Imported audio is retained for retry when the offline model is missing or transcription fails."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La importación no solicita acceso al micrófono ni descarga un modelo automáticamente. Si tu proveedor de archivos descarga el archivo original, se aplica la política de ese proveedor. El audio importado se conserva para reintentar si falta el modelo sin conexión o falla la transcripción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’importation ne demande pas l’accès au microphone et ne télécharge aucun modèle automatiquement. Si votre fournisseur de fichiers télécharge le fichier source, sa politique s’applique. L’audio importé est conservé pour réessayer si le modèle hors ligne est absent ou si la transcription échoue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’importazione non richiede l’accesso al microfono né scarica automaticamente un modello. Se il fornitore di file scarica il file originale, si applica la sua informativa. L’audio importato viene conservato per riprovare se manca il modello offline o la trascrizione non riesce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込み時にマイクへのアクセスを要求したり、モデルを自動でダウンロードしたりすることはありません。ファイルプロバイダが元のファイルをダウンロードする場合は、そのプロバイダのポリシーが適用されます。オフラインモデルが未インストールの場合や文字起こしが失敗した場合も、再試行できるよう読み込んだ音声は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져오기는 마이크 권한이나 자동 모델 다운로드를 시작하지 않습니다. 파일 제공자가 원본을 내려받는 경우 해당 제공자의 정책이 적용됩니다. 오프라인 모델 미설치나 전사 실패 후에도 가져온 음성을 보존해 재시도할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入不会请求麦克风权限，也不会自动下载模型。如果文件提供方下载了原始文件，则适用该提供方的政策。未安装离线模型或转写失败时，导入的音频仍会保留，以便重试。"
          }
        }
      }
    },
    "legal.privacy.audioImport.storage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgewählte Audiodateien werden schreibgeschützt geöffnet, konvertiert und als Besprechungsaufnahme auf dem Gerät gespeichert. Das Original bleibt unverändert; nur sein Basisdateiname wird erfasst. Mit ausdrücklicher Zustimmung zur vollständigen iCloud-Speicherung werden die Audiokopie und das Transkript unter demselben Apple Account gespeichert und wiederhergestellt. Sie werden nicht an externe KI gesendet. Beim Löschen der Besprechung wird die Kopie in der App gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio you select is opened read-only, converted and saved as an on-device meeting recording. The original is unchanged and only its base filename is recorded. With explicit consent to full iCloud storage, the audio copy and transcript are stored and restored under the same Apple account. They are not sent to external AI. Deleting the meeting deletes the app’s copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio seleccionado se abre en modo de solo lectura, se convierte y se guarda en el dispositivo como grabación de una reunión. El original no se modifica y solo se registra su nombre de archivo, sin la ruta. Con tu consentimiento explícito para el almacenamiento completo en iCloud, la copia de audio y la transcripción se guardan y restauran con la misma cuenta de Apple. No se envían a IA externas. Al eliminar la reunión, se elimina la copia de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio sélectionné est ouvert en lecture seule, converti et enregistré sur l’appareil comme enregistrement de réunion. L’original reste inchangé ; seul son nom de fichier de base est conservé. Avec votre consentement explicite au stockage complet dans iCloud, la copie audio et la transcription sont stockées et restaurées sous le même compte Apple. Elles ne sont pas envoyées à une IA externe. Supprimer la réunion supprime la copie de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio selezionato viene aperto in sola lettura, convertito e salvato sul dispositivo come registrazione della riunione. L’originale resta invariato e ne viene registrato solo il nome del file, senza il percorso. Con il consenso esplicito all’archiviazione completa in iCloud, la copia audio e la trascrizione vengono archiviate e ripristinate con lo stesso account Apple. Non vengono inviate a IA esterne. Eliminando la riunione si elimina la copia nell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した音声は読み取り専用で開かれ、変換後、デバイス内の会議録音として保存されます。元のファイルは変更されず、基本ファイル名のみが記録されます。iCloudへの全体保存に明示的に同意すると、音声コピーと文字起こしを同じApple Accountに保存・復元します。外部AIには送信されません。会議を削除すると、アプリ内のコピーも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자가 선택한 오디오를 읽기 전용으로 열어 기기 내 회의 음성으로 변환·저장합니다. 원본은 바꾸지 않고 기본 파일명만 기록합니다. 전체 iCloud 저장에 명시적으로 동의하면 음성 복사본과 전사문을 같은 Apple 계정에서 저장·복원합니다. 외부 AI로 보내지는 않습니다. 회의 삭제 시 앱 안의 복사본을 삭제합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选音频以只读方式打开，转换后作为会议录音保存在设备上。原始文件不会更改，仅记录其基本文件名。明确同意完整 iCloud 存储后，音频副本和转写将存储在同一 Apple 账户下并可恢复。它们不会发送给外部 AI。删除会议时，应用中的副本也会删除。"
          }
        }
      }
    },
    "legal.privacy.audioImport.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
