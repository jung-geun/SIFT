    "feedback.review.detail" : {
      "comment" : "Private SIFT feedback flow. Preserve explicit consent and privacy disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nichts gesendet, bevor du zustimmst und auf „Senden“ tippst. Prüfe unten den genauen Nachrichtentext, die App-Metadaten und alle angehängten Berichte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is sent until you consent and tap Send. Review the exact message, app metadata, and any attached report below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se envía nada hasta que des tu consentimiento y pulses Enviar. Revisa a continuación el mensaje exacto, los metadatos de la app y cualquier informe adjunto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est envoyé tant que vous n’avez pas donné votre consentement et touché Envoyer. Vérifiez ci-dessous le message exact, les métadonnées de l’app et tout rapport joint."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non viene inviato nulla finché non dai il consenso e tocchi Invia. Rivedi di seguito il messaggio esatto, i metadati dell’app e gli eventuali rapporti allegati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同意して「送信」をタップするまで、何も送信されません。以下で、実際に送信されるメッセージ、アプリのメタデータ、添付レポートを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동의하고 보내기를 누르기 전에는 아무것도 전송되지 않습니다. 아래에서 실제로 전송될 내용, 앱 정보 및 첨부 보고서를 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在您同意并轻点“发送”后，才会发送任何内容。请在下方核对将发送的消息原文、应用元数据和所有附加报告。"
          }
        }
      }
    },
