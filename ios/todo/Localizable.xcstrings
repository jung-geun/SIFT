    "feedback.privacy" : {
      "comment" : "Private SIFT feedback flow. Preserve explicit consent and privacy disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib keine Passwörter, Tokens, Kontodaten, Aufgaben oder sonstigen privaten Inhalte ein. Ein Konto oder eine E-Mail-Adresse ist nicht erforderlich. Über dieses Postfach werden keine individuellen Antworten gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not enter passwords, tokens, account details, tasks, or other private content. No account or email is required. This inbox does not provide individual replies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No incluyas contraseñas, tokens, datos de cuentas, tareas ni otro contenido privado. No se requiere una cuenta ni un correo electrónico. Este buzón no ofrece respuestas individuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne saisissez pas de mots de passe, de jetons, de données de compte, de tâches ni d’autres contenus privés. Aucun compte ni adresse e-mail n’est requis. Cette boîte de réception ne fournit pas de réponse individuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non inserire password, token, dati dell’account, attività o altri contenuti privati. Non sono richiesti un account né un indirizzo email. Questa casella non fornisce risposte individuali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワード、トークン、アカウント情報、タスク、その他の非公開の内容を入力しないでください。アカウントやメールアドレスは不要です。この受信箱では個別の返信は行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀번호, 토큰, 계정 정보, 할 일 또는 기타 비공개 내용을 입력하지 마세요. 계정이나 이메일은 필요하지 않습니다. 이 수신함에서는 개별 답변을 제공하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请勿输入密码、令牌、账户信息、任务或其他私人内容。无需账户或电子邮箱。此收件箱不提供单独回复。"
          }
        }
      }
    },
