    "meeting.diarization.model.downloadFailed": {
      "comment": "Speaker model download or integrity failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speaker model could not be downloaded or verified. Try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화자 모델을 내려받거나 검증하지 못했습니다. 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar o verificar el modelo de interlocutores. Vuelve a intentarlo."
          }
        },
        "ja": {
