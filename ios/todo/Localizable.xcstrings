    "routines.uncertainty.irregular": {
      "comment": "Caveat for evidence below the existing minimum prediction confidence threshold.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주기가 불규칙합니다. 이 후보를 사용하기 전에 확인하고 수정하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irregular intervals: confirm and edit before using this candidate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalos irregulares: confirma y edita esta posible rutina antes de usarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間隔が不規則です。この候補を使う前に、確認して編集してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "间隔不规律：使用此候选项前，请先确认并编辑。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalles irréguliers : vérifiez et modifiez cette routine potentielle avant de l’utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalli irregolari: verifica e modifica questa possibile routine prima di usarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unregelmäßige Abstände: Prüfe und bearbeite diesen Kandidaten vor der Verwendung."
          }
        }
      }
    },
    "routines.uncertainty.review": {
      "comment": "Review requirement for evidence at or above the minimum confidence threshold.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하기 전에 활동·주기·선호 시각을 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the activity, recurrence and preferred time before using it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma la actividad, la frecuencia y la hora preferida antes de usarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使う前に、活動、繰り返し、希望時刻を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用前，请确认活动、重复周期和偏好时间。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez l’activité, la récurrence et l’heure souhaitée avant de l’utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma l’attività, la frequenza e l’orario preferito prima di usarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige vor der Verwendung die Aktivität, Wiederholung und bevorzugte Uhrzeit."
          }
        }
      }
    },
    "routines.uncertainty.summary": {
      "comment": "Arguments: localized sample count, distinct-day count, confidence, confidence-dependent review caveat. Rendered from structured fields, never persisted uncertainty prose.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@의 근거입니다. %3$@. 완료 시각은 실제 활동 시각이나 소요 시간을 증명하지 않습니다. %4$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on %1$@ across %2$@ (%3$@). Checkoff times do not prove actual activity time or duration. %4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se basa en %1$@ en %2$@ (%3$@). Las horas en que se marca como completado no demuestran la hora ni la duración reales de la actividad. %4$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@にわたる%1$@に基づいています（%3$@）。完了チェックの時刻は、実際の活動時刻や所要時間を証明するものではありません。%4$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依据为 %2$@内的%1$@（%3$@）。勾选完成的时间不能证明实际活动的发生时间或持续时长。%4$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la base de %1$@ sur %2$@ (%3$@). Les heures de validation ne prouvent ni l’heure ni la durée de l’activité réelle. %4$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In base a %1$@ in %2$@ (%3$@). Gli orari di completamento registrati non dimostrano l’orario o la durata effettiva dell’attività. %4$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf %1$@ an %2$@ (%3$@). Abhakzeiten belegen weder den tatsächlichen Zeitpunkt noch die Dauer einer Aktivität. %4$@"
          }
        }
      }
    },
