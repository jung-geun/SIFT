    "ai.apple.default" : {
      "comment" : "Native settings and analysis copy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Standard-KI verarbeitet Daten auf dem Gerät. Ist sie nicht verfügbar, gelten Regeln. Geräte ohne Unterstützung können in den Beta-Einstellungen ein heruntergeladenes Modell als Ersatz nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The default AI processes on device. When unavailable, rules apply. Devices without support can opt into downloaded-model fallback in Beta settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA predeterminada procesa en el dispositivo. Si no está disponible, se aplican reglas. En dispositivos no compatibles, puedes elegir un modelo descargado como alternativa en los ajustes Beta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IA par défaut effectue le traitement sur l’appareil. Si elle est indisponible, des règles s’appliquent. Sur les appareils non compatibles, vous pouvez choisir un modèle téléchargé en secours dans les réglages Bêta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IA predefinita elabora i dati sul dispositivo. Quando non è disponibile, si applicano regole. Sui dispositivi non supportati puoi scegliere un modello scaricato come alternativa nelle impostazioni Beta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準のAIとしてデバイス内で処理します。利用できない場合はルールで処理します。非対応デバイスでは、ベータ設定でダウンロードしたモデルによる代替を選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 AI이며 기기에서 처리합니다. 사용할 수 없으면 규칙으로 처리합니다. 미지원 기기의 다운로드 모델 대체 기능은 베타 설정에서 선택할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认 AI 在设备上处理。不可用时按规则处理。不受支持的设备可在 Beta 设置中选择使用已下载的模型作为备用。"
          }
        }
      }
    },
