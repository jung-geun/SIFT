            "value" : "El aprendizaje está desactivado, por lo que no hay sugerencias. Aún puedes eliminar los registros guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’apprentissage est désactivé, donc les suggestions le sont aussi. Vous pouvez toujours supprimer les données enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
