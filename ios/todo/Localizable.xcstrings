    "tutorial.todoSettings.notifications.fromTodoList.body" : {
      "comment" : "Tutorial navigation through Settings > To-Dos; notification permission is optional.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne oben rechts „Mehr“ > „Einstellungen“ > „Aufgaben“, um die Benachrichtigungsberechtigung zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open More in the upper right > Settings > To-Dos to check notification permission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Más en la esquina superior derecha > Ajustes > Tareas para comprobar el permiso de notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Plus en haut à droite > Réglages > Tâches pour vérifier l’autorisation des notifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Altro in alto a destra > Impostazioni > Attività per controllare l’autorizzazione alle notifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右上の「その他」>「設定」>「タスク」で通知の許可状況を確認してみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "우측 상단 더 보기 > 설정 > 할 일에서 알림 권한을 확인해보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
