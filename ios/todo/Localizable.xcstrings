      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorgeschlagen werden nur neue Termine bestätigter, verlässlicher Routinen. Bestehende Aufgaben und abgelehnte Termine werden nicht erneut vorgeschlagen."
          }
