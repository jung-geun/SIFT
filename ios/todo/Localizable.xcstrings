    "settings.sync.disabledMessage": {
      "comment": "iCloud sync alert message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is disabled. Quit and relaunch the app to use local-only storage."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화가 비활성화되었습니다. 앱을 종료 후 다시 실행하면 로컬 전용으로 전환됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud está desactivada. Cierra la aplicación y vuelve a abrirla para usar solo el almacenamiento local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud同期が無効化されました。アプリを終了して再起動すると、ローカル専用ストレージが使用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停用 iCloud 同步。退出并重新启动应用后，将仅使用本地存储。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud est désactivée. Quittez et relancez l’app pour utiliser uniquement le stockage local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione iCloud è disattivata. Chiudi e riavvia l'app per usare solo l'archiviazione locale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iCloud-Synchronisierung ist deaktiviert. Beende die App und starte sie erneut, um ausschließlich lokalen Speicher zu verwenden."
          }
        }
      }
    },
    "settings.sync.enabledMessage": {
      "comment": "iCloud sync alert message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is enabled. Quit and relaunch the app to begin syncing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화가 활성화되었습니다. 앱을 종료 후 다시 실행하면 동기화가 시작됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud está activada. Cierra la aplicación y vuelve a abrirla para empezar a sincronizar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud同期が有効化されました。アプリを終了して再起動すると、同期が開始されます。"
