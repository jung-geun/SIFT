          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche a été enregistrée. Une opération ultérieure n’a pas pu être confirmée : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attività è stata salvata. Impossibile confermare un’operazione successiva: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe wurde gespeichert. Ein nachfolgender Vorgang konnte nicht bestätigt werden: %@"
          }
        }
      }
    },
    "schedule.recommendation.empty": {
      "comment": "Schedule approval UI: schedule.recommendation.empty.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가용 시간·마감·충돌 조건을 만족하는 구간이 없습니다. 앞으로 14일 이내에서만 찾습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No interval meets availability, deadline, and conflict constraints. Search is limited to the next 14 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún intervalo cumple las condiciones de disponibilidad, fecha límite y ausencia de conflictos. La búsqueda se limita a los próximos 14 días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き時間、締め切り、重複回避の条件を満たす時間枠がありません。検索対象は今後14日間に限られます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有满足可用时间、截止时间和冲突限制的时段。仅搜索未来 14 天内的时间。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun créneau ne respecte les disponibilités, l’échéance et les contraintes de conflit. La recherche se limite aux 14 prochains jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun intervallo soddisfa i vincoli di disponibilità, scadenza e conflitti. La ricerca è limitata ai prossimi 14 giorni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zeitraum erfüllt die Vorgaben zu Verfügbarkeit, Frist und Konflikten. Die Suche ist auf die nächsten 14 Tage begrenzt."
          }
        }
      }
    },
