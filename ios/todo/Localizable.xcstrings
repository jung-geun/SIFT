    "iCloud 글로벌 설정 vs 기기별 로컬 설정 분리 및 중앙 관리": {
      "comment": "Development status UI copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Central management for iCloud-global versus device-local settings"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 글로벌 설정 vs 기기별 로컬 설정 분리 및 중앙 관리"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestión centralizada y separación de los ajustes globales de iCloud y los ajustes locales de cada dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud共通設定とデバイスごとのローカル設定を分離して一元管理"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区分并集中管理 iCloud 全局设置与各设备本地设置"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestion centralisée des réglages globaux iCloud et des réglages locaux propres à chaque appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestione centralizzata e separazione tra impostazioni globali iCloud e impostazioni locali del dispositivo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zentrale Verwaltung und Trennung iCloud-weiter und gerätelokaler Einstellungen"
          }
