          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données sont stockées uniquement sur cet appareil"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati sono archiviati solo su questo dispositivo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データはこのデバイスにのみ保存されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터가 이 기기에만 저장됩니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据仅保存在此设备上"
          }
        }
      }
    },
    "데이터를 클라우드에 업로드하지 않고 현재 기기에만 보관합니다. 추후 설정에서 언제든지 iCloud 동기화를 켤 수 있습니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere Daten ausschließlich auf diesem Gerät, ohne sie in die Cloud hochzuladen. Die iCloud-Synchronisierung kannst du später jederzeit in den Einstellungen aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep data only on this device without uploading it to the cloud. You can enable iCloud Sync later in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda los datos solo en este dispositivo sin subirlos a la nube. Puedes activar la sincronización con iCloud más adelante en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez les données uniquement sur cet appareil sans les envoyer dans le cloud. Vous pourrez activer la synchronisation iCloud ultérieurement dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva i dati solo su questo dispositivo, senza caricarli sul cloud. Potrai attivare la sincronizzazione iCloud in seguito nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データをクラウドにアップロードせず、このデバイスにのみ保存します。後から設定でいつでもiCloud同期を有効にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터를 클라우드에 업로드하지 않고 현재 기기에만 보관합니다. 추후 설정에서 언제든지 iCloud 동기화를 켤 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅将数据保存在此设备上，不上传到云端。你可以稍后随时在设置中启用 iCloud 同步。"
          }
        }
      }
    },
    "데이터베이스 용량 초과 방지를 위한 자동 오래된 데이터 청소" : {
