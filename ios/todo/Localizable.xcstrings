    "meeting.people.disclosure" : {
      "comment" : "Source-local meeting person/task attribution; preserve transcript evidence and review uncertainty.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen und Spitznamen werden nur innerhalb dieser Audioquelle anhand des Transkripts zugeordnet. Abgeleitete Namen müssen geprüft werden; eine bloße Erwähnung identifiziert keine sprechende Person. Namen und Zuordnungen lassen sich im Transkript korrigieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Names are linked only within this audio source using transcript evidence. Inferred names need review; a mention alone does not identify a speaker. Rename or reassign speakers from the transcript to correct them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres y alias se vinculan solo dentro de esta fuente de audio mediante pruebas de la transcripción. Revisa los nombres inferidos: una mención no identifica al interlocutor. Puedes corregir los nombres o asignaciones desde la transcripción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms et surnoms sont associés uniquement au sein de cette source audio, selon la transcription. Vérifiez les noms déduits : une simple mention ne suffit pas à identifier une personne. Corrigez les noms ou attributions depuis la transcription."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomi e soprannomi sono associati solo all’interno di questa sorgente audio, in base alla trascrizione. Verifica i nomi dedotti: una semplice menzione non identifica chi parla. Puoi correggere nomi e assegnazioni dalla trascrizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前や別名は、この音声ソースの文字起こしの根拠からのみ関連付けます。推定名は確認が必要で、名前が言及されただけでは話者を確定しません。文字起こしから話者の割り当てや名前を修正できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름·별칭은 이 오디오 소스의 전사 근거로만 연결합니다. 추정 이름은 확인이 필요하며 단순 언급만으로 화자를 확정하지 않습니다. 전사문에서 화자를 지정하거나 이름을 수정할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "姓名和别名仅根据此音频来源的转写证据关联。推断的姓名需要核对；仅提及姓名不能确定说话人。可在转写中修改姓名或重新分配说话人。"
          }
        }
      }
    },
    "meeting.people.empty" : {
