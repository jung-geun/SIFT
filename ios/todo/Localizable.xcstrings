    "health.reader.error.range" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für den Gesundheitsverlauf ist ein endlicher Datumsbereich erforderlich, dessen Beginn nicht nach dem Ende liegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health history requires a finite date range with the start no later than the end."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial de salud requiere un intervalo de fechas finito cuya fecha de inicio no sea posterior a la de fin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique de santé nécessite une plage de dates finie dont le début ne soit pas postérieur à la fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia sanitaria richiede un intervallo di date finito con la data di inizio non successiva a quella di fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康履歴の取得には、開始日時と終了日時がともに有限の有効な日時で、開始日時が終了日時以前となる期間を指定する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강 기록 조회에는 시작일이 종료일보다 늦지 않은 유효한 날짜 범위가 필요합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查询健康历史记录需要指定起止日期均有效且有限的日期范围，开始日期不得晚于结束日期。"
          }
        }
      }
    },
    "health.reader.error.response" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HealthKit hat eine unerwartete Abfrageantwort zurückgegeben; es wurden keine Verlaufsdaten übernommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HealthKit returned an unexpected query response; no history was published."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HealthKit ha devuelto una respuesta de consulta inesperada; no se ha incorporado ningún historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HealthKit a renvoyé une réponse inattendue à la requête ; aucun historique n’a été intégré."
          }
        },
        "it" : {
          "stringUnit" : {
