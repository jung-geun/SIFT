        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用 iCloud 同步。退出并重新启动应用后，将开始同步。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud est activée. Quittez et relancez l’app pour commencer la synchronisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione iCloud è attivata. Chiudi e riavvia l'app per iniziare la sincronizzazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
