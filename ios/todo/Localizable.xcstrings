    "error.mail.service.qaOAuthNotConfigured": {
      "comment": "Generated service prose; interpolated values preserve source content.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SIFT QA의 Gmail 로그인에는 별도로 등록된 Google iOS OAuth 클라이언트가 필요합니다."
          }
        },
