          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーの「メール」をタップして、連携されたメールを確認する画面を開いてみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点标签栏中的“邮件”，查看已连接邮箱中的邮件。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Courrier dans la barre d’onglets pour consulter les e-mails des comptes connectés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
