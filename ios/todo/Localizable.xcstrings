    "tutorial.body.TODO 자동 정렬 및 AI를 눌러 자동 정렬에 사용할 AI를 선택할 수 있는 화면으로 들어가보세요." : {
      "comment" : "Tutorial hint body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap To-Do Prioritization AI to choose the AI used for automatic prioritization."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TODO 자동 정렬 및 AI를 눌러 자동 정렬에 사용할 AI를 선택할 수 있는 화면으로 들어가보세요."
          }
        }
      }
    },
    "tutorial.body.설정 목록에서 나의 페르소나를 눌러 프로필을 확인해보세요." : {
      "comment" : "Tutorial hint body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap My Persona in Settings to review your profile."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 목록에서 나의 페르소나를 눌러 프로필을 확인해보세요."
          }
        }
      }
    },
    "tutorial.body.시스템 권한 및 상태를 눌러 알림과 캘린더 권한 상태를 확인해보세요." : {
      "comment" : "Tutorial hint body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap System Permissions & Status to review notification and calendar permissions."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 권한 및 상태를 눌러 알림과 캘린더 권한 상태를 확인해보세요."
          }
        }
      }
    },
    "tutorial.body.여기서 생활 유형과 설명을 확인하거나 다시 설정할 수 있습니다. 확인했으면 뒤로 돌아가 계속하세요." : {
      "comment" : "Tutorial hint body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review or reset your lifestyle type and description here. Go back when you are ready to continue."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 생활 유형과 설명을 확인하거나 다시 설정할 수 있습니다. 확인했으면 뒤로 돌아가 계속하세요."
          }
        }
      }
    },
    "tutorial.body.여기서 연결된 메일을 확인하고 할 일로 등록할 수 있습니다. 확인했으면 할 일 탭으로 돌아가 계속하세요." : {
      "comment" : "Tutorial hint body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review connected mail and register to-dos here. Go back to To-Dos when ready to continue."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 연결된 메일을 확인하고 할 일로 등록할 수 있습니다. 확인했으면 할 일 탭으로 돌아가 계속하세요."
          }
        }
      }
    },
    "tutorial.body.여기서 제목을 입력해 추가할 수 있습니다. 둘러본 뒤 취소하거나 추가하면 다음 안내로 넘어갑니다." : {
      "comment" : "Tutorial hint body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a title here to add a to-do. Cancel or add it after looking around to continue."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 제목을 입력해 추가할 수 있습니다. 둘러본 뒤 취소하거나 추가하면 다음 안내로 넘어갑니다."
          }
        }
      }
    },
    "tutorial.body.여기서 캘린더 일정과 앱 할 일을 함께 볼 수 있습니다. 확인했으면 할 일 탭으로 돌아가 계속하세요." : {
      "comment" : "Tutorial hint body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review calendar events and app to-dos together here. Go back to To-Dos when ready to continue."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 캘린더 일정과 앱 할 일을 함께 볼 수 있습니다. 확인했으면 할 일 탭으로 돌아가 계속하세요."
          }
        }
      }
    },
    "tutorial.body.왼쪽 위 AI 정리 버튼을 눌러 실제 자동 정렬을 실행해보세요. 할 일이 없으면 먼저 하나 추가한 뒤 눌러보세요." : {
      "comment" : "Tutorial hint body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Prioritize with AI in the upper left to run prioritization. Add a to-do first if the list is empty."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽 위 AI 정리 버튼을 눌러 실제 자동 정렬을 실행해보세요. 할 일이 없으면 먼저 하나 추가한 뒤 눌러보세요."
          }
        }
      }
    },
    "tutorial.body.우측 상단 + 버튼을 눌러 실제로 새 할 일을 열어보세요. 제목은 필수이고, 마감일과 알림은 선택입니다." : {
      "comment" : "Tutorial hint body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the + button in the upper right to open a real to-do. A title is required; due dates and reminders are optional."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "우측 상단 + 버튼을 눌러 실제로 새 할 일을 열어보세요. 제목은 필수이고, 마감일과 알림은 선택입니다."
          }
        }
      }
    },
    "tutorial.body.우측 상단 설정 버튼을 눌러 TODO 자동 정렬 및 AI 항목으로 이동해보세요." : {
      "comment" : "Tutorial hint body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Settings in the upper right and open To-Do Prioritization AI."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "우측 상단 설정 버튼을 눌러 TODO 자동 정렬 및 AI 항목으로 이동해보세요."
          }
        }
      }
    },
    "tutorial.body.우측 상단 설정 버튼을 눌러 나의 페르소나를 확인해보세요." : {
      "comment" : "Tutorial hint body.",
      "extractionState" : "manual",
      "localizations" : {
