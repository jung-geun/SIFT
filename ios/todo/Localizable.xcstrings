    "health.disconnect.explanation" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Trennen stoppt diese Kategorie und löscht ihren lokalen Verlauf, Quellengenehmigungen und Vorschläge. Bestehende Aufgaben und Markierungen zur Vermeidung von Duplikaten bleiben erhalten. Der Health-Zugriff in den iOS-Einstellungen wird dadurch nicht widerrufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnecting stops this category and erases its local history, source approvals, and suggestions. Existing tasks and duplicate-prevention markers remain. It does not revoke Health access in iOS Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desconectar, se detiene esta categoría y se borran su historial local, las aprobaciones de orígenes y las sugerencias. Se conservan las tareas existentes y los marcadores para evitar duplicados. No se revoca el acceso a Salud en los ajustes de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La déconnexion arrête cette catégorie et efface son historique local, les approbations de sources et les suggestions. Les tâches existantes et les marqueurs de prévention des doublons sont conservés. Elle ne révoque pas l’accès à Santé dans les réglages iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disconnessione interrompe questa categoria e ne cancella la cronologia locale, le approvazioni delle origini e i suggerimenti. Le attività esistenti e i marcatori per prevenire i duplicati restano. Non revoca l’accesso a Salute nelle impostazioni di iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続を解除すると、このカテゴリの利用を停止し、ローカルの履歴、データ提供元の承認、提案を削除します。既存のタスクと重複防止マーカーは残ります。iOSの設定にあるヘルスケアへのアクセス権は取り消されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결을 해제하면 이 항목을 중지하고 로컬 기록·출처 승인·제안을 지웁니다. 기존 할 일과 중복 방지 표식은 남습니다. iOS 설정의 건강 접근 권한은 철회되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "断开连接会停止使用此类别，并清除其本地历史记录、来源批准和建议。已有待办事项和防重复标记会保留。这不会撤销 iOS 设置中的健康访问权限。"
          }
        }
      }
    },
    "health.entry.explanation" : {
      "comment" : "Explicit-consent health history, calendar export and settings controls. Preserve privacy and safety disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde echte HealthKit-Verläufe separat. Die unten manuell abgehakten Aufgaben sind keine Gesundheitsaufzeichnungen."
          }
        },
        "en" : {
          "stringUnit" : {
