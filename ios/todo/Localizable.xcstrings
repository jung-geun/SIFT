    "schedule.error.calendarSave": {
      "comment": "Schedule approval error: calendarSave.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일은 저장되었지만 캘린더 일정은 확인하지 못했습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task was saved, but its calendar event could not be confirmed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea se ha guardado, pero no se pudo confirmar su evento del calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを保存しましたが、カレンダーの予定は確認できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待办事项已保存，但无法确认其日历日程是否已保存。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche a été enregistrée, mais son événement de calendrier n’a pas pu être confirmé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attività è stata salvata, ma non è stato possibile confermare l’evento nel calendario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe wurde gespeichert, ihr Kalenderereignis konnte jedoch nicht bestätigt werden."
          }
        }
      }
    },
    "schedule.error.calendarUnchecked": {
      "comment": "Schedule approval error: calendarUnchecked.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근을 허용하거나 캘린더 충돌 검사 없이 진행하도록 직접 선택하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Calendar access or explicitly choose to proceed without checking its conflicts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a Calendario o elige explícitamente continuar sin comprobar sus conflictos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスを許可するか、カレンダーの重複を確認せずに続けることを明示的に選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许访问日历，或明确选择不检查日历冲突而继续操作。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à Calendrier ou choisissez explicitement de continuer sans vérifier ses conflits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso a Calendario oppure scegli esplicitamente di procedere senza verificarne i conflitti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Kalenderzugriff oder wähle ausdrücklich, ohne Prüfung auf Kalenderkonflikte fortzufahren."
          }
        }
      }
    },
    "schedule.error.cancelled": {
      "comment": "Schedule approval UI: schedule.error.cancelled.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 취소되었습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se canceló la solicitud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストがキャンセルされました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求已取消。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande a été annulée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta è stata annullata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage wurde abgebrochen."
          }
        }
      }
    },
    "schedule.error.changed": {
      "comment": "Schedule approval error: changed.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일이나 가용 구간이 변경되었습니다. 승인 전에 새로 추천한 일정을 검토하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task or available interval changed. Review the refreshed recommendation before approving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea o el intervalo disponible han cambiado. Revisa la recomendación actualizada antes de aprobarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクまたは空き時間枠が変更されました。承認する前に、更新された提案を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待办事项或可用时段已更改。批准前，请审核更新后的建议。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche ou le créneau disponible a changé. Vérifiez la nouvelle recommandation avant d’approuver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attività o l’intervallo disponibile è cambiato. Rivedi il nuovo suggerimento prima di approvare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe oder der verfügbare Zeitraum hat sich geändert. Prüfe vor der Genehmigung die aktualisierte Empfehlung."
          }
        }
      }
    },
    "schedule.error.failed": {
      "comment": "Safe message for unknown scheduling or persistence errors.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정 처리를 완료하지 못했습니다. 다시 시도하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The schedule operation could not be completed. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la operación del horario. Vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定の処理を完了できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成日程操作。请重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération de planification n’a pas pu être terminée. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare l’operazione di pianificazione. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeitplanaktion konnte nicht abgeschlossen werden. Bitte versuche es erneut."
          }
        }
      }
    },
    "schedule.error.missingTask": {
      "comment": "Schedule approval error: missingTask.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 더 이상 찾을 수 없습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task is no longer available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
