    "feedback.failure.cancelled" : {
      "comment" : "Private SIFT feedback flow. Preserve explicit consent and privacy disclosures.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Senden wurde abgebrochen. Der Server hat die Übermittlung möglicherweise bereits gespeichert. Dein Entwurf und Bericht bleiben erhalten; beim erneuten Versuch wird dieselbe Übermittlung verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sending was cancelled. The server may already have saved the submission. Your draft and report are kept; retry uses the same submission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se canceló el envío. Es posible que el servidor ya lo haya guardado. Tu borrador y el informe se conservan; al reintentar se usa el mismo envío."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’envoi a été annulé. Le serveur a peut-être déjà enregistré le contenu. Votre brouillon et votre rapport sont conservés ; une nouvelle tentative utilise le même envoi."
          }
        },
        "it" : {
          "stringUnit" : {
