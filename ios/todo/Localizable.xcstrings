    "meeting.diarization.model.loadFailed": {
      "comment": "Speaker model load validation failed, so staged installation was canceled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speaker model pack could not be loaded on this device, so installation was canceled."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 화자 모델을 불러오지 못해 설치를 취소했습니다."
          }
        },
        "es": {
          "stringUnit": {
