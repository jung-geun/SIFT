    "error.calendar.unauthorized": {
      "comment": "Generated service prose; interpolated values preserve source content.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근 권한이 없습니다. 설정 > 개인정보 보호에서 허용해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is not authorized. Allow access in Settings > Privacy & Security."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha autorizado el acceso al calendario. Permite el acceso en Ajustes > Privacidad y seguridad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスが許可されていません。「設定」>「プライバシーとセキュリティ」でアクセスを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授权访问日历。请在“设置”>“隐私与安全性”中允许访问。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier n’est pas autorisé. Autorisez-le dans Réglages > Confidentialité et sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso a Calendario non è autorizzato. Consentilo in Impostazioni > Privacy e sicurezza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalenderzugriff ist nicht erlaubt. Erlaube ihn unter Einstellungen > Datenschutz & Sicherheit."
          }
        }
      }
    },
    "error.firebase.invalidPassphrase": {
      "comment": "Firebase encryption passphrase is too short.",
      "extractionState": "manual",
