    "routines.remote.explanation": {
      "comment": "Routine review UI: routines.remote.explanation.",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 해석은 저장된 주기·시간·신뢰도·확인 상태를 변경하거나 할 일을 만들지 않습니다. 고급 모델은 자동으로 재호출하지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote prose does not change stored recurrence, time, confidence, or confirmation and does not create tasks. The advanced model is never invoked automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La explicación remota no cambia la frecuencia, la hora, la confianza ni la confirmación guardadas, y no crea tareas. El modelo avanzado nunca se invoca automáticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部で生成した解説によって、保存済みの繰り返し、時刻、信頼度、確認状態が変わったり、タスクが作成されたりすることはありません。高性能モデルが自動で呼び出されることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程生成的解读不会更改已保存的重复周期、时间、置信度或确认状态，也不会创建待办事项。高级模型绝不会被自动调用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interprétation distante ne modifie ni la récurrence, ni l’heure, ni le niveau de confiance, ni la confirmation enregistrés et ne crée pas de tâches. Le modèle avancé n’est jamais appelé automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo generato da remoto non modifica frequenza, orario, affidabilità o conferma salvati e non crea attività. Il modello avanzato non viene mai richiamato automaticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Extern erzeugte Erläuterungen ändern weder die gespeicherte Wiederholung, Uhrzeit, Konfidenz noch die Bestätigung und erstellen keine Aufgaben. Das erweiterte Modell wird nie automatisch aufgerufen."
          }
        }
      }
    },
