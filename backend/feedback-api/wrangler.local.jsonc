{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sift-feedback-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-14",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "ENVIRONMENT": "development", "INTAKE_ENABLED": "true" },
  "d1_databases": [
    { "binding": "DB", "database_name": "sift-feedback", "migrations_dir": "migrations" }
  ]
}
