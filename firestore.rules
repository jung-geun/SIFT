rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Clients synchronize encrypted snapshots, not backend meeting/job state.
    match /users/{userId}/appData/{snapshotId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && snapshotId in ['snapshot', 'snapshot-qa'];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
